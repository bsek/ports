## **********************************************************************
## Review the following lines once breakage in contrib has been resolved.
# Files are not touched anymore by default, add this to your mmakefile if that is necessry
#<target>-touchfileflag := $(GENDIR)/$(CURDIR)/.files-touched
ports-emulation-vice--touchfileflag ?= $(ports-emulation-vice--pkgdir)/.files-touched
## **********************************************************************

ifneq ("$(wildcard $(ports-emulation-vice-portdir)/$(ports-emulation-vice--builddir)/Makefile)","")
# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(ports-emulation-vice--pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(ports-emulation-vice--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(ports-emulation-vice--pkgdir)))'"
	$(Q)$(CP) -Rf "$(ports-emulation-vice-portdir)/$(ports-emulation-vice--builddir)/." $(ports-emulation-vice--pkgdir)/ && $(TOUCH) $@

$(ports-emulation-vice--touchfileflag) : $(ports-emulation-vice--pkgdir)/.local-copy

    ports-emulation-vice--cfg-srcdir=$(ports-emulation-vice--pkgdir)
else
    ports-emulation-vice--cfg-srcdir=$(ports-emulation-vice-portdir)/$(ports-emulation-vice--builddir)
endif
ports-emulation-vice--make-env += -C $(ports-emulation-vice--pkgdir)

.PHONY : ports-emulation-vice- ports-emulation-vice--clean ports-emulation-vice--build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-emulation-vice--host : setup includes ports-emulation-vice--quick
#MM- ports-emulation-vice--target : setup includes core-linklibs ports-emulation-vice--quick
#MM- ports-emulation-vice-: ports-emulation-vice--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (,)
    ports-emulation-vice--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-emulation-vice--pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-emulation-vice--PROGDIR)/" $(ports-emulation-vice--install_opts) \
        $(ports-emulation-vice--make-env)  -j1

    ports-emulation-vice--uninstall_command = \
    $(RM) $(ports-emulation-vice--installflag) && \
    $(MAKE) PROGDIR="$(ports-emulation-vice--PROGDIR)/" \
    $(ports-emulation-vice--install_opts) $(ports-emulation-vice--make-env) uninstall
else
    ports-emulation-vice--install_command   := true
    ports-emulation-vice--uninstall_command := true
endif

#MM- ports-emulation-vice--quick :  ports-emulation-vice--configure  ports-emulation-vice--build_and_install-quick ports-emulation-vice-install ports-emulation-vice--make-package

#MM
ports-emulation-vice--build_and_install-quick :  $(ports-emulation-vice--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(ports-emulation-vice--installflag) : $(ports-emulation-vice--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-emulation-vice--volfunc, PROGDIR)" -q $(ports-emulation-vice--make-env); then \
	    $(RM) $(ports-emulation-vice--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-emulation-vice--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-emulation-vice--volfunc, PROGDIR)" $(ports-emulation-vice--make-env) && \
	    $(ports-emulation-vice--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(ports-emulation-vice--touchfileflag):
	$(Q)$(FOR) dir in $(ports-emulation-vice--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(ports-emulation-vice-portdir)/$(ports-emulation-vice--builddir) -exec $(TOUCH) -c -r $(ports-emulation-vice--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-emulation-vice--uninstall :
	$(ports-emulation-vice--uninstall_command)

#MM
ports-emulation-vice--configure : $(ports-emulation-vice--configflag)

$(ports-emulation-vice--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-emulation-vice--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-emulation-vice--configflag) : $(ports-emulation-vice--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-emulation-vice--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-emulation-vice--pkgdir))"
	$(ports-emulation-vice--init-env)
	$(Q)cd $(ports-emulation-vice--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-emulation-vice--cfg-env) $(TMP_SRCDIR)/configure $(ports-emulation-vice--config_opts)  && \
	$(TOUCH) $@

#MM
ports-emulation-vice--clean : ports-emulation-vice--uninstall
	$(Q)$(RM) $(ports-emulation-vice--pkgdir)

.PHONY : ports-emulation-vice--make-package ports-emulation-vice--create-patch
#MM ports-emulation-vice--make-package : ports-emulation-vice--quick

#MM
ports-emulation-vice--make-package : $(ports-emulation-vice--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(ports-emulation-vice--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(ports-emulation-vice-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(ports-emulation-vice--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(ports-emulation-vice-prefix)" ; \
	    cd $(ports-emulation-vice--package-dir) ; \
	    tar -cvf $(ports-emulation-vice--package-basename).tar * ; \
	    bzip2 -9 -f $(ports-emulation-vice--package-basename).tar ; \
	fi

