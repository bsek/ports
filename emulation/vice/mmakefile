        CPP="$(strip $(ports-emulation-vice--CROSS_CPP) $(ports-emulation-vice--CROSS_SYSROOT))" \
        CXXCPP="$(strip $(ports-emulation-vice--CROSS_CPP) $(ports-emulation-vice--CROSS_SYSROOT))" \
        CC="$(strip $(ports-emulation-vice--CROSS_CC) $(ports-emulation-vice--CROSS_SYSROOT))" \
        CXX="$(strip $(ports-emulation-vice--CROSS_CXX) $(ports-emulation-vice--CROSS_SYSROOT))" \
        LD="$(strip $(ports-emulation-vice--CROSS_LD))" \
