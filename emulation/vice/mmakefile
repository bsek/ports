        AS_FOR_TARGET="$(strip $(TARGET_AS))" \
        OBJCOPY_FOR_TARGET="$(strip $(TARGET_OBJCOPY))" \
        RANLIB_FOR_TARGET="$(strip $(TARGET_RANLIB))" \
