        RANLIB="$(strip $(ports-emulation-vice--CROSS_RANLIB))" \
        STRIP="$(strip $(ports-emulation-vice--CROSS_STRIP))" \
        CFLAGS="$(strip $(ports-emulation-vice--CROSS_CFLAGS))" \
