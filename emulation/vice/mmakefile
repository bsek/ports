endif
    ports-emulation-vice--cfg-env += CC_FOR_HOST="$(strip $(ports-emulation-vice--TARGET_CC) $(TARGET_SYSROOT))" \
        CFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CFLAGS) $(ports-emulation-vice--ACHOST_CFLAGS) $(USER_CFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(ports-emulation-vice--nix))" \
        CXX_FOR_HOST="$(strip $(ports-emulation-vice--TARGET_CXX) $(TARGET_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CXXFLAGS) $(ports-emulation-vice--ACHOST_CXXFLAGS)  $(USER_CXXFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(ports-emulation-vice--nix))" \
        LD_FOR_HOST="$(strip $(TARGET_LD))" \
        LDFLAGS_FOR_HOST="$(strip $(TARGET_ISA_LDFLAGS) -L$(AROS_DEVELOPER)/lib  $(ports-emulation-vice--ACHOST_LDFLAGS) $(USER_LDFLAGS) $(ports-emulation-vice--nix) $(ports-emulation-vice--s_flag))"
ifeq (yes,yes)
    ports-emulation-vice--cfg-env += CPPFLAGS_FOR_TARGET="$(strip $(BASE_CPPFLAGS) $(ports-emulation-vice--ACTARGET_CPPFLAGS) $(USER_CPPFLAGS) )"
