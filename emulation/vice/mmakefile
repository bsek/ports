        TARGET_NM="$(strip $(NM_PLAIN))"
endif

ifeq (yes,yes)
    ports-emulation-vice--config_opts += --target=$(AROS_TARGET_CPU)-aros
    ports-emulation-vice--config_opts += --build=$(AROS_HOST_CPU)-$(AROS_HOST_ARCH)
    ports-emulation-vice--config_opts += --host=$(AROS_TARGET_CPU)-aros
