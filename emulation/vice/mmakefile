.PHONY: ports-emulation-vice--fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-emulation-vice--fetch-location := $(PORTSSOURCEDIR)
else
    ports-emulation-vice--fetch-location := $(ports-emulation-vice-portdir)
endif

ifneq (,)
    ports-emulation-vice--fetch-baseflag := -b 
else
    ports-emulation-vice--fetch-baseflag :=
endif

ports-emulation-vice--fetch-fetchedflag := $(ports-emulation-vice--fetch-location)/.$(ports-emulation-vice--archbase)-fetched

#MM
ports-emulation-vice--fetch :
	$(Q)$(ECHO) "Fetching   $(ports-emulation-vice--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(ports-emulation-vice--archbase) -s "tar.gz" -l $(ports-emulation-vice--fetch-location) \
	-d $(ports-emulation-vice-portdir) $(ports-emulation-vice--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ports-emulation-vice--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(ports-emulation-vice--fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-emulation-vice--fetch-fetchedflag) ; \
	fi


.PHONY: ports-emulation-vice--create-patch

ifneq (,)
    ports-emulation-vice--create-patch-location := 
else
    ports-emulation-vice--create-patch-location := $(PORTSSOURCEDIR)
endif

ifneq (,)
    ports-emulation-vice--create-patch-exclude := -X ./exclude.patterns
endif

ifneq ($(ports-emulation-vice--srcdir),)
    ports-emulation-vice--create-patch-srcdir   := $(ports-emulation-vice--srcdir)
else
    ports-emulation-vice--create-patch-srcdir   := $(ports-emulation-vice--archbase)
endif

ifeq (no,yes)
    ports-emulation-vice--create-patch-diffflag   := --strip-trailing-cr
else
    ports-emulation-vice--create-patch-diffflag   :=
endif

ifneq (,)
    ports-emulation-vice--create-patch-baseflag := -b /tmp
    ports-emulation-vice--create-patch-base := 
else
    ports-emulation-vice--create-patch-baseflag :=
    ports-emulation-vice--create-patch-base := $(ports-emulation-vice-portdir)
