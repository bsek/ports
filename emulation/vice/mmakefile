    ports-emulation-vice--cfg-env += TARGET_CPPFLAGS="$(KERNEL_CPPFLAGS)"
endif
    ports-emulation-vice--cfg-env += TARGET_CC="$(strip $(ports-emulation-vice--KERNEL_CC) $(KERNEL_SYSROOT))" \
        TARGET_CFLAGS="$(strip $(ports-emulation-vice--KERNEL_CFLAGS))" \
        TARGET_CXX="$(strip $(ports-emulation-vice--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        TARGET_CXXFLAGS="$(strip $(ports-emulation-vice--KERNEL_CXXFLAGS))" \
        TARGET_AS="$(TARGET_AS)" \
        OBJCOPY="$(OBJCOPY)" \
        TARGET_RANLIB="$(RANLIB)" \
        TARGET_STRIP="$(STRIP_PLAIN)" \
        TARGET_NM="$(NM_PLAIN)" \
        TARGET_OBJCOPY="$(TARGET_OBJCOPY)"
