#MM- ports-emulation-vice--create-patch :  ports-emulation-vice--create-patch-diff 
#MM- ports-emulation-vice--create-patch-quick :  ports-emulation-vice--create-patch-diff 

#MM
ports-emulation-vice--create-patch-diff:
	$(Q)$(FOR) dir in $(ports-emulation-vice--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-emulation-vice--create-patch-base)/$(ports-emulation-vice--create-patch-srcdir) $(ports-emulation-vice--create-patch-base)/tmp/$(ports-emulation-vice--create-patch-srcdir).aros ; \
	$(FETCH) -a $(ports-emulation-vice--archbase) -s "tar.gz" -f -l $(ports-emulation-vice--create-patch-location) -d $(ports-emulation-vice-portdir) $(ports-emulation-vice--create-patch-baseflag); \
	$(MV) $(ports-emulation-vice--create-patch-base)/$(ports-emulation-vice--create-patch-srcdir) $(ports-emulation-vice--create-patch-base)/tmp/$(ports-emulation-vice--create-patch-srcdir) ; \
	cd $(ports-emulation-vice--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ports-emulation-vice--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-emulation-vice--create-patch-diffflag) $(ports-emulation-vice--create-patch-exclude) \
	    $(ports-emulation-vice--create-patch-srcdir) \
	    $(ports-emulation-vice--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ports-emulation-vice--archbase)-aros-new.diff ; \
	$(MV) $(ports-emulation-vice--create-patch-base)/tmp/$(ports-emulation-vice--create-patch-srcdir).aros $(ports-emulation-vice--create-patch-base)/$(ports-emulation-vice--create-patch-srcdir) ; \
	$(RM) $(ports-emulation-vice--create-patch-base)/tmp

