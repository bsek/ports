    ports-emulation-vice--cfg-env += CC_FOR_HOST="$(strip $(ports-emulation-vice--CROSS_CC) $(ports-emulation-vice--CROSS_SYSROOT))" \
        CFLAGS_FOR_HOST="$(strip $(ports-emulation-vice--CROSS_CFLAGS))" \
        CXX_FOR_HOST="$(strip $(ports-emulation-vice--CROSS_CXX) $(ports-emulation-vice--CROSS_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(ports-emulation-vice--CROSS_CXXFLAGS))" \
