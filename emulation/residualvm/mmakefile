.PHONY : aros-residualvm aros-residualvm-clean aros-residualvm-build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- aros-residualvm-host : setup includes aros-residualvm-quick
#MM- aros-residualvm-target : setup includes core-linklibs aros-residualvm-quick
#MM- aros-residualvm: aros-residualvm-target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    aros-residualvm-install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(aros-residualvm-pkgdir))" && \
        $(MAKE) PROGDIR="$(aros-residualvm-PROGDIR)/" $(aros-residualvm-install_opts) \
        $(aros-residualvm-make-env) install -j1

    aros-residualvm-uninstall_command = \
    $(RM) $(aros-residualvm-installflag) && \
    $(MAKE) PROGDIR="$(aros-residualvm-PROGDIR)/" \
    $(aros-residualvm-install_opts) $(aros-residualvm-make-env) uninstall
else
    aros-residualvm-install_command   := true
    aros-residualvm-uninstall_command := true
