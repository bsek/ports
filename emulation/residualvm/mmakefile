PACKAGE      := residualvm
VERSION      := 0.3.1
TARGETDIR    := $(AROS_CONTRIB)/Emu/Residualvm
REPOSITORIES := https://github.com/residualvm/residualvm/archive/refs/tags/$(VERSION)
PATCHSPECS := $(PACKAGE)-$(VERSION)-sources-aros.diff:$(PACKAGE)-$(VERSION):-p1

RESIDUALVM_OPTS=--host=$(AROS_TARGET_CPU)-aros --enable-verbose-build --enable-c++11 --enable-release --enable-freetype2 --datarootdir=$(TARGETDIR)
RESIDUALVM_ENV=DESTDIR=$(TARGETDIR)
NOWARN_FLAGS := -Wno-expansion-to-defined -Wno-variadic-macros \
                $(NOWARN_CLASS_MEMACCESS) $(NOWARN_IMPLICIT_FALLTHROUGH) \
                $(NOWARN_FORMAT_OVERFLOW)
USER_CXXFLAGS := -fvisibility=hidden  -fvisibility-inlines-hidden
USER_CPPFLAGS := -D__BSDSOCKET_NOLIBBASE__
USER_INCLUDES := -I$(AROS_INCLUDES)/SDL -I$(AROS_CONTRIB_INCLUDES) $(NOWARN_FLAGS)
USER_LDFLAGS := -static-libstdc++
OPTIMIZATION_CFLAGS:=


.PHONY: aros-residualvm-fetch

ifneq ($(PORTSSOURCEDIR),)
    aros-residualvm-fetch-location := $(PORTSSOURCEDIR)
else
    aros-residualvm-fetch-location := $(PORTSDIR)/$(PACKAGE)
endif

ifneq (,)
    aros-residualvm-fetch-baseflag := -b 
else
    aros-residualvm-fetch-baseflag :=
endif

aros-residualvm-fetch-fetchedflag := $(aros-residualvm-fetch-location)/.$(PACKAGE)-$(VERSION)-sources-fetched

#MM
aros-residualvm-fetch :
	$(Q)$(ECHO) "Fetching   $(PACKAGE)-$(VERSION)-sources ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(PACKAGE)-$(VERSION)-sources -s "tar.bz2 tar.gz" -l $(aros-residualvm-fetch-location) \
	-d $(PORTSDIR)/$(PACKAGE) $(aros-residualvm-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(PATCHSPECS)"
	$(Q)$(IF) ! $(TEST) -f $(aros-residualvm-fetch-fetchedflag) ; then \
		 $(TOUCH) $(aros-residualvm-fetch-fetchedflag) ; \
	fi


