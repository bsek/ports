#MM- aros-residualvm-create-patch :  aros-residualvm-create-patch-diff 
#MM- aros-residualvm-create-patch-quick :  aros-residualvm-create-patch-diff 

#MM
aros-residualvm-create-patch-diff:
	$(Q)$(FOR) dir in $(aros-residualvm-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(aros-residualvm-create-patch-base)/$(aros-residualvm-create-patch-srcdir) $(aros-residualvm-create-patch-base)/tmp/$(aros-residualvm-create-patch-srcdir).aros ; \
	$(FETCH) -a $(PACKAGE)-$(VERSION)-sources -s "tar.bz2 tar.gz" -f -l $(aros-residualvm-create-patch-location) -d $(PORTSDIR)/$(PACKAGE) $(aros-residualvm-create-patch-baseflag); \
	$(MV) $(aros-residualvm-create-patch-base)/$(aros-residualvm-create-patch-srcdir) $(aros-residualvm-create-patch-base)/tmp/$(aros-residualvm-create-patch-srcdir) ; \
	cd $(aros-residualvm-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(PACKAGE)-$(VERSION)-sources-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(aros-residualvm-create-patch-diffflag) $(aros-residualvm-create-patch-exclude) \
	    $(aros-residualvm-create-patch-srcdir) \
	    $(aros-residualvm-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(PACKAGE)-$(VERSION)-sources-aros-new.diff ; \
	$(MV) $(aros-residualvm-create-patch-base)/tmp/$(aros-residualvm-create-patch-srcdir).aros $(aros-residualvm-create-patch-base)/$(aros-residualvm-create-patch-srcdir) ; \
	$(RM) $(aros-residualvm-create-patch-base)/tmp


