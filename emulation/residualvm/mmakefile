# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(aros-residualvm-pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(aros-residualvm-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(aros-residualvm-pkgdir)))'"
	$(Q)$(CP) -Rf "$(PORTSDIR)/$(PACKAGE)/$(PACKAGE)-$(VERSION)/." $(aros-residualvm-pkgdir)/ && $(TOUCH) $@

$(aros-residualvm-touchfileflag) : $(aros-residualvm-pkgdir)/.local-copy

    aros-residualvm-cfg-srcdir=$(aros-residualvm-pkgdir)
else
    aros-residualvm-cfg-srcdir=$(PORTSDIR)/$(PACKAGE)/$(PACKAGE)-$(VERSION)
endif
