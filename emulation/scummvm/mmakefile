.PHONY: aros-scummvm--fetch

ifneq ($(PORTSSOURCEDIR),)
    aros-scummvm--fetch-location := $(PORTSSOURCEDIR)
else
    aros-scummvm--fetch-location := $(aros-scummvm-portdir)
endif

ifneq (,)
    aros-scummvm--fetch-baseflag := -b 
else
    aros-scummvm--fetch-baseflag :=
endif

aros-scummvm--fetch-fetchedflag := $(aros-scummvm--fetch-location)/.$(aros-scummvm--archbase)-fetched

#MM
aros-scummvm--fetch :
	$(Q)$(ECHO) "Fetching   $(aros-scummvm--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(aros-scummvm--archbase) -s "tar.xz tar.bz2 tar.gz" -l $(aros-scummvm--fetch-location) \
	-d $(aros-scummvm-portdir) $(aros-scummvm--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(aros-scummvm--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(aros-scummvm--fetch-fetchedflag) ; then \
		 $(TOUCH) $(aros-scummvm--fetch-fetchedflag) ; \
	fi


.PHONY: aros-scummvm--create-patch

ifneq (,)
