    aros-scummvm--package := $(aros-scummvm--package-basename).tar.bz2
endif


ifneq ($(aros-scummvm-prefix),)
    aros-scummvm--prefix := $(aros-scummvm-prefix)
else
    aros-scummvm--prefix := $(AROS_CONTRIB)
endif

ifneq (,)
    aros-scummvm--aros_prefix := 
else
    aros-scummvm--aros_prefix := $(aros-scummvm--prefix)
endif

BD_NIXFLAG ?= -nix

ifeq (no,yes)
    aros-scummvm--nix    := $(BD_NIXFLAG)
    aros-scummvm--volpfx := /
    aros-scummvm--volsfx := /
    
    ifeq (no,)
        aros-scummvm--nix_dir_layout := yes
    endif
else
    aros-scummvm--volsfx := :
    
    ifeq (no,)
        aros-scummvm--nix_dir_layout := no
    endif
endif

aros-scummvm--volfunc = $(aros-scummvm--volpfx)$(notdir $1)$(aros-scummvm--volsfx)

aros-scummvm--install_opts += prefix=$(aros-scummvm--prefix) \
        exec_prefix=$(aros-scummvm--prefix) 

# Check if chosen compiler is valid
ifeq ($(findstring target,host target kernel),)
  $(error unknown compiler target)
endif

# Set legacy 'host' variable based on chosen compiler
ifeq (target,host)
    host := yes
    ifeq ($(CURDIR),)
        aros-scummvm--pkgbasedir := $(HOSTGENDIR)
    else
        aros-scummvm--pkgbasedir := $(HOSTGENDIR)/$(CURDIR)
    endif
else
    host := no
    ifeq ($(CURDIR),)
        aros-scummvm--pkgbasedir := $(GENDIR)
    else
        aros-scummvm--pkgbasedir := $(GENDIR)/$(CURDIR)
    endif
endif
ifneq (,)
    ifeq ($(CURDIR),)
        aros-scummvm--pkgbasedir := 
    else
        aros-scummvm--pkgbasedir := /$(CURDIR)
    endif
endif

ifeq ($(PACKAGE),)
    aros-scummvm--pkgdir := $(aros-scummvm--pkgbasedir)
else
    aros-scummvm--pkgdir := $(aros-scummvm--pkgbasedir)/$(PACKAGE)
endif

aros-scummvm--configflag ?= $(aros-scummvm--pkgdir)/.configured
aros-scummvm--installflag ?= $(aros-scummvm--pkgdir)/.installed

ifeq ($(filter yes, $(aros-scummvm--nix_dir_layout) $(host)),yes)
    aros-scummvm--PROGDIR      := $(aros-scummvm--aros_prefix)/bin
    aros-scummvm--config_opts  := --prefix=$(aros-scummvm--aros_prefix)
else
    ifeq (no,yes)
        aros-scummvm--config_opts := --prefix=/PROGDIR  --bindir=/PROGDIR --sbindir=/PROGDIR \
        --libdir=/LIB --includedir=/INCLUDE --oldincludedir=/INCLUDE   
    else
        aros-scummvm--config_opts  := --prefix=$(aros-scummvm--aros_prefix)
    endif

    aros-scummvm--PROGDIR := $(aros-scummvm--aros_prefix)
    
    aros-scummvm--install_opts := bindir=$(aros-scummvm--prefix) \
        sbindir=$(aros-scummvm--prefix) \
        libdir=$(AROS_LIB) includedir=$(AROS_INCLUDES) \
        oldincludedir=$(AROS_INCLUDES) 
endif

ifneq ($(DEBUG),yes)
    aros-scummvm--s_flag = -s
endif

ifeq ($(TARGET_ISA_CFLAGS),)
aros-scummvm--TARGET_LDFLAGS :=
else
aros-scummvm--TARGET_LDFLAGS := $(TARGET_ISA_LDFLAGS) $(TARGET_LDFLAGS)
endif

ifeq (yes,yes)
    aros-scummvm--HOST_CFLAGS=$(HOST_ISA_CFLAGS) $(HOST_CFLAGS)
    aros-scummvm--KERNEL_CFLAGS=$(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS)
ifeq (no,yes)
    aros-scummvm--TARGET_CFLAGS=$(TARGET_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CFLAGS) $(USER_CFLAGS)
else
    aros-scummvm--TARGET_CFLAGS=$(TARGET_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CFLAGS) $(USER_CFLAGS) $(aros-scummvm--nix)
endif
endif
aros-scummvm--TARGET_CC?=$(TARGET_CC)
aros-scummvm--KERNEL_CC?=$(KERNEL_CC)
aros-scummvm--HOST_CC?=$(HOST_DEF_CC)
ifeq (yes,yes)
    aros-scummvm--HOST_CXXFLAGS=$(HOST_ISA_CFLAGS) $(HOST_CXXFLAGS)
    aros-scummvm--KERNEL_CXXFLAGS=$(KERNEL_ISA_CFLAGS) $(KERNEL_CXXFLAGS)
ifeq (no,yes)
    aros-scummvm--TARGET_CXXFLAGS=$(TARGET_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CXXFLAGS) $(USER_CXXFLAGS)
else
    aros-scummvm--TARGET_CXXFLAGS=$(TARGET_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CXXFLAGS) $(USER_CXXFLAGS) $(aros-scummvm--nix)
endif
endif
aros-scummvm--TARGET_CXX?=$(TARGET_CXX)
aros-scummvm--KERNEL_CXX?=$(KERNEL_CXX)
aros-scummvm--HOST_CXX?=$(HOST_CXX)

# Set up build environment, and options for configure script
ifeq (target,host)
    # NB: We need to pass in our crosstoolsdir, but cannot set CFLAGS since it
    # confused configure scripts. We also cannot pass it via _FOR_BUILD
    # since that won't get picked up during configure.
    # We also cannot pass in the compiler including std flags so we need to use
    # the "plain" host compiler.
    aros-scummvm--cfg-env :=  \
        CPP="$(HOST_CPP)" \
        CXXCPP="$(HOST_CPP)" \
        CC="$(strip $(aros-scummvm--HOST_CC) $(aros-scummvm--HOST_CFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        CXX="$(strip $(aros-scummvm--HOST_CXX) $(aros-scummvm--HOST_CXXFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        LDFLAGS="-L$(CROSSTOOLSDIR)/lib $(USER_LDFLAGS)"
ifeq (yes,yes)
    aros-scummvm--cfg-env += TARGET_CPPFLAGS="$(KERNEL_CPPFLAGS)"
endif
    aros-scummvm--cfg-env += TARGET_CC="$(strip $(aros-scummvm--KERNEL_CC) $(KERNEL_SYSROOT))" \
        TARGET_CFLAGS="$(strip $(aros-scummvm--KERNEL_CFLAGS))" \
        TARGET_CXX="$(strip $(aros-scummvm--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        TARGET_CXXFLAGS="$(strip $(aros-scummvm--KERNEL_CXXFLAGS))" \
        TARGET_AS="$(TARGET_AS)" \
        OBJCOPY="$(OBJCOPY)" \
        TARGET_RANLIB="$(RANLIB)" \
        TARGET_STRIP="$(STRIP_PLAIN)" \
        TARGET_NM="$(NM_PLAIN)" \
        TARGET_OBJCOPY="$(TARGET_OBJCOPY)"
endif

ifeq (target,target)
    aros-scummvm--cfg-env :=  \
        PKG_CONFIG_LIBDIR="$(AROS_DEVELOPER)/lib/pkgconfig" \
        PKG_CONFIG_SYSROOT_DIR="$(AROSDIR)"
ifeq (no,yes)
    aros-scummvm--cfg-env += \
        CPP="$(strip $(aros-scummvm--CROSS_CPP) $(aros-scummvm--CROSS_SYSROOT))" \
        CXXCPP="$(strip $(aros-scummvm--CROSS_CPP) $(aros-scummvm--CROSS_SYSROOT))" \
        CC="$(strip $(aros-scummvm--CROSS_CC) $(aros-scummvm--CROSS_SYSROOT))" \
        CXX="$(strip $(aros-scummvm--CROSS_CXX) $(aros-scummvm--CROSS_SYSROOT))" \
        LD="$(strip $(aros-scummvm--CROSS_LD))" \
        AS="$(strip $(aros-scummvm--CROSS_AS))" \
        AFLAGS="$(strip $(aros-scummvm--CROSS_AFLAGS))" \
        OBJCOPY="$(strip $(aros-scummvm--CROSS_OBJCOPY))" \
        RANLIB="$(strip $(aros-scummvm--CROSS_RANLIB))" \
        STRIP="$(strip $(aros-scummvm--CROSS_STRIP))" \
        CFLAGS="$(strip $(aros-scummvm--CROSS_CFLAGS))" \
        CXXFLAGS="$(strip $(aros-scummvm--CROSS_CXXFLAGS))" \
        LDFLAGS="$(strip $(aros-scummvm--CROSS_LDFLAGS))" \
        LT_LDFLAGS="$(strip $(aros-scummvm--CROSS_LDFLAGS))"
    aros-scummvm--cfg-env += CC_FOR_HOST="$(strip $(aros-scummvm--CROSS_CC) $(aros-scummvm--CROSS_SYSROOT))" \
        CFLAGS_FOR_HOST="$(strip $(aros-scummvm--CROSS_CFLAGS))" \
        CXX_FOR_HOST="$(strip $(aros-scummvm--CROSS_CXX) $(aros-scummvm--CROSS_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(aros-scummvm--CROSS_CXXFLAGS))" \
        LD_FOR_HOST="$(strip $(aros-scummvm--CROSS_LD))" \
        LDFLAGS_FOR_HOST="$(strip $(aros-scummvm--CROSS_LDFLAGS))"
else
    aros-scummvm--cfg-env += CPP="$(strip $(TARGET_CPP) $(TARGET_SYSROOT))" \
        CXXCPP="$(strip $(TARGET_CPP) $(TARGET_SYSROOT))" \
        CC="$(strip $(aros-scummvm--TARGET_CC) $(TARGET_SYSROOT))" \
        CXX="$(strip $(aros-scummvm--TARGET_CXX) $(TARGET_SYSROOT))" \
        LD="$(strip $(TARGET_LD))"
    aros-scummvm--cfg-env += CFLAGS="$(strip $(aros-scummvm--TARGET_CFLAGS) $(aros-scummvm--AC_CFLAGS) $(OPTIMIZATION_CFLAGS))" \
        CXXFLAGS="$(strip $(aros-scummvm--TARGET_CXXFLAGS) $(aros-scummvm--AC_CXXFLAGS) $(OPTIMIZATION_CFLAGS))"
    aros-scummvm--cfg-env += LDFLAGS="$(strip $(aros-scummvm--TARGET_LDFLAGS)) -L$(AROS_DEVELOPER)/lib $(strip $(USER_LDFLAGS) $(TARGET_LDFLAGS) $(TARGET_C_LIBS) $(aros-scummvm--nix) $(aros-scummvm--s_flag))"
    aros-scummvm--cfg-env += LT_LDFLAGS="$(strip $(aros-scummvm--TARGET_LDFLAGS))"
    aros-scummvm--cfg-env += AR="$(strip $(AR_PLAIN))" \
        AS="$(strip $(TARGET_AS))" \
        AFLAGS="$(strip $(AFLAGS))" \
        OBJCOPY="$(strip $(OBJCOPY))" \
        RANLIB="$(strip $(RANLIB))" \
        STRIP="$(strip $(STRIP_PLAIN))"
ifeq (yes,yes)
    aros-scummvm--cfg-env += CPPFLAGS="$(strip $(BASE_CPPFLAGS) $(USER_CPPFLAGS) )"
    aros-scummvm--cfg-env += CPPFLAGS_FOR_BUILD="$(strip $(HOST_CPPFLAGS) $(aros-scummvm--ACBUILD_CPPFLAGS))"
endif
    aros-scummvm--cfg-env += CC_FOR_BUILD="$(strip $(aros-scummvm--HOST_CC))" \
        CFLAGS_FOR_BUILD="$(strip $(aros-scummvm--HOST_CFLAGS) $(aros-scummvm--ACBUILD_CFLAGS))" \
        CXX_FOR_BUILD="$(strip $(aros-scummvm--HOST_CXX))" \
        CXXFLAGS_FOR_BUILD="$(strip $(aros-scummvm--HOST_CXXFLAGS) $(aros-scummvm--ACBUILD_CXXFLAGS))" \
        LD_FOR_BUILD="$(strip $(HOST_LD))" \
        LDFLAGS_FOR_BUILD="$(strip $(HOST_LDFLAGS) $(aros-scummvm--ACBUILD_LDFLAGS) $(aros-scummvm--s_flag))"
ifeq (yes,yes)
    aros-scummvm--cfg-env += CPPFLAGS_FOR_HOST="$(strip $(BASE_CPPFLAGS)  $(aros-scummvm--ACHOST_CPPFLAGS) $(USER_CPPFLAGS) )"
endif
    aros-scummvm--cfg-env += CC_FOR_HOST="$(strip $(aros-scummvm--TARGET_CC) $(TARGET_SYSROOT))" \
        CFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CFLAGS) $(aros-scummvm--ACHOST_CFLAGS) $(USER_CFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(aros-scummvm--nix))" \
        CXX_FOR_HOST="$(strip $(aros-scummvm--TARGET_CXX) $(TARGET_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CXXFLAGS) $(aros-scummvm--ACHOST_CXXFLAGS)  $(USER_CXXFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(aros-scummvm--nix))" \
        LD_FOR_HOST="$(strip $(TARGET_LD))" \
        LDFLAGS_FOR_HOST="$(strip $(TARGET_ISA_LDFLAGS) -L$(AROS_DEVELOPER)/lib  $(aros-scummvm--ACHOST_LDFLAGS) $(USER_LDFLAGS) $(aros-scummvm--nix) $(aros-scummvm--s_flag))"
ifeq (yes,yes)
    aros-scummvm--cfg-env += CPPFLAGS_FOR_TARGET="$(strip $(BASE_CPPFLAGS) $(aros-scummvm--ACTARGET_CPPFLAGS) $(USER_CPPFLAGS) )"
endif
    aros-scummvm--cfg-env += CC_FOR_TARGET="$(strip $(aros-scummvm--TARGET_CC) $(TARGET_SYSROOT))" \
        CFLAGS_FOR_TARGET="$(strip $(aros-scummvm--TARGET_CFLAGS) $(aros-scummvm--ACTARGET_CFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS))" \
        CXX_FOR_TARGET="$(strip $(aros-scummvm--TARGET_CXX) $(TARGET_SYSROOT))" \
        CXXFLAGS_FOR_TARGET="$(strip $(aros-scummvm--TARGET_CXXFLAGS) $(aros-scummvm--ACTARGET_CXXFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS))" \
        LD_FOR_TARGET="$(strip $(TARGET_LD))" \
        LDFLAGS_FOR_TARGET="$(strip $(aros-scummvm--TARGET_LDFLAGS) -L$(AROS_DEVELOPER)/lib $(aros-scummvm--ACTARGET_LDFLAGS) $(USER_LDFLAGS) $(TARGET_C_LIBS) $(aros-scummvm--nix) $(aros-scummvm--s_flag))" \
        AS_FOR_TARGET="$(strip $(TARGET_AS))" \
        OBJCOPY_FOR_TARGET="$(strip $(TARGET_OBJCOPY))" \
        RANLIB_FOR_TARGET="$(strip $(TARGET_RANLIB))" \
        STRIP_FOR_TARGET="$(strip $(TARGET_STRIP))" \
        NM_FOR_TARGET="$(strip $(TARGET_NM))"
ifeq (yes,yes)
    aros-scummvm--cfg-env += TARGET_CPPFLAGS="$(KERNEL_CPPFLAGS)"
endif
    aros-scummvm--cfg-env += TARGET_CC="$(strip $(aros-scummvm--KERNEL_CC) $(KERNEL_SYSROOT))" \
        TARGET_CFLAGS="$(strip $(aros-scummvm--KERNEL_CFLAGS) $(aros-scummvm--ACTARGET_CFLAGS))" \
        TARGET_CXX="$(strip $(aros-scummvm--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        TARGET_CXXFLAGS="$(strip $(aros-scummvm--KERNEL_CXXFLAGS) $(aros-scummvm--ACTARGET_CXXFLAGS))" \
        TARGET_AS="$(strip $(TARGET_AS))" \
        TARGET_OBJCOPY="$(strip $(OBJCOPY))" \
        TARGET_RANLIB="$(strip $(RANLIB))" \
        TARGET_STRIP="$(strip $(STRIP_PLAIN))" \
        TARGET_NM="$(strip $(NM_PLAIN))"
endif

ifeq (no,yes)
    aros-scummvm--config_opts += --target=$(AROS_TARGET_CPU)-aros
    aros-scummvm--config_opts += --build=$(AROS_HOST_CPU)-$(AROS_HOST_ARCH)
    aros-scummvm--config_opts += --host=$(AROS_TARGET_CPU)-aros
endif
ifeq (no,yes)
    aros-scummvm--config_opts += --without-pic --disable-shared
ifeq (yes,yes)
# disable native language support
    aros-scummvm--config_opts += --disable-nls
endif
ifeq (yes,yes)
# disable X window system
    aros-scummvm--config_opts += --without-x
endif
endif
endif

ifeq (target,kernel)
    aros-scummvm--cfg-env :=  \
        CPP="$(KERNEL_CPP)" \
        CXXCPP="$(KERNEL_CPP)"
ifeq (yes,yes)
    aros-scummvm--cfg-env += CPPFLAGS="$(strip $(KERNEL_CPPFLAGS) )"
endif
    aros-scummvm--cfg-env += CC="$(strip $(aros-scummvm--KERNEL_CC) $(KERNEL_SYSROOT))" \
        CFLAGS="$(strip $(aros-scummvm--KERNEL_CFLAGS) $(OPTIMIZATION_CFLAGS))" \
        CXX="$(strip $(aros-scummvm--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        CXXFLAGS="$(strip $(aros-scummvm--KERNEL_CXXFLAGS) $(OPTIMIZATION_CFLAGS))" \
        AS="$(KERNEL_AS)"
ifeq (yes,yes)
    aros-scummvm--cfg-env += CPPFLAGS_FOR_BUILD="$(HOST_CPPFLAGS)"
endif
    aros-scummvm--cfg-env += CC_FOR_BUILD="$(aros-scummvm--HOST_CC)" \
        CFLAGS_FOR_BUILD="$(aros-scummvm--HOST_CFLAGS)" \
        CXX_FOR_BUILD="$(aros-scummvm--HOST_CXX)" \
        CXXFLAGS_FOR_BUILD="$(aros-scummvm--HOST_CXXFLAGS)" \
        RANLIB="$(RANLIB)" \
        TARGET_RANLIB="$(RANLIB)" \
        TARGET_STRIP="$(STRIP_PLAIN)" \
        TARGET_NM="$(NM_PLAIN)"
ifeq (no,yes)
    aros-scummvm--config_opts += --target=$(AROS_TARGET_CPU)-aros
    aros-scummvm--config_opts += --build=$(AROS_HOST_CPU)-$(AROS_HOST_ARCH)
    aros-scummvm--config_opts += --host=$(AROS_TARGET_CPU)-aros
