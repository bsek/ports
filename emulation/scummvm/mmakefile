#MM- aros-scummvm--create-patch :  aros-scummvm--create-patch-diff 
#MM- aros-scummvm--create-patch-quick :  aros-scummvm--create-patch-diff 

#MM
aros-scummvm--create-patch-diff:
	$(Q)$(FOR) dir in $(aros-scummvm--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(aros-scummvm--create-patch-base)/$(aros-scummvm--create-patch-srcdir) $(aros-scummvm--create-patch-base)/tmp/$(aros-scummvm--create-patch-srcdir).aros ; \
	$(FETCH) -a $(aros-scummvm--archbase) -s "tar.xz tar.bz2 tar.gz" -f -l $(aros-scummvm--create-patch-location) -d $(aros-scummvm-portdir) $(aros-scummvm--create-patch-baseflag); \
	$(MV) $(aros-scummvm--create-patch-base)/$(aros-scummvm--create-patch-srcdir) $(aros-scummvm--create-patch-base)/tmp/$(aros-scummvm--create-patch-srcdir) ; \
	cd $(aros-scummvm--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(aros-scummvm--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(aros-scummvm--create-patch-diffflag) $(aros-scummvm--create-patch-exclude) \
	    $(aros-scummvm--create-patch-srcdir) \
	    $(aros-scummvm--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(aros-scummvm--archbase)-aros-new.diff ; \
	$(MV) $(aros-scummvm--create-patch-base)/tmp/$(aros-scummvm--create-patch-srcdir).aros $(aros-scummvm--create-patch-base)/$(aros-scummvm--create-patch-srcdir) ; \
	$(RM) $(aros-scummvm--create-patch-base)/tmp

#MM aros-scummvm : aros-scummvm-
#MM
aros-scummvm:
	$(Q)$(NOP)

aros-scummvm--package-dir := $(aros-scummvm-portdir)/$(aros-scummvm--archbase)

aros-scummvm--package-basename := \
    $(DISTDIR)/Packages/$(aros-scummvm--archbase)-aros.$(AROS_TARGET_CPU)

