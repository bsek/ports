## **********************************************************************

ifneq ("$(wildcard $(aros-scummvm-portdir)/$(aros-scummvm--builddir)/Makefile)","")
# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(aros-scummvm--pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(aros-scummvm--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(aros-scummvm--pkgdir)))'"
	$(Q)$(CP) -Rf "$(aros-scummvm-portdir)/$(aros-scummvm--builddir)/." $(aros-scummvm--pkgdir)/ && $(TOUCH) $@

$(aros-scummvm--touchfileflag) : $(aros-scummvm--pkgdir)/.local-copy

    aros-scummvm--cfg-srcdir=$(aros-scummvm--pkgdir)
else
    aros-scummvm--cfg-srcdir=$(aros-scummvm-portdir)/$(aros-scummvm--builddir)
endif
aros-scummvm--make-env += -C $(aros-scummvm--pkgdir)

.PHONY : aros-scummvm- aros-scummvm--clean aros-scummvm--build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- aros-scummvm--host : setup includes aros-scummvm--quick
#MM- aros-scummvm--target : setup includes core-linklibs aros-scummvm--quick
#MM- aros-scummvm-: aros-scummvm--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    aros-scummvm--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(aros-scummvm--pkgdir))" && \
        $(MAKE) PROGDIR="$(aros-scummvm--PROGDIR)/" $(aros-scummvm--install_opts) \
        $(aros-scummvm--make-env) install -j1

    aros-scummvm--uninstall_command = \
    $(RM) $(aros-scummvm--installflag) && \
    $(MAKE) PROGDIR="$(aros-scummvm--PROGDIR)/" \
    $(aros-scummvm--install_opts) $(aros-scummvm--make-env) uninstall
else
    aros-scummvm--install_command   := true
    aros-scummvm--uninstall_command := true
endif

#MM- aros-scummvm--quick :  aros-scummvm--configure  aros-scummvm--build_and_install-quick aros-scummvm--make-package

#MM
aros-scummvm--build_and_install-quick :  $(aros-scummvm--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(aros-scummvm--installflag) : $(aros-scummvm--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call aros-scummvm--volfunc, PROGDIR)" -q $(aros-scummvm--make-env); then \
	    $(RM) $(aros-scummvm--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(aros-scummvm--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call aros-scummvm--volfunc, PROGDIR)" $(aros-scummvm--make-env) && \
	    $(aros-scummvm--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(aros-scummvm--touchfileflag):
	$(Q)$(FOR) dir in $(aros-scummvm--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(aros-scummvm-portdir)/$(aros-scummvm--builddir) -exec $(TOUCH) -c -r $(aros-scummvm--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
aros-scummvm--uninstall :
	$(aros-scummvm--uninstall_command)

#MM
aros-scummvm--configure : $(aros-scummvm--configflag)

$(aros-scummvm--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(aros-scummvm--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(aros-scummvm--configflag) : $(aros-scummvm--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(aros-scummvm--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(aros-scummvm--pkgdir))"
	$(aros-scummvm--init-env)
	$(Q)cd $(aros-scummvm--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(aros-scummvm--cfg-env) $(TMP_SRCDIR)/configure $(aros-scummvm--config_opts) $(SCUMMVM_OPTS) && \
	$(TOUCH) $@

#MM
aros-scummvm--clean : aros-scummvm--uninstall
	$(Q)$(RM) $(aros-scummvm--pkgdir)

.PHONY : aros-scummvm--make-package aros-scummvm--create-patch
#MM aros-scummvm--make-package : aros-scummvm--quick

#MM
aros-scummvm--make-package : $(aros-scummvm--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(aros-scummvm--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(aros-scummvm-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(aros-scummvm--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(aros-scummvm-prefix)" ; \
	    cd $(aros-scummvm--package-dir) ; \
	    tar -cvf $(aros-scummvm--package-basename).tar * ; \
	    bzip2 -9 -f $(aros-scummvm--package-basename).tar ; \
	fi

SCUMMVM_THEME="Modern_ice.zip"


.PHONY: aros-scummvm-themes-fetch

ifneq ($(PORTSDIR)/$(PACKAGE),)
    aros-scummvm-themes-fetch-location := $(PORTSDIR)/$(PACKAGE)
else
    aros-scummvm-themes-fetch-location := .
endif

ifneq (,)
    aros-scummvm-themes-fetch-baseflag := -b 
else
    aros-scummvm-themes-fetch-baseflag :=
endif

aros-scummvm-themes-fetch-fetchedflag := $(aros-scummvm-themes-fetch-location)/.$(SCUMMVM_THEME)-fetched

#MM
aros-scummvm-themes-fetch :
	$(Q)$(ECHO) "Fetching   $(SCUMMVM_THEME) ..."
	$(Q)$(FETCH) -ao "http://wiki.scummvm.org/images/c/c7" -a $(SCUMMVM_THEME) -s "" -l $(aros-scummvm-themes-fetch-location) \
	-d . $(aros-scummvm-themes-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "::"
	$(Q)$(IF) ! $(TEST) -f $(aros-scummvm-themes-fetch-fetchedflag) ; then \
		 $(TOUCH) $(aros-scummvm-themes-fetch-fetchedflag) ; \
	fi


aros-scummvm-themes-copy_SRC := $(shell $(ECHO) $(PORTSDIR)/$(PACKAGE) | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(TARGETDIR)/data
else
setup :: $(TARGETDIR)/data
