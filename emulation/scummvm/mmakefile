ifneq ($(aros-scummvm--srcdir),)
    aros-scummvm--create-patch-srcdir   := $(aros-scummvm--srcdir)
else
    aros-scummvm--create-patch-srcdir   := $(aros-scummvm--archbase)
endif

ifeq (no,yes)
    aros-scummvm--create-patch-diffflag   := --strip-trailing-cr
else
    aros-scummvm--create-patch-diffflag   :=
endif

ifneq (,)
    aros-scummvm--create-patch-baseflag := -b /tmp
    aros-scummvm--create-patch-base := 
else
