  ports-archive-zunearc_CXXDTARGETS := $(addprefix $(ports-archive-zunearc_OBJDIR)/,$(notdir $(ports-archive-zunearc_CXXBASENAMES:=.d)))
  ports-archive-zunearc_MCXX_WILDCARD := $(ports-archive-zunearc_OBJDIR)/%
else
  ports-archive-zunearc_CXXTARGETS := $(addprefix $(ports-archive-zunearc_OBJDIR)/,$(ports-archive-zunearc_CXXBASENAMES:=.o))
  ports-archive-zunearc_CXXDTARGETS := $(addprefix $(ports-archive-zunearc_OBJDIR)/,$(ports-archive-zunearc_CXXBASENAMES:=.d))
  ports-archive-zunearc_MCXX_WILDCARD := $(ports-archive-zunearc_OBJDIR)/%
