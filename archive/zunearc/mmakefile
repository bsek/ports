ports-archive-zunearc-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ports-archive-zunearc-link_DIRS)))
# Add trailing /
ports-archive-zunearc-link_DIRS := $(subst //,/,$(addsuffix /,$(ports-archive-zunearc-link_DIRS)))
# Add normal linklib path
ports-archive-zunearc-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
ports-archive-zunearc-link_LIBS := $(addprefix lib,$(addsuffix .a,$(ports-archive-zunearc_LIBS) $(ports-archive-zunearc-link_EXTRA_LIBS)))
ifeq (yes,yes)
    ports-archive-zunearc-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-archive-zunearc-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-archive-zunearc-link_DEPLIBS := $(foreach lib,$(ports-archive-zunearc-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-archive-zunearc-link_DIRS)))) \
)

$(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : OBJDIR := $(ports-archive-zunearc_OBJDIR)
$(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : OBJS := $(strip $(ports-archive-zunearc_OBJS) $(ports-archive-zunearc_ARCHOBJS) $(USER_OBJS))
$(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : LDFLAGS := $(strip $(ports-archive-zunearc_LDFLAGS))
$(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : LIBS := $(strip $(addprefix -l,$(ports-archive-zunearc_LIBS) $(ports-archive-zunearc-link_EXTRA_LIBS)))
$(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-archive-zunearc_ARCHLIBS))
$(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : $(ports-archive-zunearc_OBJS) $(ports-archive-zunearc_ARCHOBJS) $(USER_OBJS) $(ports-archive-zunearc-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-archive-zunearc_LINK) $(strip $(ports-archive-zunearc_LD_OPTS) $(ports-archive-zunearc-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-archive-zunearc_LINK) $(strip $(ports-archive-zunearc_LD_OPTS) $(ports-archive-zunearc-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-archive-zunearc_LINK) $(strip $(ports-archive-zunearc_LD_OPTS) $(ports-archive-zunearc-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-archive-zunearc_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-archive-zunearc_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-archive-zunearc_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-archive-zunearc_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-archive-zunearc_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-archive-zunearc_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-archive-zunearc_DEPS),)
  ifneq (ports-archive-zunearc ports-archive-zunearc-quick,)
    ifneq ($(findstring $(TARGET),ports-archive-zunearc ports-archive-zunearc-quick),)
      -include $(ports-archive-zunearc_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-archive-zunearc_DEPS)
    endif
  endif
endif


ifneq ($(ports-archive-zunearc_OBJS) $(ports-archive-zunearc_DEPS) $(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME),)
$(ports-archive-zunearc_OBJS) $(ports-archive-zunearc_DEPS) $(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) : | $(ports-archive-zunearc_OBJDIR) $(ports-archive-zunearc_TARGETDIR)
else
$(ports-archive-zunearc_OBJS) $(ports-archive-zunearc_DEPS) $(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) :: $(ports-archive-zunearc_OBJDIR) $(ports-archive-zunearc_TARGETDIR)
endif

GLOB_MKDIRS += $(ports-archive-zunearc_OBJDIR) $(ports-archive-zunearc_TARGETDIR)


ports-archive-zunearc-clean : FILES := $(ports-archive-zunearc_OBJS) $(ports-archive-zunearc_TARGETDIR)/$(ports-archive-zunearc_PROGNAME) $(ports-archive-zunearc_DEPS)
#MM
ports-archive-zunearc-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget ports-archive-zunearc"
	$(Q)$(RM) $(FILES)




.PHONY: ports-archive-zunearc-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-archive-zunearc-fetch-location := $(PORTSSOURCEDIR)
else
    ports-archive-zunearc-fetch-location := $(PORTSDIR)/zunearc/$(ARCHBASE)
endif

ifneq (,)
    ports-archive-zunearc-fetch-baseflag := -b 
else
    ports-archive-zunearc-fetch-baseflag :=
endif

ports-archive-zunearc-fetch-fetchedflag := $(ports-archive-zunearc-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-archive-zunearc-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "zip" -l $(ports-archive-zunearc-fetch-location) \
	-d $(PORTSDIR)/zunearc/$(ARCHBASE) $(ports-archive-zunearc-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "::"
	$(Q)$(IF) ! $(TEST) -f $(ports-archive-zunearc-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-archive-zunearc-fetch-fetchedflag) ; \
	fi


CPFILES := ZuneARC.info ZuneARC.cfg ZuneARC_oldlha.cfg


ports-archive-zunearc-cpy_SRC := $(shell $(ECHO) $(PORTSDIR)/zunearc/$(ARCHBASE)/ZuneARC | sed 's/^\(.\):\//\/\1\//')


