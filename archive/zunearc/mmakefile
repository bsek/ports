ports-archive-zunearc_CXXABSBASENAMES := $(foreach ports-archive-zunearc_CXXBASE,$(ports-archive-zunearc_CXX_NARCHFILES),$(if $(filter /%,$(ports-archive-zunearc_CXXBASE)),$(ports-archive-zunearc_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(ports-archive-zunearc_CXXBASE))))

ifneq ($(ports-archive-zunearc_CXXABSBASENAMES),)

