endif
ifeq (target,host)
  ports-archive-zunearc_LINK ?= $(strip $(HOST_CXX) $(HOST_ISA_LDFLAGS))
  ports-archive-zunearc_LD_OPTS ?= $(HOST_ISA_LDFLAGS)
  ports-archive-zunearc_LDFLAGS ?= $(strip $(HOST_LDFLAGS))
  ports-archive-zunearc_STRIP ?= $(HOST_STRIP)
  ports-archive-zunearc_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  ports-archive-zunearc_CXXCMD:=$(HOST_CXX)
  ports-archive-zunearc_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(ports-archive-zunearc_MCXX_CPPFLAGS) $(ports-archive-zunearc_MCXX_EXTRA_CPPFLAGS))
  ports-archive-zunearc_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(ports-archive-zunearc_CXXFLAGS))
  ports-archive-zunearc_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(ports-archive-zunearc_DXXFLAGS))
  ports-archive-zunearc_CXXIQUOTE:=$(HOST_IQUOTE)
  ports-archive-zunearc_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  ports-archive-zunearc_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT))
  ports-archive-zunearc_LD_OPTS ?= $(TARGET_ISA_LDFLAGS)
  ports-archive-zunearc_CXXLDFLAGS = $(strip $(USER_LDFLAGS) $(TARGET_LDFLAGS))
ifneq ($(TARGET_CXX_LIBS),)
  ports-archive-zunearc_ARCHLIBS += $(TARGET_CXX_LIBS)
endif
  ports-archive-zunearc_LDFLAGS ?= $(ports-archive-zunearc_CXXLDFLAGS)
  ports-archive-zunearc_STRIP ?= $(TARGET_STRIP)
  ports-archive-zunearc_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  ports-archive-zunearc_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  ports-archive-zunearc_MCXX_CPPFLAGS := $(strip $(ports-archive-zunearc_MCXX_CPPFLAGS) $(ports-archive-zunearc_MCXX_EXTRA_CPPFLAGS))
  ports-archive-zunearc_CXXFLAGS := $(strip $(ports-archive-zunearc_CXXFLAGS) $(SAFETY_CFLAGS))
  ports-archive-zunearc_DXXFLAGS := $(ports-archive-zunearc_DXXFLAGS)
  ports-archive-zunearc_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  ports-archive-zunearc_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  ports-archive-zunearc_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(KERNEL_ISA_LDFLAGS))
  ports-archive-zunearc_LD_OPTS ?= $(KERNEL_ISA_LDFLAGS)
  ports-archive-zunearc_CXXLDFLAGS = $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
ifneq ($(TARGET_CXX_LIBS),)
  ports-archive-zunearc_ARCHLIBS += $(KERNEL_CXX_LIBS)
endif
  ports-archive-zunearc_LDFLAGS ?= $(ports-archive-zunearc_CXXLDFLAGS)
  ports-archive-zunearc_STRIP ?= $(ECHO) >/dev/null
  ports-archive-zunearc_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  ports-archive-zunearc_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  ports-archive-zunearc_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(ports-archive-zunearc_MCXX_CPPFLAGS) $(ports-archive-zunearc_MCXX_EXTRA_CPPFLAGS))
  ports-archive-zunearc_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-archive-zunearc_CXXFLAGS))
  ports-archive-zunearc_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-archive-zunearc_DXXFLAGS))
  ports-archive-zunearc_CXXIQUOTE:=$(KERNEL_IQUOTE)
  ports-archive-zunearc_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-archive-zunearc_CXXCMD) $(ports-archive-zunearc_CXXIQUOTE) $(dir $(2)) $(ports-archive-zunearc_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-archive-zunearc_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-archive-zunearc_CXXIQUOTE) . $(ports-archive-zunearc_CXXIQUOTE_END) $(strip $(ports-archive-zunearc_CXXFLAGS) $(ports-archive-zunearc_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-archive-zunearc_CXXCMD) $(ports-archive-zunearc_CXXIQUOTE) $(dir $(2)) $(ports-archive-zunearc_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-archive-zunearc_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-archive-zunearc_CXXIQUOTE) . $(ports-archive-zunearc_CXXIQUOTE_END) $(strip $(ports-archive-zunearc_CXXFLAGS) $(ports-archive-zunearc_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-archive-zunearc_CXXCMD) $(ports-archive-zunearc_CXXIQUOTE) $(dir $(2)) $(ports-archive-zunearc_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-archive-zunearc_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-archive-zunearc_CXXIQUOTE) . $(ports-archive-zunearc_CXXIQUOTE_END) $(strip $(ports-archive-zunearc_CXXFLAGS) $(ports-archive-zunearc_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-archive-zunearc_CXXCMD)" $(MKDEPEND) $(strip $(ports-archive-zunearc_DXXFLAGS) $(ports-archive-zunearc_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-archive-zunearc_OBJDIR),)
  $(foreach ports-archive-zunearc_CXXFILE,$(ports-archive-zunearc_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-archive-zunearc_CXXFILE))),$(ports-archive-zunearc_CXXFILE))))
else
  $(foreach ports-archive-zunearc_CXXFILE,$(ports-archive-zunearc_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-archive-zunearc_OBJDIR)/,$(notdir $(basename $(ports-archive-zunearc_CXXFILE)))),$(ports-archive-zunearc_CXXFILE))))
endif

endif


ifneq ($(ports-archive-zunearc_OBJC_NARCHFILES),)

ifeq (,)
ports-archive-zunearc_MOBJC_SRCWILDCARD := %
else
ports-archive-zunearc_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(ports-archive-zunearc_OBJDIR),)
  ports-archive-zunearc_MOBJC_TARGETS := $(addsuffix .o,$(ports-archive-zunearc_OBJC_NARCHFILES))
  ports-archive-zunearc_MOBJC_DTARGETS := $(addsuffix .d,$(ports-archive-zunearc_OBJC_NARCHFILES))
  ports-archive-zunearc_MOBJC_WILDCARD := %
else
  ports-archive-zunearc_MOBJC_TARGETS := $(addsuffix .o,$(addprefix $(ports-archive-zunearc_OBJDIR)/,$(ports-archive-zunearc_OBJC_NARCHFILES)))
  ports-archive-zunearc_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(ports-archive-zunearc_OBJDIR)/,$(ports-archive-zunearc_OBJC_NARCHFILES)))
  ports-archive-zunearc_MOBJC_WILDCARD := $(ports-archive-zunearc_OBJDIR)/%

  # Be sure that all .m files are generated
  $(ports-archive-zunearc_MOBJC_TARGETS) $(ports-archive-zunearc_MOBJC_DTARGETS) : | $(addsuffix .m,$(ports-archive-zunearc_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  ports-archive-zunearc_MOBJC_SRCDIR := $(shell $(ECHO) $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  ports-archive-zunearc_MOBJC_BASEDIRS := $(shell $(ECHO) $(sort $(dir $(ports-archive-zunearc_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  ports-archive-zunearc_MOBJC_DIRS := $(foreach dir, $(ports-archive-zunearc_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(ports-archive-zunearc_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(ports-archive-zunearc_MOBJC_DIRS),)
    ports-archive-zunearc_MOBJC_DIRS := $(shell $(ECHO) $(ports-archive-zunearc_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(ports-archive-zunearc_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  ports-archive-zunearc_CC := $(TARGET_CC)
else
  ports-archive-zunearc_CC := $(TARGET_OBJC)
