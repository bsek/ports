.PHONY : ports-archive-zunearc-cpy

#MM
ports-archive-zunearc-cpy : | $(TARGETDIR) 
	$(foreach file, $(CPFILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-archive-zunearc-cpy_SRC)),$(ports-archive-zunearc-cpy_SRC),$(SRCDIR)/$(CURDIR)/$(ports-archive-zunearc-cpy_SRC))/, $(file)) $(addprefix $(TARGETDIR)/, $(file))))




