# Adjust compiler flags to suit C++
ports-archive-zunearc_MCXX_CPPFLAGS := $(ports-archive-zunearc_CPPFLAGS)
ports-archive-zunearc_CXXFLAGS := $(ports-archive-zunearc_CXXFLAGS)
ifeq ($(ports-archive-zunearc_DXXFLAGS),)
