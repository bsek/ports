endif
ifeq (no,yes)
    ports-filetool-zaphod-link_LD_OPTS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
ports-filetool-zaphod-link_DIRS := $(subst -L ,-L,$(strip $(ports-filetool-zaphod_LDFLAGS)))
# Filter out only the libdirs and remove -L
ports-filetool-zaphod-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ports-filetool-zaphod-link_DIRS)))
# Add trailing /
ports-filetool-zaphod-link_DIRS := $(subst //,/,$(addsuffix /,$(ports-filetool-zaphod-link_DIRS)))
# Add normal linklib path
ports-filetool-zaphod-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
ports-filetool-zaphod-link_LIBS := $(addprefix lib,$(addsuffix .a,$(ports-filetool-zaphod_LIBS) $(ports-filetool-zaphod-link_EXTRA_LIBS)))
ifeq (yes,yes)
    ports-filetool-zaphod-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-filetool-zaphod-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-filetool-zaphod-link_DEPLIBS := $(foreach lib,$(ports-filetool-zaphod-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-filetool-zaphod-link_DIRS)))) \
)

$(ports-filetool-zaphod_TARGETDIR)/$(ports-filetool-zaphod_PROGNAME) : OBJDIR := $(ports-filetool-zaphod_OBJDIR)
$(ports-filetool-zaphod_TARGETDIR)/$(ports-filetool-zaphod_PROGNAME) : OBJS := $(strip $(ports-filetool-zaphod_OBJS) $(ports-filetool-zaphod_ARCHOBJS) $(USER_OBJS))
$(ports-filetool-zaphod_TARGETDIR)/$(ports-filetool-zaphod_PROGNAME) : LDFLAGS := $(strip $(ports-filetool-zaphod_LDFLAGS))
$(ports-filetool-zaphod_TARGETDIR)/$(ports-filetool-zaphod_PROGNAME) : LIBS := $(strip $(addprefix -l,$(ports-filetool-zaphod_LIBS) $(ports-filetool-zaphod-link_EXTRA_LIBS)))
$(ports-filetool-zaphod_TARGETDIR)/$(ports-filetool-zaphod_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-filetool-zaphod_ARCHLIBS))
$(ports-filetool-zaphod_TARGETDIR)/$(ports-filetool-zaphod_PROGNAME) : $(ports-filetool-zaphod_OBJS) $(ports-filetool-zaphod_ARCHOBJS) $(USER_OBJS) $(ports-filetool-zaphod-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-filetool-zaphod_LINK) $(strip $(ports-filetool-zaphod_LD_OPTS) $(ports-filetool-zaphod-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-filetool-zaphod_LINK) $(strip $(ports-filetool-zaphod_LD_OPTS) $(ports-filetool-zaphod-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-filetool-zaphod_LINK) $(strip $(ports-filetool-zaphod_LD_OPTS) $(ports-filetool-zaphod-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-filetool-zaphod_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-filetool-zaphod_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-filetool-zaphod_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-filetool-zaphod_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-filetool-zaphod_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-filetool-zaphod_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

