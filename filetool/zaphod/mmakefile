endif
  ports-filetool-zaphod_LDFLAGS ?= $(ports-filetool-zaphod_CXXLDFLAGS)
  ports-filetool-zaphod_STRIP ?= $(ECHO) >/dev/null
  ports-filetool-zaphod_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  ports-filetool-zaphod_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  ports-filetool-zaphod_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(ports-filetool-zaphod_MCXX_CPPFLAGS) $(ports-filetool-zaphod_MCXX_EXTRA_CPPFLAGS))
  ports-filetool-zaphod_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-filetool-zaphod_CXXFLAGS))
  ports-filetool-zaphod_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-filetool-zaphod_DXXFLAGS))
  ports-filetool-zaphod_CXXIQUOTE:=$(KERNEL_IQUOTE)
  ports-filetool-zaphod_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-filetool-zaphod_CXXCMD) $(ports-filetool-zaphod_CXXIQUOTE) $(dir $(2)) $(ports-filetool-zaphod_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-filetool-zaphod_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-filetool-zaphod_CXXIQUOTE) . $(ports-filetool-zaphod_CXXIQUOTE_END) $(strip $(ports-filetool-zaphod_CXXFLAGS) $(ports-filetool-zaphod_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-filetool-zaphod_CXXCMD) $(ports-filetool-zaphod_CXXIQUOTE) $(dir $(2)) $(ports-filetool-zaphod_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-filetool-zaphod_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-filetool-zaphod_CXXIQUOTE) . $(ports-filetool-zaphod_CXXIQUOTE_END) $(strip $(ports-filetool-zaphod_CXXFLAGS) $(ports-filetool-zaphod_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-filetool-zaphod_CXXCMD) $(ports-filetool-zaphod_CXXIQUOTE) $(dir $(2)) $(ports-filetool-zaphod_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-filetool-zaphod_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-filetool-zaphod_CXXIQUOTE) . $(ports-filetool-zaphod_CXXIQUOTE_END) $(strip $(ports-filetool-zaphod_CXXFLAGS) $(ports-filetool-zaphod_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-filetool-zaphod_CXXCMD)" $(MKDEPEND) $(strip $(ports-filetool-zaphod_DXXFLAGS) $(ports-filetool-zaphod_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-filetool-zaphod_OBJDIR),)
  $(foreach ports-filetool-zaphod_CXXFILE,$(ports-filetool-zaphod_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-filetool-zaphod_CXXFILE))),$(ports-filetool-zaphod_CXXFILE))))
else
  $(foreach ports-filetool-zaphod_CXXFILE,$(ports-filetool-zaphod_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-filetool-zaphod_OBJDIR)/,$(notdir $(basename $(ports-filetool-zaphod_CXXFILE)))),$(ports-filetool-zaphod_CXXFILE))))
endif

endif


ifneq ($(ports-filetool-zaphod_OBJC_NARCHFILES),)

ifeq (,)
