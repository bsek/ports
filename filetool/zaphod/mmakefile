  ports-filetool-zaphod_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(ports-filetool-zaphod_OBJDIR)/,$(ports-filetool-zaphod_OBJC_NARCHFILES)))
  ports-filetool-zaphod_MOBJC_WILDCARD := $(ports-filetool-zaphod_OBJDIR)/%

  # Be sure that all .m files are generated
  $(ports-filetool-zaphod_MOBJC_TARGETS) $(ports-filetool-zaphod_MOBJC_DTARGETS) : | $(addsuffix .m,$(ports-filetool-zaphod_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  ports-filetool-zaphod_MOBJC_SRCDIR := $(shell $(ECHO) $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
