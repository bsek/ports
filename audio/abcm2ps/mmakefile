define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-audio-abcm2ps_CXXCMD) $(ports-audio-abcm2ps_CXXIQUOTE) $(dir $(2)) $(ports-audio-abcm2ps_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-audio-abcm2ps_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-audio-abcm2ps_CXXIQUOTE) . $(ports-audio-abcm2ps_CXXIQUOTE_END) $(strip $(ports-audio-abcm2ps_CXXFLAGS) $(ports-audio-abcm2ps_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-audio-abcm2ps_CXXCMD) $(ports-audio-abcm2ps_CXXIQUOTE) $(dir $(2)) $(ports-audio-abcm2ps_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-audio-abcm2ps_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-audio-abcm2ps_CXXIQUOTE) . $(ports-audio-abcm2ps_CXXIQUOTE_END) $(strip $(ports-audio-abcm2ps_CXXFLAGS) $(ports-audio-abcm2ps_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-audio-abcm2ps_CXXCMD) $(ports-audio-abcm2ps_CXXIQUOTE) $(dir $(2)) $(ports-audio-abcm2ps_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-audio-abcm2ps_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-audio-abcm2ps_CXXIQUOTE) . $(ports-audio-abcm2ps_CXXIQUOTE_END) $(strip $(ports-audio-abcm2ps_CXXFLAGS) $(ports-audio-abcm2ps_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-audio-abcm2ps_CXXCMD)" $(MKDEPEND) $(strip $(ports-audio-abcm2ps_DXXFLAGS) $(ports-audio-abcm2ps_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-audio-abcm2ps_OBJDIR),)
  $(foreach ports-audio-abcm2ps_CXXFILE,$(ports-audio-abcm2ps_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-audio-abcm2ps_CXXFILE))),$(ports-audio-abcm2ps_CXXFILE))))
else
  $(foreach ports-audio-abcm2ps_CXXFILE,$(ports-audio-abcm2ps_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-audio-abcm2ps_OBJDIR)/,$(notdir $(basename $(ports-audio-abcm2ps_CXXFILE)))),$(ports-audio-abcm2ps_CXXFILE))))
