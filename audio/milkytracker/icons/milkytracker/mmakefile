include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-audio-milkytracker-icons : ports-audio-milkytracker-icons-milkytracker

ICONS     := MilkyTracker
TARGETDIR := $(AROS_CONTRIB)/MultiMedia/Audio/MilkyTracker


BD_OBJS := $(addprefix  $(TARGETDIR)/, $(addsuffix .info,$(ICONS)))

#MM
ports-audio-milkytracker-icons-milkytracker : $(BD_OBJS)

ifeq (,)

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(TARGETDIR)
else
$(BD_OBJS) :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


ports-audio-milkytracker-icons-milkytracker-clean : FILES := $(BD_OBJS)
#MM
ports-audio-milkytracker-icons-milkytracker-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: ports-audio-milkytracker-icons-milkytracker ports-audio-milkytracker-icons-milkytracker-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
