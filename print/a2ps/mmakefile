.PHONY: ports-print-a2ps--fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-print-a2ps--fetch-location := $(PORTSSOURCEDIR)
else
    ports-print-a2ps--fetch-location := $(ports-print-a2ps-portdir)
endif

ifneq (,)
    ports-print-a2ps--fetch-baseflag := -b 
else
    ports-print-a2ps--fetch-baseflag :=
endif

ports-print-a2ps--fetch-fetchedflag := $(ports-print-a2ps--fetch-location)/.$(ports-print-a2ps--archbase)-fetched

#MM
ports-print-a2ps--fetch :
	$(Q)$(ECHO) "Fetching   $(ports-print-a2ps--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(ports-print-a2ps--archbase) -s "tar.gz" -l $(ports-print-a2ps--fetch-location) \
	-d $(ports-print-a2ps-portdir) $(ports-print-a2ps--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ports-print-a2ps--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(ports-print-a2ps--fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-print-a2ps--fetch-fetchedflag) ; \
	fi


.PHONY: ports-print-a2ps--create-patch

ifneq (,)
    ports-print-a2ps--create-patch-location := 
else
    ports-print-a2ps--create-patch-location := $(PORTSSOURCEDIR)
endif

ifneq (,)
    ports-print-a2ps--create-patch-exclude := -X ./exclude.patterns
endif

ifneq ($(ports-print-a2ps--srcdir),)
    ports-print-a2ps--create-patch-srcdir   := $(ports-print-a2ps--srcdir)
else
    ports-print-a2ps--create-patch-srcdir   := $(ports-print-a2ps--archbase)
endif

ifeq (no,yes)
    ports-print-a2ps--create-patch-diffflag   := --strip-trailing-cr
else
    ports-print-a2ps--create-patch-diffflag   :=
endif

ifneq (,)
    ports-print-a2ps--create-patch-baseflag := -b /tmp
    ports-print-a2ps--create-patch-base := 
else
    ports-print-a2ps--create-patch-baseflag :=
    ports-print-a2ps--create-patch-base := $(ports-print-a2ps-portdir)
