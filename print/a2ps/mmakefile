ifeq (yes,yes)
    ports-print-a2ps--config_opts += --without-pic --disable-shared
ifeq (yes,yes)
# disable native language support
    ports-print-a2ps--config_opts += --disable-nls
endif
ifeq (yes,yes)
# disable X window system
    ports-print-a2ps--config_opts += --without-x
