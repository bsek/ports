#MM- ports-print-a2ps--create-patch :  ports-print-a2ps--create-patch-diff 
#MM- ports-print-a2ps--create-patch-quick :  ports-print-a2ps--create-patch-diff 

#MM
ports-print-a2ps--create-patch-diff:
	$(Q)$(FOR) dir in $(ports-print-a2ps--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-print-a2ps--create-patch-base)/$(ports-print-a2ps--create-patch-srcdir) $(ports-print-a2ps--create-patch-base)/tmp/$(ports-print-a2ps--create-patch-srcdir).aros ; \
	$(FETCH) -a $(ports-print-a2ps--archbase) -s "tar.gz" -f -l $(ports-print-a2ps--create-patch-location) -d $(ports-print-a2ps-portdir) $(ports-print-a2ps--create-patch-baseflag); \
	$(MV) $(ports-print-a2ps--create-patch-base)/$(ports-print-a2ps--create-patch-srcdir) $(ports-print-a2ps--create-patch-base)/tmp/$(ports-print-a2ps--create-patch-srcdir) ; \
	cd $(ports-print-a2ps--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ports-print-a2ps--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-print-a2ps--create-patch-diffflag) $(ports-print-a2ps--create-patch-exclude) \
	    $(ports-print-a2ps--create-patch-srcdir) \
	    $(ports-print-a2ps--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ports-print-a2ps--archbase)-aros-new.diff ; \
	$(MV) $(ports-print-a2ps--create-patch-base)/tmp/$(ports-print-a2ps--create-patch-srcdir).aros $(ports-print-a2ps--create-patch-base)/$(ports-print-a2ps--create-patch-srcdir) ; \
	$(RM) $(ports-print-a2ps--create-patch-base)/tmp

#MM ports-print-a2ps : ports-print-a2ps-
#MM
ports-print-a2ps:
	$(Q)$(NOP)

