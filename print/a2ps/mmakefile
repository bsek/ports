include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-print : ports-print-a2ps

PACKAGE      := a2ps
VERSION      := 4.14
TARGETDIR    := $(AROS_CONTRIB)/Utilities/Print/A2ps
