ports-print-a2ps-archbase                        ?= $(PACKAGE)-$(VERSION)

ifeq (target,host)
    ports-print-a2ps-portdir                     ?= $(HOSTDIR)/Ports/host/$(PACKAGE)
else
    ports-print-a2ps-portdir                     ?= $(PORTSDIR)/$(PACKAGE)
endif

ifeq ($(TARGETDIR),)
    ports-print-a2ps-prefix                      ?= $(CONTRIB_DIR)/$(PACKAGE)
else
