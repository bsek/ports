## **********************************************************************
## Review the following lines once breakage in contrib has been resolved.
# Files are not touched anymore by default, add this to your mmakefile if that is necessry
#<target>-touchfileflag := $(GENDIR)/$(CURDIR)/.files-touched
ports-print-a2ps--touchfileflag ?= $(ports-print-a2ps--pkgdir)/.files-touched
## **********************************************************************

ifneq ("$(wildcard $(ports-print-a2ps-portdir)/$(ports-print-a2ps--builddir)/Makefile)","")
# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(ports-print-a2ps--pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(ports-print-a2ps--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(ports-print-a2ps--pkgdir)))'"
	$(Q)$(CP) -Rf "$(ports-print-a2ps-portdir)/$(ports-print-a2ps--builddir)/." $(ports-print-a2ps--pkgdir)/ && $(TOUCH) $@

$(ports-print-a2ps--touchfileflag) : $(ports-print-a2ps--pkgdir)/.local-copy

    ports-print-a2ps--cfg-srcdir=$(ports-print-a2ps--pkgdir)
else
    ports-print-a2ps--cfg-srcdir=$(ports-print-a2ps-portdir)/$(ports-print-a2ps--builddir)
endif
ports-print-a2ps--make-env += -C $(ports-print-a2ps--pkgdir)

.PHONY : ports-print-a2ps- ports-print-a2ps--clean ports-print-a2ps--build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-print-a2ps--host : setup includes ports-print-a2ps--quick
#MM- ports-print-a2ps--target : setup includes core-linklibs ports-print-a2ps--quick
#MM- ports-print-a2ps-: ports-print-a2ps--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    ports-print-a2ps--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-print-a2ps--pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-print-a2ps--PROGDIR)/" $(ports-print-a2ps--install_opts) \
        $(ports-print-a2ps--make-env) install -j1

    ports-print-a2ps--uninstall_command = \
    $(RM) $(ports-print-a2ps--installflag) && \
    $(MAKE) PROGDIR="$(ports-print-a2ps--PROGDIR)/" \
    $(ports-print-a2ps--install_opts) $(ports-print-a2ps--make-env) uninstall
else
    ports-print-a2ps--install_command   := true
    ports-print-a2ps--uninstall_command := true
endif

#MM- ports-print-a2ps--quick :  ports-print-a2ps--configure  ports-print-a2ps--build_and_install-quick ports-print-a2ps--make-package

#MM
ports-print-a2ps--build_and_install-quick :  $(ports-print-a2ps--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(ports-print-a2ps--installflag) : $(ports-print-a2ps--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-print-a2ps--volfunc, PROGDIR)" -q $(ports-print-a2ps--make-env); then \
	    $(RM) $(ports-print-a2ps--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-print-a2ps--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-print-a2ps--volfunc, PROGDIR)" $(ports-print-a2ps--make-env) && \
	    $(ports-print-a2ps--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(ports-print-a2ps--touchfileflag):
	$(Q)$(FOR) dir in $(ports-print-a2ps--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(ports-print-a2ps-portdir)/$(ports-print-a2ps--builddir) -exec $(TOUCH) -c -r $(ports-print-a2ps--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-print-a2ps--uninstall :
	$(ports-print-a2ps--uninstall_command)

#MM
ports-print-a2ps--configure : $(ports-print-a2ps--configflag)

$(ports-print-a2ps--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-print-a2ps--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-print-a2ps--configflag) : $(ports-print-a2ps--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-print-a2ps--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-print-a2ps--pkgdir))"
	$(ports-print-a2ps--init-env)
	$(Q)cd $(ports-print-a2ps--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-print-a2ps--cfg-env) $(TMP_SRCDIR)/configure $(ports-print-a2ps--config_opts) $(A2PS_OPTS) && \
	$(TOUCH) $@

#MM
ports-print-a2ps--clean : ports-print-a2ps--uninstall
	$(Q)$(RM) $(ports-print-a2ps--pkgdir)

.PHONY : ports-print-a2ps--make-package ports-print-a2ps--create-patch
#MM ports-print-a2ps--make-package : ports-print-a2ps--quick

#MM
ports-print-a2ps--make-package : $(ports-print-a2ps--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(ports-print-a2ps--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(ports-print-a2ps-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(ports-print-a2ps--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(ports-print-a2ps-prefix)" ; \
	    cd $(ports-print-a2ps--package-dir) ; \
	    tar -cvf $(ports-print-a2ps--package-basename).tar * ; \
	    bzip2 -9 -f $(ports-print-a2ps--package-basename).tar ; \
	fi

#MM
ports-print-a2ps-clean :
	$(RM) $(TARGETDIR)
	$(RM) $(GENDIR)/$(CURDIR)

