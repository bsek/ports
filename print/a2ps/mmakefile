endif
endif
endif

ifeq (target,kernel)
    ports-print-a2ps--cfg-env :=  \
        CPP="$(KERNEL_CPP)" \
        CXXCPP="$(KERNEL_CPP)"
ifeq (yes,yes)
    ports-print-a2ps--cfg-env += CPPFLAGS="$(strip $(KERNEL_CPPFLAGS) )"
endif
    ports-print-a2ps--cfg-env += CC="$(strip $(ports-print-a2ps--KERNEL_CC) $(KERNEL_SYSROOT))" \
        CFLAGS="$(strip $(ports-print-a2ps--KERNEL_CFLAGS) $(OPTIMIZATION_CFLAGS))" \
        CXX="$(strip $(ports-print-a2ps--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        CXXFLAGS="$(strip $(ports-print-a2ps--KERNEL_CXXFLAGS) $(OPTIMIZATION_CFLAGS))" \
