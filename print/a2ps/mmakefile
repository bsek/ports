        TARGET_AS="$(strip $(TARGET_AS))" \
        TARGET_OBJCOPY="$(strip $(OBJCOPY))" \
        TARGET_RANLIB="$(strip $(RANLIB))" \
        TARGET_STRIP="$(strip $(STRIP_PLAIN))" \
        TARGET_NM="$(strip $(NM_PLAIN))"
endif

ifeq (yes,yes)
    ports-print-a2ps--config_opts += --target=$(AROS_TARGET_CPU)-aros
    ports-print-a2ps--config_opts += --build=$(AROS_HOST_CPU)-$(AROS_HOST_ARCH)
    ports-print-a2ps--config_opts += --host=$(AROS_TARGET_CPU)-aros
endif
ifeq (yes,yes)
    ports-print-a2ps--config_opts += --without-pic --disable-shared
ifeq (yes,yes)
# disable native language support
