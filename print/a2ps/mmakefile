ports-print-a2ps--KERNEL_CXX?=$(KERNEL_CXX)
ports-print-a2ps--HOST_CXX?=$(HOST_CXX)

# Set up build environment, and options for configure script
ifeq (target,host)
    # NB: We need to pass in our crosstoolsdir, but cannot set CFLAGS since it
    # confused configure scripts. We also cannot pass it via _FOR_BUILD
    # since that won't get picked up during configure.
    # We also cannot pass in the compiler including std flags so we need to use
    # the "plain" host compiler.
    ports-print-a2ps--cfg-env :=  \
        CPP="$(HOST_CPP)" \
        CXXCPP="$(HOST_CPP)" \
        CC="$(strip $(ports-print-a2ps--HOST_CC) $(ports-print-a2ps--HOST_CFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        CXX="$(strip $(ports-print-a2ps--HOST_CXX) $(ports-print-a2ps--HOST_CXXFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        LDFLAGS="-L$(CROSSTOOLSDIR)/lib $(USER_LDFLAGS)"
ifeq (yes,yes)
    ports-print-a2ps--cfg-env += TARGET_CPPFLAGS="$(KERNEL_CPPFLAGS)"
endif
    ports-print-a2ps--cfg-env += TARGET_CC="$(strip $(ports-print-a2ps--KERNEL_CC) $(KERNEL_SYSROOT))" \
        TARGET_CFLAGS="$(strip $(ports-print-a2ps--KERNEL_CFLAGS))" \
        TARGET_CXX="$(strip $(ports-print-a2ps--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        TARGET_CXXFLAGS="$(strip $(ports-print-a2ps--KERNEL_CXXFLAGS))" \
        TARGET_AS="$(TARGET_AS)" \
        OBJCOPY="$(OBJCOPY)" \
        TARGET_RANLIB="$(RANLIB)" \
        TARGET_STRIP="$(STRIP_PLAIN)" \
        TARGET_NM="$(NM_PLAIN)" \
        TARGET_OBJCOPY="$(TARGET_OBJCOPY)"
endif

ifeq (target,target)
    ports-print-a2ps--cfg-env :=  \
        PKG_CONFIG_LIBDIR="$(AROS_DEVELOPER)/lib/pkgconfig" \
        PKG_CONFIG_SYSROOT_DIR="$(AROSDIR)"
ifeq (no,yes)
    ports-print-a2ps--cfg-env += \
        CPP="$(strip $(ports-print-a2ps--CROSS_CPP) $(ports-print-a2ps--CROSS_SYSROOT))" \
        CXXCPP="$(strip $(ports-print-a2ps--CROSS_CPP) $(ports-print-a2ps--CROSS_SYSROOT))" \
        CC="$(strip $(ports-print-a2ps--CROSS_CC) $(ports-print-a2ps--CROSS_SYSROOT))" \
        CXX="$(strip $(ports-print-a2ps--CROSS_CXX) $(ports-print-a2ps--CROSS_SYSROOT))" \
        LD="$(strip $(ports-print-a2ps--CROSS_LD))" \
        AS="$(strip $(ports-print-a2ps--CROSS_AS))" \
        AFLAGS="$(strip $(ports-print-a2ps--CROSS_AFLAGS))" \
        OBJCOPY="$(strip $(ports-print-a2ps--CROSS_OBJCOPY))" \
        RANLIB="$(strip $(ports-print-a2ps--CROSS_RANLIB))" \
        STRIP="$(strip $(ports-print-a2ps--CROSS_STRIP))" \
        CFLAGS="$(strip $(ports-print-a2ps--CROSS_CFLAGS))" \
        CXXFLAGS="$(strip $(ports-print-a2ps--CROSS_CXXFLAGS))" \
        LDFLAGS="$(strip $(ports-print-a2ps--CROSS_LDFLAGS))" \
        LT_LDFLAGS="$(strip $(ports-print-a2ps--CROSS_LDFLAGS))"
    ports-print-a2ps--cfg-env += CC_FOR_HOST="$(strip $(ports-print-a2ps--CROSS_CC) $(ports-print-a2ps--CROSS_SYSROOT))" \
        CFLAGS_FOR_HOST="$(strip $(ports-print-a2ps--CROSS_CFLAGS))" \
        CXX_FOR_HOST="$(strip $(ports-print-a2ps--CROSS_CXX) $(ports-print-a2ps--CROSS_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(ports-print-a2ps--CROSS_CXXFLAGS))" \
        LD_FOR_HOST="$(strip $(ports-print-a2ps--CROSS_LD))" \
        LDFLAGS_FOR_HOST="$(strip $(ports-print-a2ps--CROSS_LDFLAGS))"
else
    ports-print-a2ps--cfg-env += CPP="$(strip $(TARGET_CPP) $(TARGET_SYSROOT))" \
        CXXCPP="$(strip $(TARGET_CPP) $(TARGET_SYSROOT))" \
        CC="$(strip $(ports-print-a2ps--TARGET_CC) $(TARGET_SYSROOT))" \
        CXX="$(strip $(ports-print-a2ps--TARGET_CXX) $(TARGET_SYSROOT))" \
        LD="$(strip $(TARGET_LD))"
