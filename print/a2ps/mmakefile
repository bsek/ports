endif

ifneq (,)
    ports-print-a2ps--archbase      ?= $(PACKAGE)--$(VERSION)
else
    ports-print-a2ps--archbase      ?= $(PACKAGE)-$(VERSION)
endif

ifneq (,)
    ports-print-a2ps--srcdir        ?= 
else
    ports-print-a2ps--srcdir        ?= $(ports-print-a2ps-archbase)
endif

ifneq (,)
    ports-print-a2ps--builddir      ?= $(ports-print-a2ps--srcdir)/
else
    ports-print-a2ps--builddir      ?= $(ports-print-a2ps--srcdir)
endif

ifeq (,)
ifeq (yes,yes)
