    ports-print-a2ps--cfg-env += CC_FOR_BUILD="$(strip $(ports-print-a2ps--HOST_CC))" \
        CFLAGS_FOR_BUILD="$(strip $(ports-print-a2ps--HOST_CFLAGS) $(ports-print-a2ps--ACBUILD_CFLAGS))" \
        CXX_FOR_BUILD="$(strip $(ports-print-a2ps--HOST_CXX))" \
        CXXFLAGS_FOR_BUILD="$(strip $(ports-print-a2ps--HOST_CXXFLAGS) $(ports-print-a2ps--ACBUILD_CXXFLAGS))" \
        LD_FOR_BUILD="$(strip $(HOST_LD))" \
        LDFLAGS_FOR_BUILD="$(strip $(HOST_LDFLAGS) $(ports-print-a2ps--ACBUILD_LDFLAGS) $(ports-print-a2ps--s_flag))"
ifeq (yes,yes)
    ports-print-a2ps--cfg-env += CPPFLAGS_FOR_HOST="$(strip $(BASE_CPPFLAGS)  $(ports-print-a2ps--ACHOST_CPPFLAGS) $(USER_CPPFLAGS) )"
endif
    ports-print-a2ps--cfg-env += CC_FOR_HOST="$(strip $(ports-print-a2ps--TARGET_CC) $(TARGET_SYSROOT))" \
        CFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CFLAGS) $(ports-print-a2ps--ACHOST_CFLAGS) $(USER_CFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(ports-print-a2ps--nix))" \
        CXX_FOR_HOST="$(strip $(ports-print-a2ps--TARGET_CXX) $(TARGET_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CXXFLAGS) $(ports-print-a2ps--ACHOST_CXXFLAGS)  $(USER_CXXFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(ports-print-a2ps--nix))" \
        LD_FOR_HOST="$(strip $(TARGET_LD))" \
        LDFLAGS_FOR_HOST="$(strip $(TARGET_ISA_LDFLAGS) -L$(AROS_DEVELOPER)/lib  $(ports-print-a2ps--ACHOST_LDFLAGS) $(USER_LDFLAGS) $(ports-print-a2ps--nix) $(ports-print-a2ps--s_flag))"
ifeq (yes,yes)
    ports-print-a2ps--cfg-env += CPPFLAGS_FOR_TARGET="$(strip $(BASE_CPPFLAGS) $(ports-print-a2ps--ACTARGET_CPPFLAGS) $(USER_CPPFLAGS) )"
endif
    ports-print-a2ps--cfg-env += CC_FOR_TARGET="$(strip $(ports-print-a2ps--TARGET_CC) $(TARGET_SYSROOT))" \
