$(ports-game-koules_TARGETDIR)/$(ports-game-koules_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-game-koules_ARCHLIBS))
$(ports-game-koules_TARGETDIR)/$(ports-game-koules_PROGNAME) : $(ports-game-koules_OBJS) $(ports-game-koules_ARCHOBJS) $(USER_OBJS) $(ports-game-koules-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-game-koules_LINK) $(strip $(ports-game-koules_LD_OPTS) $(ports-game-koules-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-game-koules_LINK) $(strip $(ports-game-koules_LD_OPTS) $(ports-game-koules-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-game-koules_LINK) $(strip $(ports-game-koules_LD_OPTS) $(ports-game-koules-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-game-koules_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-game-koules_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-game-koules_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-game-koules_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-game-koules_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-game-koules_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-game-koules_DEPS),)
  ifneq (ports-game-koules ports-game-koules-quick,)
    ifneq ($(findstring $(TARGET),ports-game-koules ports-game-koules-quick),)
      -include $(ports-game-koules_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-game-koules_DEPS)
    endif
  endif
endif


ifneq ($(ports-game-koules_OBJS) $(ports-game-koules_DEPS) $(ports-game-koules_TARGETDIR)/$(ports-game-koules_PROGNAME),)
$(ports-game-koules_OBJS) $(ports-game-koules_DEPS) $(ports-game-koules_TARGETDIR)/$(ports-game-koules_PROGNAME) : | $(ports-game-koules_OBJDIR) $(ports-game-koules_TARGETDIR)
else
$(ports-game-koules_OBJS) $(ports-game-koules_DEPS) $(ports-game-koules_TARGETDIR)/$(ports-game-koules_PROGNAME) :: $(ports-game-koules_OBJDIR) $(ports-game-koules_TARGETDIR)
endif

GLOB_MKDIRS += $(ports-game-koules_OBJDIR) $(ports-game-koules_TARGETDIR)


ports-game-koules-clean : FILES := $(ports-game-koules_OBJS) $(ports-game-koules_TARGETDIR)/$(ports-game-koules_PROGNAME) $(ports-game-koules_DEPS)
#MM
ports-game-koules-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget ports-game-koules"
	$(Q)$(RM) $(FILES)




.PHONY: ports-game-koules-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-koules-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-koules-fetch-location := $(PORTSDIR)/koules
endif

ifneq (,)
    ports-game-koules-fetch-baseflag := -b 
else
    ports-game-koules-fetch-baseflag :=
endif

ports-game-koules-fetch-fetchedflag := $(ports-game-koules-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-game-koules-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.bz2" -l $(ports-game-koules-fetch-location) \
	-d $(PORTSDIR)/koules $(ports-game-koules-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "::"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-koules-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-koules-fetch-fetchedflag) ; \
	fi



.PHONY : ports-game-koules-data

#MM
ports-game-koules-data :
	$(Q)$(ECHO) "Copying    directory '$(if $(filter /%,$(PORTSDIR)/koules/$(ARCHBASE)/sounds),$(if $(filter $(SRCDIR)/%,$(abspath $(PORTSDIR)/koules/$(ARCHBASE)/sounds)),$(patsubst $(SRCDIR)/%,%,$(abspath $(PORTSDIR)/koules/$(ARCHBASE)/sounds)),$(patsubst $(TOP)/%,%,$(abspath $(PORTSDIR)/koules/$(ARCHBASE)/sounds))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(PORTSDIR)/koules/$(ARCHBASE)/sounds)))' to '$(if $(filter /%,$(TARGETDIR)/sounds),$(if $(filter $(SRCDIR)/%,$(abspath $(TARGETDIR)/sounds)),$(patsubst $(SRCDIR)/%,%,$(abspath $(TARGETDIR)/sounds)),$(patsubst $(TOP)/%,%,$(abspath $(TARGETDIR)/sounds))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(TARGETDIR)/sounds)))'"
	$(Q)cd $(SRCDIR)/$(CURDIR) && $(CPYDIRREC) -q -s $(PORTSDIR)/koules/$(ARCHBASE)/sounds -d $(TARGETDIR)/sounds -e 



CPYFILES := Koules.guide Koules.guide.info Koules.info


ports-game-koules-cpy_SRC := $(shell $(ECHO) $(PORTSDIR)/koules/$(ARCHBASE) | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(TARGETDIR)
else
setup :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


.PHONY : ports-game-koules-cpy

#MM
ports-game-koules-cpy : | $(TARGETDIR) 
	$(foreach file, $(CPYFILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-game-koules-cpy_SRC)),$(ports-game-koules-cpy_SRC),$(SRCDIR)/$(CURDIR)/$(ports-game-koules-cpy_SRC))/, $(file)) $(addprefix $(TARGETDIR)/, $(file))))



# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
