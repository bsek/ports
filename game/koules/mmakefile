else
  $(foreach ports-game-koules_CXXFILE,$(ports-game-koules_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-game-koules_OBJDIR)/,$(notdir $(basename $(ports-game-koules_CXXFILE)))),$(ports-game-koules_CXXFILE))))
