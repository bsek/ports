# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
ports-game-multipuzzle-link_DIRS := $(subst -L ,-L,$(strip $(ports-game-multipuzzle_LDFLAGS)))
# Filter out only the libdirs and remove -L
ports-game-multipuzzle-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ports-game-multipuzzle-link_DIRS)))
# Add trailing /
ports-game-multipuzzle-link_DIRS := $(subst //,/,$(addsuffix /,$(ports-game-multipuzzle-link_DIRS)))
# Add normal linklib path
ports-game-multipuzzle-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
ports-game-multipuzzle-link_LIBS := $(addprefix lib,$(addsuffix .a,$(ports-game-multipuzzle_LIBS) $(ports-game-multipuzzle-link_EXTRA_LIBS)))
ifeq (yes,yes)
    ports-game-multipuzzle-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-game-multipuzzle-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-game-multipuzzle-link_DEPLIBS := $(foreach lib,$(ports-game-multipuzzle-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-game-multipuzzle-link_DIRS)))) \
)

$(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : OBJDIR := $(ports-game-multipuzzle_OBJDIR)
$(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : OBJS := $(strip $(ports-game-multipuzzle_OBJS) $(ports-game-multipuzzle_ARCHOBJS) $(USER_OBJS))
$(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : LDFLAGS := $(strip $(ports-game-multipuzzle_LDFLAGS))
$(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : LIBS := $(strip $(addprefix -l,$(ports-game-multipuzzle_LIBS) $(ports-game-multipuzzle-link_EXTRA_LIBS)))
$(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-game-multipuzzle_ARCHLIBS))
$(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : $(ports-game-multipuzzle_OBJS) $(ports-game-multipuzzle_ARCHOBJS) $(USER_OBJS) $(ports-game-multipuzzle-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-game-multipuzzle_LINK) $(strip $(ports-game-multipuzzle_LD_OPTS) $(ports-game-multipuzzle-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-game-multipuzzle_LINK) $(strip $(ports-game-multipuzzle_LD_OPTS) $(ports-game-multipuzzle-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-game-multipuzzle_LINK) $(strip $(ports-game-multipuzzle_LD_OPTS) $(ports-game-multipuzzle-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-game-multipuzzle_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-game-multipuzzle_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-game-multipuzzle_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-game-multipuzzle_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-game-multipuzzle_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-game-multipuzzle_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-game-multipuzzle_DEPS),)
  ifneq (ports-game-multipuzzle ports-game-multipuzzle-quick,)
    ifneq ($(findstring $(TARGET),ports-game-multipuzzle ports-game-multipuzzle-quick),)
      -include $(ports-game-multipuzzle_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-game-multipuzzle_DEPS)
    endif
  endif
endif


ifneq ($(ports-game-multipuzzle_OBJS) $(ports-game-multipuzzle_DEPS) $(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME),)
$(ports-game-multipuzzle_OBJS) $(ports-game-multipuzzle_DEPS) $(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) : | $(ports-game-multipuzzle_OBJDIR) $(ports-game-multipuzzle_TARGETDIR)
else
$(ports-game-multipuzzle_OBJS) $(ports-game-multipuzzle_DEPS) $(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) :: $(ports-game-multipuzzle_OBJDIR) $(ports-game-multipuzzle_TARGETDIR)
endif

GLOB_MKDIRS += $(ports-game-multipuzzle_OBJDIR) $(ports-game-multipuzzle_TARGETDIR)


ports-game-multipuzzle-clean : FILES := $(ports-game-multipuzzle_OBJS) $(ports-game-multipuzzle_TARGETDIR)/$(ports-game-multipuzzle_PROGNAME) $(ports-game-multipuzzle_DEPS)
#MM
ports-game-multipuzzle-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget ports-game-multipuzzle"
	$(Q)$(RM) $(FILES)



.PHONY: ports-game-multipuzzle-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-multipuzzle-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-multipuzzle-fetch-location := $(PORTSDIR)/multipuzzle
endif

ifneq (,)
    ports-game-multipuzzle-fetch-baseflag := -b 
else
    ports-game-multipuzzle-fetch-baseflag :=
endif

ports-game-multipuzzle-fetch-fetchedflag := $(ports-game-multipuzzle-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-game-multipuzzle-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.bz2" -l $(ports-game-multipuzzle-fetch-location) \
	-d $(PORTSDIR)/multipuzzle $(ports-game-multipuzzle-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "::"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-multipuzzle-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-multipuzzle-fetch-fetchedflag) ; \
	fi

CPYFILES := beach.ilbm multipuzzle.guide multipuzzle.info

# multipuzzle.guide.info not copied because it has wrong default tool


ports-game-multipuzzle-cpy_SRC := $(shell $(ECHO) $(PORTSDIR)/multipuzzle/$(ARCHBASE) | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(TARGETDIR)
else
setup :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


.PHONY : ports-game-multipuzzle-cpy

#MM
ports-game-multipuzzle-cpy : | $(TARGETDIR) 
	$(foreach file, $(CPYFILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-game-multipuzzle-cpy_SRC)),$(ports-game-multipuzzle-cpy_SRC),$(SRCDIR)/$(CURDIR)/$(ports-game-multipuzzle-cpy_SRC))/, $(file)) $(addprefix $(TARGETDIR)/, $(file))))



# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
