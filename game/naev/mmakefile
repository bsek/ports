.PHONY : ports-game-naev- ports-game-naev--clean ports-game-naev--build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-game-naev--host : setup includes ports-game-naev--quick
#MM- ports-game-naev--target : setup includes core-linklibs ports-game-naev--quick
#MM- ports-game-naev-: ports-game-naev--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    ports-game-naev--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-game-naev--pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-game-naev--PROGDIR)/" $(ports-game-naev--install_opts) \
        $(ports-game-naev--make-env) install -j1

    ports-game-naev--uninstall_command = \
    $(RM) $(ports-game-naev--installflag) && \
    $(MAKE) PROGDIR="$(ports-game-naev--PROGDIR)/" \
    $(ports-game-naev--install_opts) $(ports-game-naev--make-env) uninstall
else
    ports-game-naev--install_command   := true
    ports-game-naev--uninstall_command := true
endif

#MM- ports-game-naev--quick :  ports-game-naev--configure  ports-game-naev--build_and_install-quick ports-game-naev--make-package

#MM
ports-game-naev--build_and_install-quick :  $(ports-game-naev--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(ports-game-naev--installflag) : $(ports-game-naev--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-game-naev--volfunc, PROGDIR)" -q $(ports-game-naev--make-env); then \
	    $(RM) $(ports-game-naev--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-game-naev--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-game-naev--volfunc, PROGDIR)" $(ports-game-naev--make-env) && \
	    $(ports-game-naev--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(ports-game-naev--touchfileflag):
	$(Q)$(FOR) dir in $(ports-game-naev--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(ports-game-naev-portdir)/$(ports-game-naev--builddir) -exec $(TOUCH) -c -r $(ports-game-naev--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-game-naev--uninstall :
	$(ports-game-naev--uninstall_command)

#MM
ports-game-naev--configure : $(ports-game-naev--configflag)

$(ports-game-naev--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-game-naev--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-game-naev--configflag) : $(ports-game-naev--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-game-naev--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-game-naev--pkgdir))"
	$(ports-game-naev--init-env)
	$(Q)cd $(ports-game-naev--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-game-naev--cfg-env) $(TMP_SRCDIR)/configure $(ports-game-naev--config_opts) $(EXTRAOPTIONS) && \
	$(TOUCH) $@

#MM
ports-game-naev--clean : ports-game-naev--uninstall
	$(Q)$(RM) $(ports-game-naev--pkgdir)

.PHONY : ports-game-naev--make-package ports-game-naev--create-patch
#MM ports-game-naev--make-package : ports-game-naev--quick

#MM
ports-game-naev--make-package : $(ports-game-naev--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(ports-game-naev--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(ports-game-naev-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(ports-game-naev--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(ports-game-naev-prefix)" ; \
	    cd $(ports-game-naev--package-dir) ; \
	    tar -cvf $(ports-game-naev--package-basename).tar * ; \
	    bzip2 -9 -f $(ports-game-naev--package-basename).tar ; \
	fi


