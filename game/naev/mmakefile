#MM- ports-game-naev--create-patch :  ports-game-naev--create-patch-diff 
#MM- ports-game-naev--create-patch-quick :  ports-game-naev--create-patch-diff 

#MM
ports-game-naev--create-patch-diff:
	$(Q)$(FOR) dir in $(ports-game-naev--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-game-naev--create-patch-base)/$(ports-game-naev--create-patch-srcdir) $(ports-game-naev--create-patch-base)/tmp/$(ports-game-naev--create-patch-srcdir).aros ; \
	$(FETCH) -a $(ports-game-naev--archbase) -s "tar.bz2" -f -l $(ports-game-naev--create-patch-location) -d $(ports-game-naev-portdir) $(ports-game-naev--create-patch-baseflag); \
	$(MV) $(ports-game-naev--create-patch-base)/$(ports-game-naev--create-patch-srcdir) $(ports-game-naev--create-patch-base)/tmp/$(ports-game-naev--create-patch-srcdir) ; \
	cd $(ports-game-naev--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ports-game-naev--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-game-naev--create-patch-diffflag) $(ports-game-naev--create-patch-exclude) \
	    $(ports-game-naev--create-patch-srcdir) \
	    $(ports-game-naev--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ports-game-naev--archbase)-aros-new.diff ; \
	$(MV) $(ports-game-naev--create-patch-base)/tmp/$(ports-game-naev--create-patch-srcdir).aros $(ports-game-naev--create-patch-base)/$(ports-game-naev--create-patch-srcdir) ; \
	$(RM) $(ports-game-naev--create-patch-base)/tmp

