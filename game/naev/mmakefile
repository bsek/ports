.PHONY: ports-game-naev--fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-naev--fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-naev--fetch-location := $(ports-game-naev-portdir)
endif

ifneq (,)
    ports-game-naev--fetch-baseflag := -b 
else
    ports-game-naev--fetch-baseflag :=
endif

ports-game-naev--fetch-fetchedflag := $(ports-game-naev--fetch-location)/.$(ports-game-naev--archbase)-fetched

#MM
ports-game-naev--fetch :
	$(Q)$(ECHO) "Fetching   $(ports-game-naev--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(ports-game-naev--archbase) -s "tar.bz2" -l $(ports-game-naev--fetch-location) \
	-d $(ports-game-naev-portdir) $(ports-game-naev--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ports-game-naev--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-naev--fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-naev--fetch-fetchedflag) ; \
	fi


