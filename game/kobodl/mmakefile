# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-game-kobodl--host : setup includes ports-game-kobodl--quick
#MM- ports-game-kobodl--target : setup includes core-linklibs ports-game-kobodl--quick
#MM- ports-game-kobodl-: ports-game-kobodl--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    ports-game-kobodl--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-game-kobodl--pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-game-kobodl--PROGDIR)/" $(ports-game-kobodl--install_opts) \
        $(ports-game-kobodl--make-env) install -j1

    ports-game-kobodl--uninstall_command = \
    $(RM) $(ports-game-kobodl--installflag) && \
    $(MAKE) PROGDIR="$(ports-game-kobodl--PROGDIR)/" \
    $(ports-game-kobodl--install_opts) $(ports-game-kobodl--make-env) uninstall
else
    ports-game-kobodl--install_command   := true
    ports-game-kobodl--uninstall_command := true
endif

