#MM- ports-game-kobodl--create-patch :  ports-game-kobodl--create-patch-diff 
#MM- ports-game-kobodl--create-patch-quick :  ports-game-kobodl--create-patch-diff 

#MM
ports-game-kobodl--create-patch-diff:
	$(Q)$(FOR) dir in $(ports-game-kobodl--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-game-kobodl--create-patch-base)/$(ports-game-kobodl--create-patch-srcdir) $(ports-game-kobodl--create-patch-base)/tmp/$(ports-game-kobodl--create-patch-srcdir).aros ; \
	$(FETCH) -a $(ports-game-kobodl--archbase) -s "tar.bz2" -f -l $(ports-game-kobodl--create-patch-location) -d $(ports-game-kobodl-portdir) $(ports-game-kobodl--create-patch-baseflag); \
	$(MV) $(ports-game-kobodl--create-patch-base)/$(ports-game-kobodl--create-patch-srcdir) $(ports-game-kobodl--create-patch-base)/tmp/$(ports-game-kobodl--create-patch-srcdir) ; \
	cd $(ports-game-kobodl--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ports-game-kobodl--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-game-kobodl--create-patch-diffflag) $(ports-game-kobodl--create-patch-exclude) \
	    $(ports-game-kobodl--create-patch-srcdir) \
	    $(ports-game-kobodl--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ports-game-kobodl--archbase)-aros-new.diff ; \
	$(MV) $(ports-game-kobodl--create-patch-base)/tmp/$(ports-game-kobodl--create-patch-srcdir).aros $(ports-game-kobodl--create-patch-base)/$(ports-game-kobodl--create-patch-srcdir) ; \
	$(RM) $(ports-game-kobodl--create-patch-base)/tmp

