$(ports-game-kobodl--installflag) : $(ports-game-kobodl--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-game-kobodl--volfunc, PROGDIR)" -q $(ports-game-kobodl--make-env); then \
	    $(RM) $(ports-game-kobodl--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-game-kobodl--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-game-kobodl--volfunc, PROGDIR)" $(ports-game-kobodl--make-env) && \
	    $(ports-game-kobodl--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

