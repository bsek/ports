# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(ports-game-kobodl--pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(ports-game-kobodl--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(ports-game-kobodl--pkgdir)))'"
	$(Q)$(CP) -Rf "$(ports-game-kobodl-portdir)/$(ports-game-kobodl--builddir)/." $(ports-game-kobodl--pkgdir)/ && $(TOUCH) $@

$(ports-game-kobodl--touchfileflag) : $(ports-game-kobodl--pkgdir)/.local-copy

    ports-game-kobodl--cfg-srcdir=$(ports-game-kobodl--pkgdir)
