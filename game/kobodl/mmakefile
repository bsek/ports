endif

ports-game-kobodl--fetch-fetchedflag := $(ports-game-kobodl--fetch-location)/.$(ports-game-kobodl--archbase)-fetched

#MM
ports-game-kobodl--fetch :
	$(Q)$(ECHO) "Fetching   $(ports-game-kobodl--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(ports-game-kobodl--archbase) -s "tar.bz2" -l $(ports-game-kobodl--fetch-location) \
	-d $(ports-game-kobodl-portdir) $(ports-game-kobodl--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ports-game-kobodl--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-kobodl--fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-kobodl--fetch-fetchedflag) ; \
	fi


