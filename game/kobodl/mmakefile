.PHONY : ports-game-kobodl--make-package ports-game-kobodl--create-patch
#MM ports-game-kobodl--make-package : ports-game-kobodl--quick

#MM
ports-game-kobodl--make-package : $(ports-game-kobodl--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(ports-game-kobodl--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(ports-game-kobodl-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(ports-game-kobodl--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(ports-game-kobodl-prefix)" ; \
	    cd $(ports-game-kobodl--package-dir) ; \
	    tar -cvf $(ports-game-kobodl--package-basename).tar * ; \
	    bzip2 -9 -f $(ports-game-kobodl--package-basename).tar ; \
	fi

