ports-game-kobodl--configure : $(ports-game-kobodl--configflag)

$(ports-game-kobodl--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-game-kobodl--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-game-kobodl--configflag) : $(ports-game-kobodl--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-game-kobodl--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-game-kobodl--pkgdir))"
	$(ports-game-kobodl--init-env)
	$(Q)cd $(ports-game-kobodl--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-game-kobodl--cfg-env) $(TMP_SRCDIR)/configure $(ports-game-kobodl--config_opts) --datarootdir='$$(PROGDIR)share' --sharedstatedir='$$(PROGDIR)com' --localstatedir='$$(PROGDIR)var' --program-transform-name='s/.*/KoboDL/' && \
	$(TOUCH) $@

