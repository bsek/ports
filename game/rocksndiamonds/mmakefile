CPYFILES := ChangeLog COPYING CREDITS


ports-game-rocksndiamonds-cpy_SRC := $(shell $(ECHO) $(PORTSDIR)/rocksndiamonds/$(ARCHBASE) | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(TARGETDIR)
else
setup :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


.PHONY : ports-game-rocksndiamonds-cpy

#MM
ports-game-rocksndiamonds-cpy : | $(TARGETDIR) 
	$(foreach file, $(CPYFILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-game-rocksndiamonds-cpy_SRC)),$(ports-game-rocksndiamonds-cpy_SRC),$(SRCDIR)/$(CURDIR)/$(ports-game-rocksndiamonds-cpy_SRC))/, $(file)) $(addprefix $(TARGETDIR)/, $(file))))


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

