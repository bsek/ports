    ports-game-rocksndiamonds-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-rocksndiamonds-fetch-location := $(PORTSDIR)/rocksndiamonds
endif

ifneq (,)
    ports-game-rocksndiamonds-fetch-baseflag := -b 
else
    ports-game-rocksndiamonds-fetch-baseflag :=
endif

ports-game-rocksndiamonds-fetch-fetchedflag := $(ports-game-rocksndiamonds-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-game-rocksndiamonds-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.gz" -l $(ports-game-rocksndiamonds-fetch-location) \
	-d $(PORTSDIR)/rocksndiamonds $(ports-game-rocksndiamonds-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ARCHBASE)-aros.diff:$(ARCHBASE):-p1"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-rocksndiamonds-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-rocksndiamonds-fetch-fetchedflag) ; \
	fi


.PHONY: ports-game-rocksndiamonds-create-patch

ifneq (,)
    ports-game-rocksndiamonds-create-patch-location := 
else
    ports-game-rocksndiamonds-create-patch-location := $(PORTSSOURCEDIR)
endif

ifneq (,)
    ports-game-rocksndiamonds-create-patch-exclude := -X ./exclude.patterns
endif

ifneq (,)
    ports-game-rocksndiamonds-create-patch-srcdir   := 
else
    ports-game-rocksndiamonds-create-patch-srcdir   := $(ARCHBASE)
endif

ifeq (no,yes)
    ports-game-rocksndiamonds-create-patch-diffflag   := --strip-trailing-cr
else
    ports-game-rocksndiamonds-create-patch-diffflag   :=
endif

ifneq (,)
    ports-game-rocksndiamonds-create-patch-baseflag := -b /tmp
    ports-game-rocksndiamonds-create-patch-base := 
else
    ports-game-rocksndiamonds-create-patch-baseflag :=
    ports-game-rocksndiamonds-create-patch-base := $(PORTSDIR)/rocksndiamonds
endif

#MM- ports-game-rocksndiamonds-create-patch :  ports-game-rocksndiamonds-create-patch-diff 
#MM- ports-game-rocksndiamonds-create-patch-quick :  ports-game-rocksndiamonds-create-patch-diff 

#MM
ports-game-rocksndiamonds-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-game-rocksndiamonds-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-game-rocksndiamonds-create-patch-base)/$(ports-game-rocksndiamonds-create-patch-srcdir) $(ports-game-rocksndiamonds-create-patch-base)/tmp/$(ports-game-rocksndiamonds-create-patch-srcdir).aros ; \
	$(FETCH) -a $(ARCHBASE) -s "tar.gz" -f -l $(ports-game-rocksndiamonds-create-patch-location) -d $(PORTSDIR)/rocksndiamonds $(ports-game-rocksndiamonds-create-patch-baseflag); \
	$(MV) $(ports-game-rocksndiamonds-create-patch-base)/$(ports-game-rocksndiamonds-create-patch-srcdir) $(ports-game-rocksndiamonds-create-patch-base)/tmp/$(ports-game-rocksndiamonds-create-patch-srcdir) ; \
	cd $(ports-game-rocksndiamonds-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-game-rocksndiamonds-create-patch-diffflag) $(ports-game-rocksndiamonds-create-patch-exclude) \
	    $(ports-game-rocksndiamonds-create-patch-srcdir) \
	    $(ports-game-rocksndiamonds-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(ports-game-rocksndiamonds-create-patch-base)/tmp/$(ports-game-rocksndiamonds-create-patch-srcdir).aros $(ports-game-rocksndiamonds-create-patch-base)/$(ports-game-rocksndiamonds-create-patch-srcdir) ; \
	$(RM) $(ports-game-rocksndiamonds-create-patch-base)/tmp

