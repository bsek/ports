	$(Q)cd $(SRCDIR)/$(CURDIR) && $(CPYDIRREC) -q -s $(PORTSDIR)/rocksndiamonds/$(ARCHBASE)/graphics -d $(TARGETDIR)/Data_RO/graphics -e 



