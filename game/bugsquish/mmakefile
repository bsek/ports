  $(ports-game-bugsquish_MOBJC_TARGETS) $(ports-game-bugsquish_MOBJC_DTARGETS) : | $(addsuffix .m,$(ports-game-bugsquish_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  ports-game-bugsquish_MOBJC_SRCDIR := $(shell $(ECHO) $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  ports-game-bugsquish_MOBJC_BASEDIRS := $(shell $(ECHO) $(sort $(dir $(ports-game-bugsquish_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  ports-game-bugsquish_MOBJC_DIRS := $(foreach dir, $(ports-game-bugsquish_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(ports-game-bugsquish_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
