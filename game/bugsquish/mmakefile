$(ports-game-bugsquish_TARGETDIR)/$(ports-game-bugsquish_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-game-bugsquish_ARCHLIBS))
$(ports-game-bugsquish_TARGETDIR)/$(ports-game-bugsquish_PROGNAME) : $(ports-game-bugsquish_OBJS) $(ports-game-bugsquish_ARCHOBJS) $(USER_OBJS) $(ports-game-bugsquish-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-game-bugsquish_LINK) $(strip $(ports-game-bugsquish_LD_OPTS) $(ports-game-bugsquish-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-game-bugsquish_LINK) $(strip $(ports-game-bugsquish_LD_OPTS) $(ports-game-bugsquish-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-game-bugsquish_LINK) $(strip $(ports-game-bugsquish_LD_OPTS) $(ports-game-bugsquish-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-game-bugsquish_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-game-bugsquish_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-game-bugsquish_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-game-bugsquish_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-game-bugsquish_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-game-bugsquish_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-game-bugsquish_DEPS),)
  ifneq (ports-game-bugsquish ports-game-bugsquish-quick,)
    ifneq ($(findstring $(TARGET),ports-game-bugsquish ports-game-bugsquish-quick),)
      -include $(ports-game-bugsquish_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-game-bugsquish_DEPS)
    endif
  endif
endif


ifneq ($(ports-game-bugsquish_OBJS) $(ports-game-bugsquish_DEPS) $(ports-game-bugsquish_TARGETDIR)/$(ports-game-bugsquish_PROGNAME),)
$(ports-game-bugsquish_OBJS) $(ports-game-bugsquish_DEPS) $(ports-game-bugsquish_TARGETDIR)/$(ports-game-bugsquish_PROGNAME) : | $(ports-game-bugsquish_OBJDIR) $(ports-game-bugsquish_TARGETDIR)
else
$(ports-game-bugsquish_OBJS) $(ports-game-bugsquish_DEPS) $(ports-game-bugsquish_TARGETDIR)/$(ports-game-bugsquish_PROGNAME) :: $(ports-game-bugsquish_OBJDIR) $(ports-game-bugsquish_TARGETDIR)
endif

GLOB_MKDIRS += $(ports-game-bugsquish_OBJDIR) $(ports-game-bugsquish_TARGETDIR)


ports-game-bugsquish-clean : FILES := $(ports-game-bugsquish_OBJS) $(ports-game-bugsquish_TARGETDIR)/$(ports-game-bugsquish_PROGNAME) $(ports-game-bugsquish_DEPS)
#MM
ports-game-bugsquish-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget ports-game-bugsquish"
	$(Q)$(RM) $(FILES)



.PHONY: ports-game-bugsquish-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-bugsquish-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-bugsquish-fetch-location := $(PORTSDIR)/bugsquish
endif

ifneq (,)
    ports-game-bugsquish-fetch-baseflag := -b 
else
    ports-game-bugsquish-fetch-baseflag :=
endif

ports-game-bugsquish-fetch-fetchedflag := $(ports-game-bugsquish-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-game-bugsquish-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.gz" -l $(ports-game-bugsquish-fetch-location) \
	-d $(PORTSDIR)/bugsquish $(ports-game-bugsquish-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "bugsquish-0.0.6-aros.diff:$(ARCHBASE):-p1"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-bugsquish-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-bugsquish-fetch-fetchedflag) ; \
	fi


.PHONY : ports-game-bugsquish-data

#MM
ports-game-bugsquish-data :
	$(Q)$(ECHO) "Copying    directory '$(if $(filter /%,$(PORTSDIR)/bugsquish/$(ARCHBASE)/data),$(if $(filter $(SRCDIR)/%,$(abspath $(PORTSDIR)/bugsquish/$(ARCHBASE)/data)),$(patsubst $(SRCDIR)/%,%,$(abspath $(PORTSDIR)/bugsquish/$(ARCHBASE)/data)),$(patsubst $(TOP)/%,%,$(abspath $(PORTSDIR)/bugsquish/$(ARCHBASE)/data))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(PORTSDIR)/bugsquish/$(ARCHBASE)/data)))' to '$(if $(filter /%,$(TARGETDIR)/data),$(if $(filter $(SRCDIR)/%,$(abspath $(TARGETDIR)/data)),$(patsubst $(SRCDIR)/%,%,$(abspath $(TARGETDIR)/data)),$(patsubst $(TOP)/%,%,$(abspath $(TARGETDIR)/data))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(TARGETDIR)/data)))'"
	$(Q)cd $(SRCDIR)/$(CURDIR) && $(CPYDIRREC) -q -s $(PORTSDIR)/bugsquish/$(ARCHBASE)/data -d $(TARGETDIR)/data -e 


CPYFILES := CHANGES.txt COPYING.txt README.txt


ports-game-bugsquish-cpy_SRC := $(shell $(ECHO) $(PORTSDIR)/bugsquish/$(ARCHBASE) | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(TARGETDIR)
else
setup :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


.PHONY : ports-game-bugsquish-cpy

#MM
ports-game-bugsquish-cpy : | $(TARGETDIR) 
	$(foreach file, $(CPYFILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-game-bugsquish-cpy_SRC)),$(ports-game-bugsquish-cpy_SRC),$(SRCDIR)/$(CURDIR)/$(ports-game-bugsquish-cpy_SRC))/, $(file)) $(addprefix $(TARGETDIR)/, $(file))))


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
