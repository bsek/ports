  ports-game-bugsquish_LD_OPTS ?= $(KERNEL_ISA_LDFLAGS)
  ports-game-bugsquish_CXXLDFLAGS = $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
ifneq ($(TARGET_CXX_LIBS),)
  ports-game-bugsquish_ARCHLIBS += $(KERNEL_CXX_LIBS)
endif
  ports-game-bugsquish_LDFLAGS ?= $(ports-game-bugsquish_CXXLDFLAGS)
  ports-game-bugsquish_STRIP ?= $(ECHO) >/dev/null
  ports-game-bugsquish_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
