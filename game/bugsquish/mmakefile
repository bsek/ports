  ports-game-bugsquish_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(ports-game-bugsquish_MCXX_CPPFLAGS) $(ports-game-bugsquish_MCXX_EXTRA_CPPFLAGS))
  ports-game-bugsquish_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-game-bugsquish_CXXFLAGS))
