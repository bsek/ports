    ports-game-bugsquish_MOBJC_DIRS := $(shell $(ECHO) $(ports-game-bugsquish_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(ports-game-bugsquish_MOBJC_DIRS)
  endif
