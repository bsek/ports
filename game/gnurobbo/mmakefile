define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-game-gnurobbo_CXXCMD) $(ports-game-gnurobbo_CXXIQUOTE) $(dir $(2)) $(ports-game-gnurobbo_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-game-gnurobbo_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-game-gnurobbo_CXXIQUOTE) . $(ports-game-gnurobbo_CXXIQUOTE_END) $(strip $(ports-game-gnurobbo_CXXFLAGS) $(ports-game-gnurobbo_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-game-gnurobbo_CXXCMD) $(ports-game-gnurobbo_CXXIQUOTE) $(dir $(2)) $(ports-game-gnurobbo_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-game-gnurobbo_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-game-gnurobbo_CXXIQUOTE) . $(ports-game-gnurobbo_CXXIQUOTE_END) $(strip $(ports-game-gnurobbo_CXXFLAGS) $(ports-game-gnurobbo_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-game-gnurobbo_CXXCMD) $(ports-game-gnurobbo_CXXIQUOTE) $(dir $(2)) $(ports-game-gnurobbo_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-game-gnurobbo_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-game-gnurobbo_CXXIQUOTE) . $(ports-game-gnurobbo_CXXIQUOTE_END) $(strip $(ports-game-gnurobbo_CXXFLAGS) $(ports-game-gnurobbo_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-game-gnurobbo_CXXCMD)" $(MKDEPEND) $(strip $(ports-game-gnurobbo_DXXFLAGS) $(ports-game-gnurobbo_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-game-gnurobbo_OBJDIR),)
  $(foreach ports-game-gnurobbo_CXXFILE,$(ports-game-gnurobbo_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-game-gnurobbo_CXXFILE))),$(ports-game-gnurobbo_CXXFILE))))
else
  $(foreach ports-game-gnurobbo_CXXFILE,$(ports-game-gnurobbo_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-game-gnurobbo_OBJDIR)/,$(notdir $(basename $(ports-game-gnurobbo_CXXFILE)))),$(ports-game-gnurobbo_CXXFILE))))
