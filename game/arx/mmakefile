## Review the following lines once breakage in contrib has been resolved.
# Files are not touched anymore by default, add this to your mmakefile if that is necessry
#<target>-touchfileflag := $(GENDIR)/$(CURDIR)/.files-touched
ports-game-arx-touchfileflag ?= $(ports-game-arx-pkgdir)/.files-touched
## **********************************************************************
ifeq (yes,yes)
$(ports-game-arx-touchfileflag):
	$(Q)$(FOR) dir in $(ports-game-arx-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(PORTSDIR)/arx/$(PACKAGE)-$(VERSION) -exec $(TOUCH) -c -r $(PORTSDIR)/arx/$(PACKAGE)-$(VERSION)/CMakeLists.txt '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-game-arx-cmake :  $(ports-game-arx-cmakeflag) 

$(ports-game-arx-cmakeflag) : TMP_SRCDIR := $(shell $(ECHO) $(PORTSDIR)/arx/$(PACKAGE)-$(VERSION) | sed 's/^\(.\):\//\/\1\//')
$(ports-game-arx-cmakeflag) : $(ports-game-arx-touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(RM) $@
	$(Q)$(FOR) dir in $(ports-game-arx-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)cd $(ports-game-arx-pkgdir) && \
	$(RM) -Rf CMakeCache.txt CMakeFiles \; && \
	$(ports-game-arx-cmake-env) $(CMAKE) $(ports-game-arx-cmake_opts) $(ARX_OPTIONS) $(TMP_SRCDIR) && \
	$(TOUCH) $@

