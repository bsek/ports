.PHONY: ports-game-arx-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-arx-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-arx-fetch-location := $(PORTSDIR)/arx
endif

ifneq (,)
    ports-game-arx-fetch-baseflag := -b 
else
    ports-game-arx-fetch-baseflag :=
endif

ports-game-arx-fetch-fetchedflag := $(ports-game-arx-fetch-location)/.$(VERSION)-fetched

#MM
ports-game-arx-fetch :
	$(Q)$(ECHO) "Fetching   $(VERSION) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(VERSION) -s "tar.gz" -l $(ports-game-arx-fetch-location) \
	-d $(PORTSDIR)/arx $(ports-game-arx-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(VERSION)-aros.diff::-p0"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-arx-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-arx-fetch-fetchedflag) ; \
	fi


