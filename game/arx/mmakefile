else
    ports-game-arx-create-patch-location := $(PORTSSOURCEDIR)
endif

ifneq (,)
    ports-game-arx-create-patch-exclude := -X ./exclude.patterns
endif

ifneq ($(PACKAGE)-$(VERSION),)
    ports-game-arx-create-patch-srcdir   := $(PACKAGE)-$(VERSION)
else
    ports-game-arx-create-patch-srcdir   := $(VERSION)
endif

ifeq (no,yes)
    ports-game-arx-create-patch-diffflag   := --strip-trailing-cr
else
    ports-game-arx-create-patch-diffflag   :=
endif

ifneq (,)
    ports-game-arx-create-patch-baseflag := -b /tmp
    ports-game-arx-create-patch-base := 
else
    ports-game-arx-create-patch-baseflag :=
    ports-game-arx-create-patch-base := $(PORTSDIR)/arx
endif

#MM- ports-game-arx-create-patch :  ports-game-arx-create-patch-diff 
#MM- ports-game-arx-create-patch-quick :  ports-game-arx-create-patch-diff 

#MM
ports-game-arx-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-game-arx-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-game-arx-create-patch-base)/$(ports-game-arx-create-patch-srcdir) $(ports-game-arx-create-patch-base)/tmp/$(ports-game-arx-create-patch-srcdir).aros ; \
	$(FETCH) -a $(VERSION) -s "tar.gz" -f -l $(ports-game-arx-create-patch-location) -d $(PORTSDIR)/arx $(ports-game-arx-create-patch-baseflag); \
	$(MV) $(ports-game-arx-create-patch-base)/$(ports-game-arx-create-patch-srcdir) $(ports-game-arx-create-patch-base)/tmp/$(ports-game-arx-create-patch-srcdir) ; \
	cd $(ports-game-arx-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(VERSION)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-game-arx-create-patch-diffflag) $(ports-game-arx-create-patch-exclude) \
	    $(ports-game-arx-create-patch-srcdir) \
	    $(ports-game-arx-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(VERSION)-aros-new.diff ; \
	$(MV) $(ports-game-arx-create-patch-base)/tmp/$(ports-game-arx-create-patch-srcdir).aros $(ports-game-arx-create-patch-base)/$(ports-game-arx-create-patch-srcdir) ; \
	$(RM) $(ports-game-arx-create-patch-base)/tmp

