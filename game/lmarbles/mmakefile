	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(ports-game-lmarbles--pkgdir)))'"
	$(Q)$(CP) -Rf "$(ports-game-lmarbles-portdir)/$(ports-game-lmarbles--builddir)/." $(ports-game-lmarbles--pkgdir)/ && $(TOUCH) $@

$(ports-game-lmarbles--touchfileflag) : $(ports-game-lmarbles--pkgdir)/.local-copy

    ports-game-lmarbles--cfg-srcdir=$(ports-game-lmarbles--pkgdir)
