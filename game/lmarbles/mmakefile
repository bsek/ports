#MM- ports-game-lmarbles--create-patch :  ports-game-lmarbles--create-patch-diff 
#MM- ports-game-lmarbles--create-patch-quick :  ports-game-lmarbles--create-patch-diff 

#MM
ports-game-lmarbles--create-patch-diff:
	$(Q)$(FOR) dir in $(ports-game-lmarbles--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-game-lmarbles--create-patch-base)/$(ports-game-lmarbles--create-patch-srcdir) $(ports-game-lmarbles--create-patch-base)/tmp/$(ports-game-lmarbles--create-patch-srcdir).aros ; \
	$(FETCH) -a $(ports-game-lmarbles--archbase) -s "tar.gz" -f -l $(ports-game-lmarbles--create-patch-location) -d $(ports-game-lmarbles-portdir) $(ports-game-lmarbles--create-patch-baseflag); \
	$(MV) $(ports-game-lmarbles--create-patch-base)/$(ports-game-lmarbles--create-patch-srcdir) $(ports-game-lmarbles--create-patch-base)/tmp/$(ports-game-lmarbles--create-patch-srcdir) ; \
	cd $(ports-game-lmarbles--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ports-game-lmarbles--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-game-lmarbles--create-patch-diffflag) $(ports-game-lmarbles--create-patch-exclude) \
	    $(ports-game-lmarbles--create-patch-srcdir) \
	    $(ports-game-lmarbles--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ports-game-lmarbles--archbase)-aros-new.diff ; \
	$(MV) $(ports-game-lmarbles--create-patch-base)/tmp/$(ports-game-lmarbles--create-patch-srcdir).aros $(ports-game-lmarbles--create-patch-base)/$(ports-game-lmarbles--create-patch-srcdir) ; \
	$(RM) $(ports-game-lmarbles--create-patch-base)/tmp

