.PHONY: ports-game-lmarbles--fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-lmarbles--fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-lmarbles--fetch-location := $(ports-game-lmarbles-portdir)
endif

ifneq (,)
    ports-game-lmarbles--fetch-baseflag := -b 
else
    ports-game-lmarbles--fetch-baseflag :=
endif

ports-game-lmarbles--fetch-fetchedflag := $(ports-game-lmarbles--fetch-location)/.$(ports-game-lmarbles--archbase)-fetched

#MM
ports-game-lmarbles--fetch :
	$(Q)$(ECHO) "Fetching   $(ports-game-lmarbles--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(ports-game-lmarbles--archbase) -s "tar.gz" -l $(ports-game-lmarbles--fetch-location) \
	-d $(ports-game-lmarbles-portdir) $(ports-game-lmarbles--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ports-game-lmarbles--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-lmarbles--fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-lmarbles--fetch-fetchedflag) ; \
	fi


