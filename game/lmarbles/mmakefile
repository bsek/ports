ports-game-lmarbles--configure : $(ports-game-lmarbles--configflag)

$(ports-game-lmarbles--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-game-lmarbles--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-game-lmarbles--configflag) : $(ports-game-lmarbles--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-game-lmarbles--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-game-lmarbles--pkgdir))"
	$(ports-game-lmarbles--init-env)
	$(Q)cd $(ports-game-lmarbles--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-game-lmarbles--cfg-env) $(TMP_SRCDIR)/configure $(ports-game-lmarbles--config_opts) $(LMARBLES_EXTRAOPTS) && \
	$(TOUCH) $@

