ports-game-lmarbles--build_and_install-quick :  $(ports-game-lmarbles--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(ports-game-lmarbles--installflag) : $(ports-game-lmarbles--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-game-lmarbles--volfunc, PROGDIR)" -q $(ports-game-lmarbles--make-env); then \
	    $(RM) $(ports-game-lmarbles--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-game-lmarbles--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-game-lmarbles--volfunc, PROGDIR)" $(ports-game-lmarbles--make-env) && \
	    $(ports-game-lmarbles--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(ports-game-lmarbles--touchfileflag):
	$(Q)$(FOR) dir in $(ports-game-lmarbles--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(ports-game-lmarbles-portdir)/$(ports-game-lmarbles--builddir) -exec $(TOUCH) -c -r $(ports-game-lmarbles--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

