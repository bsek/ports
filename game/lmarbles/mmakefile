# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-game-lmarbles--host : setup includes ports-game-lmarbles--quick
#MM- ports-game-lmarbles--target : setup includes core-linklibs ports-game-lmarbles--quick
#MM- ports-game-lmarbles-: ports-game-lmarbles--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (,)
    ports-game-lmarbles--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-game-lmarbles--pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-game-lmarbles--PROGDIR)/" $(ports-game-lmarbles--install_opts) \
        $(ports-game-lmarbles--make-env)  -j1

    ports-game-lmarbles--uninstall_command = \
    $(RM) $(ports-game-lmarbles--installflag) && \
    $(MAKE) PROGDIR="$(ports-game-lmarbles--PROGDIR)/" \
    $(ports-game-lmarbles--install_opts) $(ports-game-lmarbles--make-env) uninstall
else
    ports-game-lmarbles--install_command   := true
    ports-game-lmarbles--uninstall_command := true
endif

