.PHONY: ports-game-magnetic-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-magnetic-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-magnetic-fetch-location := $(PORTSDIR)/magnetic
endif

ifneq (,)
    ports-game-magnetic-fetch-baseflag := -b 
else
    ports-game-magnetic-fetch-baseflag :=
endif

ports-game-magnetic-fetch-fetchedflag := $(ports-game-magnetic-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-game-magnetic-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.bz2" -l $(ports-game-magnetic-fetch-location) \
	-d $(PORTSDIR)/magnetic $(ports-game-magnetic-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "::"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-magnetic-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-magnetic-fetch-fetchedflag) ; \
	fi



.PHONY : ports-game-magnetic-data

#MM
ports-game-magnetic-data :
	$(Q)$(ECHO) "Copying    directory '$(if $(filter /%,$(PORTSDIR)/magnetic/$(ARCHBASE)/Scripts),$(if $(filter $(SRCDIR)/%,$(abspath $(PORTSDIR)/magnetic/$(ARCHBASE)/Scripts)),$(patsubst $(SRCDIR)/%,%,$(abspath $(PORTSDIR)/magnetic/$(ARCHBASE)/Scripts)),$(patsubst $(TOP)/%,%,$(abspath $(PORTSDIR)/magnetic/$(ARCHBASE)/Scripts))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(PORTSDIR)/magnetic/$(ARCHBASE)/Scripts)))' to '$(if $(filter /%,$(TARGETDIR)/Scripts),$(if $(filter $(SRCDIR)/%,$(abspath $(TARGETDIR)/Scripts)),$(patsubst $(SRCDIR)/%,%,$(abspath $(TARGETDIR)/Scripts)),$(patsubst $(TOP)/%,%,$(abspath $(TARGETDIR)/Scripts))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(TARGETDIR)/Scripts)))'"
	$(Q)cd $(SRCDIR)/$(CURDIR) && $(CPYDIRREC) -q -s $(PORTSDIR)/magnetic/$(ARCHBASE)/Scripts -d $(TARGETDIR)/Scripts -e 



CPYFILES := COPYING README.txt


ports-game-magnetic-cpy_SRC := $(shell $(ECHO) $(PORTSDIR)/magnetic/$(ARCHBASE) | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(TARGETDIR)
else
setup :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


.PHONY : ports-game-magnetic-cpy

#MM
ports-game-magnetic-cpy : | $(TARGETDIR) 
	$(foreach file, $(CPYFILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-game-magnetic-cpy_SRC)),$(ports-game-magnetic-cpy_SRC),$(SRCDIR)/$(CURDIR)/$(ports-game-magnetic-cpy_SRC))/, $(file)) $(addprefix $(TARGETDIR)/, $(file))))



