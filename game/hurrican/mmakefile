#MM- ports-game-hurrican-create-patch :  ports-game-hurrican-create-patch-diff 
#MM- ports-game-hurrican-create-patch-quick :  ports-game-hurrican-create-patch-diff 

#MM
ports-game-hurrican-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-game-hurrican-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-game-hurrican-create-patch-base)/$(ports-game-hurrican-create-patch-srcdir) $(ports-game-hurrican-create-patch-base)/tmp/$(ports-game-hurrican-create-patch-srcdir).aros ; \
	$(FETCH) -a $(ARCHBASE) -s "tar.bz2" -f -l $(ports-game-hurrican-create-patch-location) -d $(PORTSDIR)/hurrican $(ports-game-hurrican-create-patch-baseflag); \
	$(MV) $(ports-game-hurrican-create-patch-base)/$(ports-game-hurrican-create-patch-srcdir) $(ports-game-hurrican-create-patch-base)/tmp/$(ports-game-hurrican-create-patch-srcdir) ; \
	cd $(ports-game-hurrican-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-game-hurrican-create-patch-diffflag) $(ports-game-hurrican-create-patch-exclude) \
	    $(ports-game-hurrican-create-patch-srcdir) \
	    $(ports-game-hurrican-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(ports-game-hurrican-create-patch-base)/tmp/$(ports-game-hurrican-create-patch-srcdir).aros $(ports-game-hurrican-create-patch-base)/$(ports-game-hurrican-create-patch-srcdir) ; \
	$(RM) $(ports-game-hurrican-create-patch-base)/tmp

