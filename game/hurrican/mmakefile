.PHONY: ports-game-hurrican-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-game-hurrican-fetch-location := $(PORTSSOURCEDIR)
else
    ports-game-hurrican-fetch-location := $(PORTSDIR)/hurrican
endif

ifneq (,)
    ports-game-hurrican-fetch-baseflag := -b 
else
    ports-game-hurrican-fetch-baseflag :=
endif

ports-game-hurrican-fetch-fetchedflag := $(ports-game-hurrican-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-game-hurrican-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.bz2" -l $(ports-game-hurrican-fetch-location) \
	-d $(PORTSDIR)/hurrican $(ports-game-hurrican-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ARCHBASE)-aros.diff:$(ARCHBASE):-p1"
	$(Q)$(IF) ! $(TEST) -f $(ports-game-hurrican-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-game-hurrican-fetch-fetchedflag) ; \
	fi


