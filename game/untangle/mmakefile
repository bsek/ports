ifeq ($(ports-game-untangle-bin_OBJDIR),)
  ports-game-untangle-bin_MOBJC_TARGETS := $(addsuffix .o,$(ports-game-untangle-bin_OBJC_NARCHFILES))
  ports-game-untangle-bin_MOBJC_DTARGETS := $(addsuffix .d,$(ports-game-untangle-bin_OBJC_NARCHFILES))
