  ports-game-untangle-bin_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(ports-game-untangle-bin_OBJDIR)/,$(ports-game-untangle-bin_OBJC_NARCHFILES)))
  ports-game-untangle-bin_MOBJC_WILDCARD := $(ports-game-untangle-bin_OBJDIR)/%

