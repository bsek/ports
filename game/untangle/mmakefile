  # Be sure that all .m files are found
  ports-game-untangle-bin_MOBJC_SRCDIR := $(shell $(ECHO) $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  ports-game-untangle-bin_MOBJC_BASEDIRS := $(shell $(ECHO) $(sort $(dir $(ports-game-untangle-bin_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
