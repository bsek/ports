include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-game-biniax2-icons : ports-game-biniax2-icons-biniax2

ICONS     := Biniax2
TARGETDIR := $(AROS_CONTRIB)/Games/Action/Biniax2


BD_OBJS := $(addprefix  $(TARGETDIR)/, $(addsuffix .info,$(ICONS)))

#MM
ports-game-biniax2-icons : $(BD_OBJS)

ifeq (,)

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(TARGETDIR)
else
$(BD_OBJS) :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


ports-game-biniax2-icons-clean : FILES := $(BD_OBJS)
#MM
ports-game-biniax2-icons-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: ports-game-biniax2-icons ports-game-biniax2-icons-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
