define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-graphics-zunepaint_CXXCMD) $(ports-graphics-zunepaint_CXXIQUOTE) $(dir $(2)) $(ports-graphics-zunepaint_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-graphics-zunepaint_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-graphics-zunepaint_CXXIQUOTE) . $(ports-graphics-zunepaint_CXXIQUOTE_END) $(strip $(ports-graphics-zunepaint_CXXFLAGS) $(ports-graphics-zunepaint_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-graphics-zunepaint_CXXCMD) $(ports-graphics-zunepaint_CXXIQUOTE) $(dir $(2)) $(ports-graphics-zunepaint_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-graphics-zunepaint_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-graphics-zunepaint_CXXIQUOTE) . $(ports-graphics-zunepaint_CXXIQUOTE_END) $(strip $(ports-graphics-zunepaint_CXXFLAGS) $(ports-graphics-zunepaint_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-graphics-zunepaint_CXXCMD) $(ports-graphics-zunepaint_CXXIQUOTE) $(dir $(2)) $(ports-graphics-zunepaint_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-graphics-zunepaint_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-graphics-zunepaint_CXXIQUOTE) . $(ports-graphics-zunepaint_CXXIQUOTE_END) $(strip $(ports-graphics-zunepaint_CXXFLAGS) $(ports-graphics-zunepaint_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-graphics-zunepaint_CXXCMD)" $(MKDEPEND) $(strip $(ports-graphics-zunepaint_DXXFLAGS) $(ports-graphics-zunepaint_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-graphics-zunepaint_OBJDIR),)
  $(foreach ports-graphics-zunepaint_CXXFILE,$(ports-graphics-zunepaint_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-graphics-zunepaint_CXXFILE))),$(ports-graphics-zunepaint_CXXFILE))))
else
  $(foreach ports-graphics-zunepaint_CXXFILE,$(ports-graphics-zunepaint_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-graphics-zunepaint_OBJDIR)/,$(notdir $(basename $(ports-graphics-zunepaint_CXXFILE)))),$(ports-graphics-zunepaint_CXXFILE))))
