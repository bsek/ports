include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-scientific-mathomatic-icons : ports-scientific-mathomatic-icons-mathomatic

ICONS     := Mathomatic
TARGETDIR := $(AROS_CONTRIB)/Utilities/Scientific/Mathomatic


BD_OBJS := $(addprefix  $(TARGETDIR)/, $(addsuffix .info,$(ICONS)))

#MM
ports-scientific-mathomatic-icons-mathomatic : $(BD_OBJS)

ifeq (,)

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(TARGETDIR)
else
$(BD_OBJS) :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


ports-scientific-mathomatic-icons-mathomatic-clean : FILES := $(BD_OBJS)
#MM
ports-scientific-mathomatic-icons-mathomatic-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: ports-scientific-mathomatic-icons-mathomatic ports-scientific-mathomatic-icons-mathomatic-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
