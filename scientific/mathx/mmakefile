ports-scientific-mathx-link_DIRS := $(subst -L ,-L,$(strip $(ports-scientific-mathx_LDFLAGS)))
# Filter out only the libdirs and remove -L
ports-scientific-mathx-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ports-scientific-mathx-link_DIRS)))
# Add trailing /
ports-scientific-mathx-link_DIRS := $(subst //,/,$(addsuffix /,$(ports-scientific-mathx-link_DIRS)))
# Add normal linklib path
ports-scientific-mathx-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
ports-scientific-mathx-link_LIBS := $(addprefix lib,$(addsuffix .a,$(ports-scientific-mathx_LIBS) $(ports-scientific-mathx-link_EXTRA_LIBS)))
ifeq (yes,yes)
    ports-scientific-mathx-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-scientific-mathx-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-scientific-mathx-link_DEPLIBS := $(foreach lib,$(ports-scientific-mathx-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-scientific-mathx-link_DIRS)))) \
)

$(ports-scientific-mathx_TARGETDIR)/$(ports-scientific-mathx_PROGNAME) : OBJDIR := $(ports-scientific-mathx_OBJDIR)
$(ports-scientific-mathx_TARGETDIR)/$(ports-scientific-mathx_PROGNAME) : OBJS := $(strip $(ports-scientific-mathx_OBJS) $(ports-scientific-mathx_ARCHOBJS) $(USER_OBJS))
$(ports-scientific-mathx_TARGETDIR)/$(ports-scientific-mathx_PROGNAME) : LDFLAGS := $(strip $(ports-scientific-mathx_LDFLAGS))
$(ports-scientific-mathx_TARGETDIR)/$(ports-scientific-mathx_PROGNAME) : LIBS := $(strip $(addprefix -l,$(ports-scientific-mathx_LIBS) $(ports-scientific-mathx-link_EXTRA_LIBS)))
$(ports-scientific-mathx_TARGETDIR)/$(ports-scientific-mathx_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-scientific-mathx_ARCHLIBS))
$(ports-scientific-mathx_TARGETDIR)/$(ports-scientific-mathx_PROGNAME) : $(ports-scientific-mathx_OBJS) $(ports-scientific-mathx_ARCHOBJS) $(USER_OBJS) $(ports-scientific-mathx-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-scientific-mathx_LINK) $(strip $(ports-scientific-mathx_LD_OPTS) $(ports-scientific-mathx-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-scientific-mathx_LINK) $(strip $(ports-scientific-mathx_LD_OPTS) $(ports-scientific-mathx-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-scientific-mathx_LINK) $(strip $(ports-scientific-mathx_LD_OPTS) $(ports-scientific-mathx-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-scientific-mathx_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-scientific-mathx_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-scientific-mathx_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-scientific-mathx_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-scientific-mathx_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-scientific-mathx_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

