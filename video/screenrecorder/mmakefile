define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-video-screenrecorder_CXXCMD) $(ports-video-screenrecorder_CXXIQUOTE) $(dir $(2)) $(ports-video-screenrecorder_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-video-screenrecorder_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-video-screenrecorder_CXXIQUOTE) . $(ports-video-screenrecorder_CXXIQUOTE_END) $(strip $(ports-video-screenrecorder_CXXFLAGS) $(ports-video-screenrecorder_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-video-screenrecorder_CXXCMD) $(ports-video-screenrecorder_CXXIQUOTE) $(dir $(2)) $(ports-video-screenrecorder_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-video-screenrecorder_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-video-screenrecorder_CXXIQUOTE) . $(ports-video-screenrecorder_CXXIQUOTE_END) $(strip $(ports-video-screenrecorder_CXXFLAGS) $(ports-video-screenrecorder_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-video-screenrecorder_CXXCMD) $(ports-video-screenrecorder_CXXIQUOTE) $(dir $(2)) $(ports-video-screenrecorder_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-video-screenrecorder_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-video-screenrecorder_CXXIQUOTE) . $(ports-video-screenrecorder_CXXIQUOTE_END) $(strip $(ports-video-screenrecorder_CXXFLAGS) $(ports-video-screenrecorder_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-video-screenrecorder_CXXCMD)" $(MKDEPEND) $(strip $(ports-video-screenrecorder_DXXFLAGS) $(ports-video-screenrecorder_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-video-screenrecorder_OBJDIR),)
  $(foreach ports-video-screenrecorder_CXXFILE,$(ports-video-screenrecorder_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-video-screenrecorder_CXXFILE))),$(ports-video-screenrecorder_CXXFILE))))
else
  $(foreach ports-video-screenrecorder_CXXFILE,$(ports-video-screenrecorder_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-video-screenrecorder_OBJDIR)/,$(notdir $(basename $(ports-video-screenrecorder_CXXFILE)))),$(ports-video-screenrecorder_CXXFILE))))
