include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-video-screenrecorder : ports-video-screenrecorder-icons

ICONS     := ScreenRecorder
TARGETDIR := $(AROS_CONTRIB)/MultiMedia/Video


BD_OBJS := $(addprefix  $(TARGETDIR)/, $(addsuffix .info,$(ICONS)))

#MM
ports-video-screenrecorder-icons : $(BD_OBJS)

ifeq (,)

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(TARGETDIR)
else
$(BD_OBJS) :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


ports-video-screenrecorder-icons-clean : FILES := $(BD_OBJS)
#MM
ports-video-screenrecorder-icons-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: ports-video-screenrecorder-icons ports-video-screenrecorder-icons-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
