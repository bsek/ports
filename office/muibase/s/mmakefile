include $(SRCDIR)/config/aros-contrib.cfg

FILES := Package-Startup Package-Shutdown

#MM- ports-office-muibase : ports-office-muibase-startup

#MM- ports-office-muibase-startup : workbench-prefs-envarc ports-office-muibase-startupfiles \
#MM  ports-office-muibase-envpackage


#MM
ports-office-muibase-envpackage :
	$(ECHO) "Extras:Office/MUIbase" >$(AROS_PACKAGES)/MUIbase



ports-office-muibase-startupfiles_SRC := $(shell $(ECHO) . | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(AROS_CONTRIB)/Office/MUIbase/S
else
setup :: $(AROS_CONTRIB)/Office/MUIbase/S
endif

GLOB_MKDIRS += $(AROS_CONTRIB)/Office/MUIbase/S


.PHONY : ports-office-muibase-startupfiles

#MM
ports-office-muibase-startupfiles : | $(AROS_CONTRIB)/Office/MUIbase/S 
	$(foreach file, $(FILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(ports-office-muibase-startupfiles_SRC)),$(ports-office-muibase-startupfiles_SRC),$(SRCDIR)/$(CURDIR)/$(ports-office-muibase-startupfiles_SRC))/, $(file)) $(addprefix $(AROS_CONTRIB)/Office/MUIbase/S/, $(file))))


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
