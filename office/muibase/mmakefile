ifeq (yes,yes)
    ports-office-muibase-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-office-muibase-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-office-muibase-link_DEPLIBS := $(foreach lib,$(ports-office-muibase-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-office-muibase-link_DIRS)))) \
)

