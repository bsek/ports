define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-office-muibase_CXXCMD) $(ports-office-muibase_CXXIQUOTE) $(dir $(2)) $(ports-office-muibase_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-office-muibase_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-office-muibase_CXXIQUOTE) . $(ports-office-muibase_CXXIQUOTE_END) $(strip $(ports-office-muibase_CXXFLAGS) $(ports-office-muibase_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-office-muibase_CXXCMD) $(ports-office-muibase_CXXIQUOTE) $(dir $(2)) $(ports-office-muibase_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-office-muibase_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-office-muibase_CXXIQUOTE) . $(ports-office-muibase_CXXIQUOTE_END) $(strip $(ports-office-muibase_CXXFLAGS) $(ports-office-muibase_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
