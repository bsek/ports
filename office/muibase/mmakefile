# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
ports-office-muibase-link_DIRS := $(subst -L ,-L,$(strip $(ports-office-muibase_LDFLAGS)))
# Filter out only the libdirs and remove -L
ports-office-muibase-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ports-office-muibase-link_DIRS)))
# Add trailing /
ports-office-muibase-link_DIRS := $(subst //,/,$(addsuffix /,$(ports-office-muibase-link_DIRS)))
