.PHONY: ports-libs-libzip-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-libs-libzip-fetch-location := $(PORTSSOURCEDIR)
else
    ports-libs-libzip-fetch-location := $(PORTSDIR)/libzip
endif

ifneq (,)
    ports-libs-libzip-fetch-baseflag := -b 
else
    ports-libs-libzip-fetch-baseflag :=
endif

ports-libs-libzip-fetch-fetchedflag := $(ports-libs-libzip-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-libs-libzip-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.gz" -l $(ports-libs-libzip-fetch-location) \
	-d $(PORTSDIR)/libzip $(ports-libs-libzip-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(PATCHSPEC)"
	$(Q)$(IF) ! $(TEST) -f $(ports-libs-libzip-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-libs-libzip-fetch-fetchedflag) ; \
	fi


.PHONY: ports-libs-libzip-create-patch

ifneq (,)
    ports-libs-libzip-create-patch-location := 
else
    ports-libs-libzip-create-patch-location := $(PORTSSOURCEDIR)
endif

ifneq (,)
    ports-libs-libzip-create-patch-exclude := -X ./exclude.patterns
endif

ifneq (libzip-$(ARCHBASE),)
    ports-libs-libzip-create-patch-srcdir   := libzip-$(ARCHBASE)
else
    ports-libs-libzip-create-patch-srcdir   := $(ARCHBASE)
endif

ifeq (no,yes)
    ports-libs-libzip-create-patch-diffflag   := --strip-trailing-cr
else
    ports-libs-libzip-create-patch-diffflag   :=
endif

ifneq (,)
    ports-libs-libzip-create-patch-baseflag := -b /tmp
    ports-libs-libzip-create-patch-base := 
else
    ports-libs-libzip-create-patch-baseflag :=
    ports-libs-libzip-create-patch-base := $(PORTSDIR)/libzip
endif

#MM- ports-libs-libzip-create-patch :  ports-libs-libzip-create-patch-diff 
#MM- ports-libs-libzip-create-patch-quick :  ports-libs-libzip-create-patch-diff 

#MM
ports-libs-libzip-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-libs-libzip-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-libs-libzip-create-patch-base)/$(ports-libs-libzip-create-patch-srcdir) $(ports-libs-libzip-create-patch-base)/tmp/$(ports-libs-libzip-create-patch-srcdir).aros ; \
	$(FETCH) -a $(ARCHBASE) -s "tar.bz2 tar.gz" -f -l $(ports-libs-libzip-create-patch-location) -d $(PORTSDIR)/libzip $(ports-libs-libzip-create-patch-baseflag); \
	$(MV) $(ports-libs-libzip-create-patch-base)/$(ports-libs-libzip-create-patch-srcdir) $(ports-libs-libzip-create-patch-base)/tmp/$(ports-libs-libzip-create-patch-srcdir) ; \
	cd $(ports-libs-libzip-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-libs-libzip-create-patch-diffflag) $(ports-libs-libzip-create-patch-exclude) \
	    $(ports-libs-libzip-create-patch-srcdir) \
	    $(ports-libs-libzip-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(ports-libs-libzip-create-patch-base)/tmp/$(ports-libs-libzip-create-patch-srcdir).aros $(ports-libs-libzip-create-patch-base)/$(ports-libs-libzip-create-patch-srcdir) ; \
	$(RM) $(ports-libs-libzip-create-patch-base)/tmp


