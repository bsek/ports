    endif
else
    ports-libs-libzip-cmake-env += PKG_CONFIG_LIBDIR="$(AROS_DEVELOPER)/lib/pkgconfig"
    ports-libs-libzip-cmake-env += PKG_CONFIG_SYSROOT_DIR="$(AROSDIR)"
    ports-libs-libzip-cmake-env += LDFLAGS="$(strip $(TARGET_ISA_LDFLAGS) $(LDFLAGS) )"
    ports-libs-libzip-cmake-env += CFLAGS="$(strip $(CFLAGS) )"
    ports-libs-libzip-cmake-env += CXXFLAGS="$(strip $(CXXFLAGS) )"
    ports-libs-libzip-cmake-env += CPPFLAGS="$(strip $(CPPFLAGS) )"
    ports-libs-libzip-cmake_opts      := -DCMAKE_TOOLCHAIN_FILE=$(GENDIR)/config/conf.cmake -DCMAKE_INSTALL_PREFIX=$(ports-libs-libzip-prefix)
    ifeq (yes,yes)
        ports-libs-libzip-cmake_opts  += -DCMAKE_C_FLAGS="$(strip $(CFLAGS) )"
    endif
    ifeq (yes,yes)
        ports-libs-libzip-cmake_opts  += -DCMAKE_CPP_FLAGS="$(strip $(CPPFLAGS) )"
    endif
    ifeq (yes,yes)
        ports-libs-libzip-cmake_opts      += -DCMAKE_CXX_FLAGS="$(strip $(CXXFLAGS) )"
    endif
    ports-libs-libzip-cmake_opts  += -DCMAKE_EXE_LINKER_FLAGS="$(strip $(TARGET_ISA_LDFLAGS) $(LDFLAGS) )"
    ifeq (,)
        ports-libs-libzip-pkgdir      := $(GENDIR)/$(CURDIR)
    else
        ports-libs-libzip-pkgdir      := $(GENDIR)/$(CURDIR)/
    endif
endif
ifneq (,)
    ifeq (,)
        ports-libs-libzip-pkgdir      := 
    else
