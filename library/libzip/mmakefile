ports-libs-libzip-installflag         ?= $(ports-libs-libzip-pkgdir)/.installed

.PHONY : ports-libs-libzip ports-libs-libzip-clean ports-libs-libzip-build_and_install-quick

#MM- ports-libs-libzip: setup includes core-linklibs ports-libs-libzip-quick

#MM- ports-libs-libzip-quick : ports-libs-libzip-cmake ports-libs-libzip-build_and_install-quick

#MM
ports-libs-libzip-build_and_install-quick :  $(ports-libs-libzip-installflag)

ifeq (,)
ports-libs-libzip-buildargs :=  --build
else
ports-libs-libzip-buildargs :=  
endif

ifeq (,)
ports-libs-libzip-cmakecmdbuild := $(CMAKE) $(ports-libs-libzip-buildargs) $(ports-libs-libzip-pkgdir)
else
ports-libs-libzip-cmakecmdbuild := 
endif

ifeq (,)
ports-libs-libzip-installargs :=  --install
else
ports-libs-libzip-installargs :=  
endif

ifeq (,)
ports-libs-libzip-cmakecmdinstall := $(CMAKE) $(ports-libs-libzip-installargs) $(ports-libs-libzip-pkgdir)
else
ports-libs-libzip-cmakecmdinstall := 
endif

ifeq (,)
ports-libs-libzip-cmakecleandir := $(ports-libs-libzip-pkgdir)
else
ports-libs-libzip-cmakecleandir := 
endif

$(ports-libs-libzip-installflag) : $(ports-libs-libzip-cmakeflag)
	$(Q)$(IF) ! $(MAKE) -q -C $(ports-libs-libzip-pkgdir); then \
	    $(RM) $(ports-libs-libzip-installflag) && \
	    $(ports-libs-libzip-cmakecmdbuild) && \
	    cd $(ports-libs-libzip-pkgdir) && \
	    $(ports-libs-libzip-cmakecmdinstall) && \
	    $(TOUCH) $@ -r $^; \
	    $(IF) $(TEST) "no" = "yes"; then \
	        $(IF) ! $(MAKE) -C $(ports-libs-libzip-pkgdir) clean; then \
	            $(RM) -r $(ports-libs-libzip-cmakecleandir); \
	        fi; \
	    fi; \
	fi

## **********************************************************************
## Review the following lines once breakage in contrib has been resolved.
# Files are not touched anymore by default, add this to your mmakefile if that is necessry
#<target>-touchfileflag := $(GENDIR)/$(CURDIR)/.files-touched
ports-libs-libzip-touchfileflag ?= $(ports-libs-libzip-pkgdir)/.files-touched
## **********************************************************************
ifeq (yes,yes)
$(ports-libs-libzip-touchfileflag):
	$(Q)$(FOR) dir in $(ports-libs-libzip-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(PORTSDIR)/libzip/libzip-$(ARCHBASE) -exec $(TOUCH) -c -r $(PORTSDIR)/libzip/libzip-$(ARCHBASE)/CMakeLists.txt '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-libs-libzip-cmake :  $(ports-libs-libzip-cmakeflag) 

$(ports-libs-libzip-cmakeflag) : TMP_SRCDIR := $(shell $(ECHO) $(PORTSDIR)/libzip/libzip-$(ARCHBASE) | sed 's/^\(.\):\//\/\1\//')
$(ports-libs-libzip-cmakeflag) : $(ports-libs-libzip-touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(RM) $@
	$(Q)$(FOR) dir in $(ports-libs-libzip-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)cd $(ports-libs-libzip-pkgdir) && \
	$(RM) -Rf CMakeCache.txt CMakeFiles \; && \
	$(ports-libs-libzip-cmake-env) $(CMAKE) $(ports-libs-libzip-cmake_opts) $(LIBZIP_OPTIONS) $(TMP_SRCDIR) && \
	$(TOUCH) $@

#MM
ports-libs-libzip-clean : ports-libs-libzip-uninstall
	$(Q)$(RM) $(ports-libs-libzip-pkgdir)

# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

