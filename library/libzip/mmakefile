        ports-libs-libzip-cmake_opts      += -DCMAKE_C_COMPILER="$(strip $(subst $(CC_PREFIX),,$(HOST_DEF_CC)))"
    else
        ports-libs-libzip-cmake_opts      += -DCMAKE_C_COMPILER="$(strip $(HOST_DEF_CC))"
    endif
    ifeq (yes,yes)
        ports-libs-libzip-cmake_opts  += -DCMAKE_C_FLAGS="$(strip $(HOST_CFLAGS) -I$(CROSSTOOLSDIR)/include )"
    endif
    ifeq (yes,yes)
        ports-libs-libzip-cmake_opts  += -DCMAKE_CPP_FLAGS="$(strip $(HOST_CPPFLAGS) )"
    endif
    ifneq ($(CC_PREFIX),)
        ports-libs-libzip-cmake_opts      += -DCMAKE_CXX_COMPILER="$(strip $(subst $(CC_PREFIX),,$(HOST_CXX)))"
    else
        ports-libs-libzip-cmake_opts      += -DCMAKE_CXX_COMPILER="$(strip $(HOST_CXX))"
    endif
    ifeq (yes,yes)
        ports-libs-libzip-cmake_opts  += -DCMAKE_CXX_FLAGS="$(strip $(HOST_CXXFLAGS) -I$(CROSSTOOLSDIR)/include )"
    endif
    ifeq (,)
        ports-libs-libzip-pkgdir      := $(HOSTGENDIR)/$(CURDIR)
    else
