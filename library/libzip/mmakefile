    ports-libs-libzip-cmake-env += LDFLAGS="$(HOST_LDFLAGS) -L$(CROSSTOOLSDIR)/lib $(USER_LDFLAGS) "
    ports-libs-libzip-cmake-env += CFLAGS="$(HOST_CFLAGS) -I$(CROSSTOOLSDIR)/include "
    ports-libs-libzip-cmake-env += CXXFLAGS="$(HOST_CXXFLAGS) -I$(CROSSTOOLSDIR)/include "
    ports-libs-libzip-cmake-env += CPPFLAGS="$(HOST_CPPFLAGS) "
