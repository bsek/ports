define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-libs-glew_CXXCMD) $(ports-libs-glew_CXXIQUOTE) $(dir $(2)) $(ports-libs-glew_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-libs-glew_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-libs-glew_CXXIQUOTE) . $(ports-libs-glew_CXXIQUOTE_END) $(strip $(ports-libs-glew_CXXFLAGS) $(ports-libs-glew_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-libs-glew_CXXCMD) $(ports-libs-glew_CXXIQUOTE) $(dir $(2)) $(ports-libs-glew_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-libs-glew_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-libs-glew_CXXIQUOTE) . $(ports-libs-glew_CXXIQUOTE_END) $(strip $(ports-libs-glew_CXXFLAGS) $(ports-libs-glew_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-libs-glew_CXXCMD) $(ports-libs-glew_CXXIQUOTE) $(dir $(2)) $(ports-libs-glew_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-libs-glew_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-libs-glew_CXXIQUOTE) . $(ports-libs-glew_CXXIQUOTE_END) $(strip $(ports-libs-glew_CXXFLAGS) $(ports-libs-glew_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-libs-glew_CXXCMD)" $(MKDEPEND) $(strip $(ports-libs-glew_DXXFLAGS) $(ports-libs-glew_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-libs-glew_OBJDIR),)
