else
  $(foreach ports-libs-glew_CXXFILE,$(ports-libs-glew_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-libs-glew_OBJDIR)/,$(notdir $(basename $(ports-libs-glew_CXXFILE)))),$(ports-libs-glew_CXXFILE))))
