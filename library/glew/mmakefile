.PHONY: ports-libs-glew-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-libs-glew-fetch-location := $(PORTSSOURCEDIR)
else
    ports-libs-glew-fetch-location := $(PORTSDIR)/glew
endif

ifneq (,)
    ports-libs-glew-fetch-baseflag := -b 
else
    ports-libs-glew-fetch-baseflag :=
endif

ports-libs-glew-fetch-fetchedflag := $(ports-libs-glew-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-libs-glew-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tgz" -l $(ports-libs-glew-fetch-location) \
	-d $(PORTSDIR)/glew $(ports-libs-glew-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(PATCHSPEC)"
	$(Q)$(IF) ! $(TEST) -f $(ports-libs-glew-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-libs-glew-fetch-fetchedflag) ; \
	fi


