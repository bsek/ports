#MM- ports-libs-glew-create-patch :  ports-libs-glew-create-patch-diff 
#MM- ports-libs-glew-create-patch-quick :  ports-libs-glew-create-patch-diff 

#MM
ports-libs-glew-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-libs-glew-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-libs-glew-create-patch-base)/$(ports-libs-glew-create-patch-srcdir) $(ports-libs-glew-create-patch-base)/tmp/$(ports-libs-glew-create-patch-srcdir).aros ; \
	$(FETCH) -a $(ARCHBASE) -s "tgz" -f -l $(ports-libs-glew-create-patch-location) -d $(PORTSDIR)/glew $(ports-libs-glew-create-patch-baseflag); \
	$(MV) $(ports-libs-glew-create-patch-base)/$(ports-libs-glew-create-patch-srcdir) $(ports-libs-glew-create-patch-base)/tmp/$(ports-libs-glew-create-patch-srcdir) ; \
	cd $(ports-libs-glew-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-libs-glew-create-patch-diffflag) $(ports-libs-glew-create-patch-exclude) \
	    $(ports-libs-glew-create-patch-srcdir) \
	    $(ports-libs-glew-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(ports-libs-glew-create-patch-base)/tmp/$(ports-libs-glew-create-patch-srcdir).aros $(ports-libs-glew-create-patch-base)/$(ports-libs-glew-create-patch-srcdir) ; \
	$(RM) $(ports-libs-glew-create-patch-base)/tmp


