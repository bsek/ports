ports-libs-libmpeg-build_and_install-quick :  $(ports-libs-libmpeg-installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(ports-libs-libmpeg-installflag) : $(ports-libs-libmpeg-configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-libs-libmpeg-volfunc, PROGDIR)" -q $(ports-libs-libmpeg-make-env); then \
	    $(RM) $(ports-libs-libmpeg-installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-libs-libmpeg-pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-libs-libmpeg-volfunc, PROGDIR)" $(ports-libs-libmpeg-make-env) && \
	    $(ports-libs-libmpeg-install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(ports-libs-libmpeg-touchfileflag):
	$(Q)$(FOR) dir in $(ports-libs-libmpeg-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(PORTSDIR)/libmpeg2/$(ARCHBASE) -exec $(TOUCH) -c -r $(ports-libs-libmpeg-cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-libs-libmpeg-uninstall :
	$(ports-libs-libmpeg-uninstall_command)

#MM
ports-libs-libmpeg-configure : $(ports-libs-libmpeg-configflag)

$(ports-libs-libmpeg-configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-libs-libmpeg-cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-libs-libmpeg-configflag) : $(ports-libs-libmpeg-touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-libs-libmpeg-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-libs-libmpeg-pkgdir))"
	$(ports-libs-libmpeg-init-env)
	$(Q)cd $(ports-libs-libmpeg-pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-libs-libmpeg-cfg-env) $(TMP_SRCDIR)/configure $(ports-libs-libmpeg-config_opts) $(LIBMPEG_OPTIONS) && \
	$(TOUCH) $@

#MM
ports-libs-libmpeg-clean : ports-libs-libmpeg-uninstall
	$(Q)$(RM) $(ports-libs-libmpeg-pkgdir)

# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
