#MM- ports-libs-libmpeg-create-patch :  ports-libs-libmpeg-create-patch-diff 
#MM- ports-libs-libmpeg-create-patch-quick :  ports-libs-libmpeg-create-patch-diff 

#MM
ports-libs-libmpeg-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-libs-libmpeg-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-libs-libmpeg-create-patch-base)/$(ports-libs-libmpeg-create-patch-srcdir) $(ports-libs-libmpeg-create-patch-base)/tmp/$(ports-libs-libmpeg-create-patch-srcdir).aros ; \
	$(FETCH) -a $(ARCHBASE) -s "tar.bz2 tar.gz" -f -l $(ports-libs-libmpeg-create-patch-location) -d $(PORTSDIR)/libmpeg2 $(ports-libs-libmpeg-create-patch-baseflag); \
	$(MV) $(ports-libs-libmpeg-create-patch-base)/$(ports-libs-libmpeg-create-patch-srcdir) $(ports-libs-libmpeg-create-patch-base)/tmp/$(ports-libs-libmpeg-create-patch-srcdir) ; \
	cd $(ports-libs-libmpeg-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-libs-libmpeg-create-patch-diffflag) $(ports-libs-libmpeg-create-patch-exclude) \
	    $(ports-libs-libmpeg-create-patch-srcdir) \
	    $(ports-libs-libmpeg-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(ports-libs-libmpeg-create-patch-base)/tmp/$(ports-libs-libmpeg-create-patch-srcdir).aros $(ports-libs-libmpeg-create-patch-base)/$(ports-libs-libmpeg-create-patch-srcdir) ; \
	$(RM) $(ports-libs-libmpeg-create-patch-base)/tmp


