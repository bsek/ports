.PHONY: ports-libs-libmpeg-fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-libs-libmpeg-fetch-location := $(PORTSSOURCEDIR)
else
    ports-libs-libmpeg-fetch-location := $(PORTSDIR)/libmpeg2
endif

ifneq (,)
    ports-libs-libmpeg-fetch-baseflag := -b 
else
    ports-libs-libmpeg-fetch-baseflag :=
endif

ports-libs-libmpeg-fetch-fetchedflag := $(ports-libs-libmpeg-fetch-location)/.$(ARCHBASE)-fetched

#MM
ports-libs-libmpeg-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)$(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.gz" -l $(ports-libs-libmpeg-fetch-location) \
	-d $(PORTSDIR)/libmpeg2 $(ports-libs-libmpeg-fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(PATCHSPEC)"
	$(Q)$(IF) ! $(TEST) -f $(ports-libs-libmpeg-fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-libs-libmpeg-fetch-fetchedflag) ; \
	fi


