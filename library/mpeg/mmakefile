ifneq ("$(wildcard $(PORTSDIR)/libmpeg2/$(ARCHBASE)/Makefile)","")
# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(ports-libs-libmpeg-pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(ports-libs-libmpeg-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(ports-libs-libmpeg-pkgdir)))'"
	$(Q)$(CP) -Rf "$(PORTSDIR)/libmpeg2/$(ARCHBASE)/." $(ports-libs-libmpeg-pkgdir)/ && $(TOUCH) $@

$(ports-libs-libmpeg-touchfileflag) : $(ports-libs-libmpeg-pkgdir)/.local-copy

    ports-libs-libmpeg-cfg-srcdir=$(ports-libs-libmpeg-pkgdir)
else
    ports-libs-libmpeg-cfg-srcdir=$(PORTSDIR)/libmpeg2/$(ARCHBASE)
endif
ports-libs-libmpeg-make-env += -C $(ports-libs-libmpeg-pkgdir)

.PHONY : ports-libs-libmpeg ports-libs-libmpeg-clean ports-libs-libmpeg-build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-libs-libmpeg-host : setup includes ports-libs-libmpeg-quick
#MM- ports-libs-libmpeg-target : setup includes core-linklibs ports-libs-libmpeg-quick
#MM- ports-libs-libmpeg: ports-libs-libmpeg-target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    ports-libs-libmpeg-install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-libs-libmpeg-pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-libs-libmpeg-PROGDIR)/" $(ports-libs-libmpeg-install_opts) \
        $(ports-libs-libmpeg-make-env) install -j1

    ports-libs-libmpeg-uninstall_command = \
    $(RM) $(ports-libs-libmpeg-installflag) && \
    $(MAKE) PROGDIR="$(ports-libs-libmpeg-PROGDIR)/" \
    $(ports-libs-libmpeg-install_opts) $(ports-libs-libmpeg-make-env) uninstall
else
    ports-libs-libmpeg-install_command   := true
    ports-libs-libmpeg-uninstall_command := true
endif

