		$(ECHO) "Link failed: $(ports-devel-bwbasic_LINK) $(strip $(ports-devel-bwbasic_LD_OPTS) $(ports-devel-bwbasic-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-devel-bwbasic_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-devel-bwbasic_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-devel-bwbasic_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-devel-bwbasic_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-devel-bwbasic_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-devel-bwbasic_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

