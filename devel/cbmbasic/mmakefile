  $(ports-devel-cbmbasic_MOBJC_TARGETS) $(ports-devel-cbmbasic_MOBJC_DTARGETS) : | $(addsuffix .m,$(ports-devel-cbmbasic_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  ports-devel-cbmbasic_MOBJC_SRCDIR := $(shell $(ECHO) $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  ports-devel-cbmbasic_MOBJC_BASEDIRS := $(shell $(ECHO) $(sort $(dir $(ports-devel-cbmbasic_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  ports-devel-cbmbasic_MOBJC_DIRS := $(foreach dir, $(ports-devel-cbmbasic_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(ports-devel-cbmbasic_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(ports-devel-cbmbasic_MOBJC_DIRS),)
    ports-devel-cbmbasic_MOBJC_DIRS := $(shell $(ECHO) $(ports-devel-cbmbasic_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(ports-devel-cbmbasic_MOBJC_DIRS)
  endif
endif

