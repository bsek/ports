$(ports-devel-cbmbasic_TARGETDIR)/$(ports-devel-cbmbasic_PROGNAME) : $(ports-devel-cbmbasic_OBJS) $(ports-devel-cbmbasic_ARCHOBJS) $(USER_OBJS) $(ports-devel-cbmbasic-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-devel-cbmbasic_LINK) $(strip $(ports-devel-cbmbasic_LD_OPTS) $(ports-devel-cbmbasic-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-devel-cbmbasic_LINK) $(strip $(ports-devel-cbmbasic_LD_OPTS) $(ports-devel-cbmbasic-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-devel-cbmbasic_LINK) $(strip $(ports-devel-cbmbasic_LD_OPTS) $(ports-devel-cbmbasic-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-devel-cbmbasic_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-devel-cbmbasic_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-devel-cbmbasic_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-devel-cbmbasic_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-devel-cbmbasic_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-devel-cbmbasic_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-devel-cbmbasic_DEPS),)
  ifneq (ports-devel-cbmbasic ports-devel-cbmbasic-quick,)
    ifneq ($(findstring $(TARGET),ports-devel-cbmbasic ports-devel-cbmbasic-quick),)
      -include $(ports-devel-cbmbasic_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-devel-cbmbasic_DEPS)
    endif
  endif
endif


ifneq ($(ports-devel-cbmbasic_OBJS) $(ports-devel-cbmbasic_DEPS) $(ports-devel-cbmbasic_TARGETDIR)/$(ports-devel-cbmbasic_PROGNAME),)
$(ports-devel-cbmbasic_OBJS) $(ports-devel-cbmbasic_DEPS) $(ports-devel-cbmbasic_TARGETDIR)/$(ports-devel-cbmbasic_PROGNAME) : | $(ports-devel-cbmbasic_OBJDIR) $(ports-devel-cbmbasic_TARGETDIR)
