ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  ports-devel-cbmbasic_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(KERNEL_ISA_LDFLAGS))
  ports-devel-cbmbasic_LD_OPTS ?= $(KERNEL_ISA_LDFLAGS)
  ports-devel-cbmbasic_CXXLDFLAGS = $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
ifneq ($(TARGET_CXX_LIBS),)
  ports-devel-cbmbasic_ARCHLIBS += $(KERNEL_CXX_LIBS)
endif
  ports-devel-cbmbasic_LDFLAGS ?= $(ports-devel-cbmbasic_CXXLDFLAGS)
  ports-devel-cbmbasic_STRIP ?= $(ECHO) >/dev/null
  ports-devel-cbmbasic_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  ports-devel-cbmbasic_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  ports-devel-cbmbasic_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(ports-devel-cbmbasic_MCXX_CPPFLAGS) $(ports-devel-cbmbasic_MCXX_EXTRA_CPPFLAGS))
  ports-devel-cbmbasic_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-devel-cbmbasic_CXXFLAGS))
  ports-devel-cbmbasic_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ports-devel-cbmbasic_DXXFLAGS))
  ports-devel-cbmbasic_CXXIQUOTE:=$(KERNEL_IQUOTE)
  ports-devel-cbmbasic_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-devel-cbmbasic_CXXCMD) $(ports-devel-cbmbasic_CXXIQUOTE) $(dir $(2)) $(ports-devel-cbmbasic_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-devel-cbmbasic_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-devel-cbmbasic_CXXIQUOTE) . $(ports-devel-cbmbasic_CXXIQUOTE_END) $(strip $(ports-devel-cbmbasic_CXXFLAGS) $(ports-devel-cbmbasic_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-devel-cbmbasic_CXXCMD) $(ports-devel-cbmbasic_CXXIQUOTE) $(dir $(2)) $(ports-devel-cbmbasic_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-devel-cbmbasic_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-devel-cbmbasic_CXXIQUOTE) . $(ports-devel-cbmbasic_CXXIQUOTE_END) $(strip $(ports-devel-cbmbasic_CXXFLAGS) $(ports-devel-cbmbasic_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-devel-cbmbasic_CXXCMD) $(ports-devel-cbmbasic_CXXIQUOTE) $(dir $(2)) $(ports-devel-cbmbasic_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-devel-cbmbasic_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-devel-cbmbasic_CXXIQUOTE) . $(ports-devel-cbmbasic_CXXIQUOTE_END) $(strip $(ports-devel-cbmbasic_CXXFLAGS) $(ports-devel-cbmbasic_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-devel-cbmbasic_CXXCMD)" $(MKDEPEND) $(strip $(ports-devel-cbmbasic_DXXFLAGS) $(ports-devel-cbmbasic_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-devel-cbmbasic_OBJDIR),)
  $(foreach ports-devel-cbmbasic_CXXFILE,$(ports-devel-cbmbasic_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-devel-cbmbasic_CXXFILE))),$(ports-devel-cbmbasic_CXXFILE))))
else
  $(foreach ports-devel-cbmbasic_CXXFILE,$(ports-devel-cbmbasic_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-devel-cbmbasic_OBJDIR)/,$(notdir $(basename $(ports-devel-cbmbasic_CXXFILE)))),$(ports-devel-cbmbasic_CXXFILE))))
endif

endif


