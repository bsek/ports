  ports-devel-cbmbasic_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(ports-devel-cbmbasic_MCXX_CPPFLAGS) $(ports-devel-cbmbasic_MCXX_EXTRA_CPPFLAGS))
  ports-devel-cbmbasic_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(ports-devel-cbmbasic_CXXFLAGS))
