#MM- ports-devel-cbmbasic-create-patch :  ports-devel-cbmbasic-create-patch-diff 
#MM- ports-devel-cbmbasic-create-patch-quick :  ports-devel-cbmbasic-create-patch-diff 

#MM
ports-devel-cbmbasic-create-patch-diff:
	$(Q)$(FOR) dir in $(ports-devel-cbmbasic-create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-devel-cbmbasic-create-patch-base)/$(ports-devel-cbmbasic-create-patch-srcdir) $(ports-devel-cbmbasic-create-patch-base)/tmp/$(ports-devel-cbmbasic-create-patch-srcdir).aros ; \
	$(FETCH) -a $(ARCHBASE) -s "tgz" -f -l $(ports-devel-cbmbasic-create-patch-location) -d $(PORTSDIR)/cbmbasic $(ports-devel-cbmbasic-create-patch-baseflag); \
	$(MV) $(ports-devel-cbmbasic-create-patch-base)/$(ports-devel-cbmbasic-create-patch-srcdir) $(ports-devel-cbmbasic-create-patch-base)/tmp/$(ports-devel-cbmbasic-create-patch-srcdir) ; \
	cd $(ports-devel-cbmbasic-create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-devel-cbmbasic-create-patch-diffflag) $(ports-devel-cbmbasic-create-patch-exclude) \
	    $(ports-devel-cbmbasic-create-patch-srcdir) \
	    $(ports-devel-cbmbasic-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(ports-devel-cbmbasic-create-patch-base)/tmp/$(ports-devel-cbmbasic-create-patch-srcdir).aros $(ports-devel-cbmbasic-create-patch-base)/$(ports-devel-cbmbasic-create-patch-srcdir) ; \
	$(RM) $(ports-devel-cbmbasic-create-patch-base)/tmp


