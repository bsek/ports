  ports-devel-cbmbasic_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(ports-devel-cbmbasic_OBJDIR)/,$(ports-devel-cbmbasic_OBJC_NARCHFILES)))
  ports-devel-cbmbasic_MOBJC_WILDCARD := $(ports-devel-cbmbasic_OBJDIR)/%

