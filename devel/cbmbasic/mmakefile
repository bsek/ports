ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  ports-devel-cbmbasic_LINK ?= $(strip $(ports-devel-cbmbasic_CC) $(TARGET_SYSROOT))
