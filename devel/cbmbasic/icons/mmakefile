include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-devel-cbmbasic : ports-devel-cbmbasic-icons

TARGETDIR := $(AROS_CONTRIB)/$(AROS_DIR_DEVELOPER)
ICONS     := CBMBasic


BD_OBJS := $(addprefix  $(TARGETDIR)/, $(addsuffix .info,$(ICONS)))

#MM
ports-devel-cbmbasic-icons : $(BD_OBJS)

ifeq (,)

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(TARGETDIR)
else
$(BD_OBJS) :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


ports-devel-cbmbasic-icons-clean : FILES := $(BD_OBJS)
#MM
ports-devel-cbmbasic-icons-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: ports-devel-cbmbasic-icons ports-devel-cbmbasic-icons-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
