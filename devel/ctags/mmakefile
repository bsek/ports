        LDFLAGS_FOR_HOST="$(strip $(ports-devel-ctags--CROSS_LDFLAGS))"
else
    ports-devel-ctags--cfg-env += CPP="$(strip $(TARGET_CPP) $(TARGET_SYSROOT))" \
