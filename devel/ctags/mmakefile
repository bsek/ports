    ports-devel-ctags--cfg-env += CC_FOR_TARGET="$(strip $(ports-devel-ctags--TARGET_CC) $(TARGET_SYSROOT))" \
        CFLAGS_FOR_TARGET="$(strip $(ports-devel-ctags--TARGET_CFLAGS) $(ports-devel-ctags--ACTARGET_CFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS))" \
