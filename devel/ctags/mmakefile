        CXXFLAGS_FOR_HOST="$(strip $(KERNEL_ISA_CFLAGS) $(USER_INCLUDES) $(BASE_CXXFLAGS) $(ports-devel-ctags--ACHOST_CXXFLAGS)  $(USER_CXXFLAGS) -L$(AROS_DEVELOPER)/lib $(OPTIMIZATION_CFLAGS) $(ports-devel-ctags--nix))" \
        LD_FOR_HOST="$(strip $(TARGET_LD))" \
        LDFLAGS_FOR_HOST="$(strip $(TARGET_ISA_LDFLAGS) -L$(AROS_DEVELOPER)/lib  $(ports-devel-ctags--ACHOST_LDFLAGS) $(USER_LDFLAGS) $(ports-devel-ctags--nix) $(ports-devel-ctags--s_flag))"
ifeq (yes,yes)
    ports-devel-ctags--cfg-env += CPPFLAGS_FOR_TARGET="$(strip $(BASE_CPPFLAGS) $(ports-devel-ctags--ACTARGET_CPPFLAGS) $(USER_CPPFLAGS) )"
