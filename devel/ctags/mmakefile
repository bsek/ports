        CXX_FOR_HOST="$(strip $(ports-devel-ctags--CROSS_CXX) $(ports-devel-ctags--CROSS_SYSROOT))" \
        CXXFLAGS_FOR_HOST="$(strip $(ports-devel-ctags--CROSS_CXXFLAGS))" \
