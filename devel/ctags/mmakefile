        CXXFLAGS="$(strip $(ports-devel-ctags--CROSS_CXXFLAGS))" \
        LDFLAGS="$(strip $(ports-devel-ctags--CROSS_LDFLAGS))" \
        LT_LDFLAGS="$(strip $(ports-devel-ctags--CROSS_LDFLAGS))"
    ports-devel-ctags--cfg-env += CC_FOR_HOST="$(strip $(ports-devel-ctags--CROSS_CC) $(ports-devel-ctags--CROSS_SYSROOT))" \
