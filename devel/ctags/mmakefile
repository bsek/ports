## **********************************************************************
## Review the following lines once breakage in contrib has been resolved.
# Files are not touched anymore by default, add this to your mmakefile if that is necessry
#<target>-touchfileflag := $(GENDIR)/$(CURDIR)/.files-touched
ports-devel-ctags--touchfileflag ?= $(ports-devel-ctags--pkgdir)/.files-touched
## **********************************************************************

ifneq ("$(wildcard $(ports-devel-ctags-portdir)/$(ports-devel-ctags--builddir)/Makefile)","")
# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(ports-devel-ctags--pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(ports-devel-ctags--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(ports-devel-ctags--pkgdir)))'"
	$(Q)$(CP) -Rf "$(ports-devel-ctags-portdir)/$(ports-devel-ctags--builddir)/." $(ports-devel-ctags--pkgdir)/ && $(TOUCH) $@

$(ports-devel-ctags--touchfileflag) : $(ports-devel-ctags--pkgdir)/.local-copy

    ports-devel-ctags--cfg-srcdir=$(ports-devel-ctags--pkgdir)
else
    ports-devel-ctags--cfg-srcdir=$(ports-devel-ctags-portdir)/$(ports-devel-ctags--builddir)
endif
ports-devel-ctags--make-env += -C $(ports-devel-ctags--pkgdir)

.PHONY : ports-devel-ctags- ports-devel-ctags--clean ports-devel-ctags--build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- ports-devel-ctags--host : setup includes ports-devel-ctags--quick
#MM- ports-devel-ctags--target : setup includes core-linklibs ports-devel-ctags--quick
#MM- ports-devel-ctags-: ports-devel-ctags--target

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    ports-devel-ctags--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(ports-devel-ctags--pkgdir))" && \
        $(MAKE) PROGDIR="$(ports-devel-ctags--PROGDIR)/" $(ports-devel-ctags--install_opts) \
        $(ports-devel-ctags--make-env) install -j1

    ports-devel-ctags--uninstall_command = \
    $(RM) $(ports-devel-ctags--installflag) && \
    $(MAKE) PROGDIR="$(ports-devel-ctags--PROGDIR)/" \
    $(ports-devel-ctags--install_opts) $(ports-devel-ctags--make-env) uninstall
else
    ports-devel-ctags--install_command   := true
    ports-devel-ctags--uninstall_command := true
endif

#MM- ports-devel-ctags--quick :  ports-devel-ctags--configure  ports-devel-ctags--build_and_install-quick ports-devel-ctags--make-package

#MM
ports-devel-ctags--build_and_install-quick :  $(ports-devel-ctags--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(ports-devel-ctags--installflag) : $(ports-devel-ctags--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-devel-ctags--volfunc, PROGDIR)" -q $(ports-devel-ctags--make-env); then \
	    $(RM) $(ports-devel-ctags--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(ports-devel-ctags--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call ports-devel-ctags--volfunc, PROGDIR)" $(ports-devel-ctags--make-env) && \
	    $(ports-devel-ctags--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifeq (yes,yes)
$(ports-devel-ctags--touchfileflag):
	$(Q)$(FOR) dir in $(ports-devel-ctags--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(ports-devel-ctags-portdir)/$(ports-devel-ctags--builddir) -exec $(TOUCH) -c -r $(ports-devel-ctags--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
ports-devel-ctags--uninstall :
	$(ports-devel-ctags--uninstall_command)

#MM
ports-devel-ctags--configure : $(ports-devel-ctags--configflag)

$(ports-devel-ctags--configflag) : TMP_SRCDIR := $(shell $(ECHO) $(ports-devel-ctags--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(ports-devel-ctags--configflag) : $(ports-devel-ctags--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(ports-devel-ctags--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(ports-devel-ctags--pkgdir))"
	$(ports-devel-ctags--init-env)
	$(Q)cd $(ports-devel-ctags--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(ports-devel-ctags--cfg-env) $(TMP_SRCDIR)/configure $(ports-devel-ctags--config_opts) $(CTAGS_OPTIONS) && \
	$(TOUCH) $@

#MM
ports-devel-ctags--clean : ports-devel-ctags--uninstall
	$(Q)$(RM) $(ports-devel-ctags--pkgdir)

.PHONY : ports-devel-ctags--make-package ports-devel-ctags--create-patch
#MM ports-devel-ctags--make-package : ports-devel-ctags--quick

#MM
ports-devel-ctags--make-package : $(ports-devel-ctags--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(ports-devel-ctags--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(ports-devel-ctags-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(ports-devel-ctags--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(ports-devel-ctags-prefix)" ; \
	    cd $(ports-devel-ctags--package-dir) ; \
	    tar -cvf $(ports-devel-ctags--package-basename).tar * ; \
	    bzip2 -9 -f $(ports-devel-ctags--package-basename).tar ; \
	fi

#MM
ports-devel-ctags-clean :
	$(RM) $(TARGETDIR)
	$(RM) $(GENDIR)/$(CURDIR)


