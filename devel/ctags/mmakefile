        CXXCPP="$(strip $(ports-devel-ctags--CROSS_CPP) $(ports-devel-ctags--CROSS_SYSROOT))" \
        CC="$(strip $(ports-devel-ctags--CROSS_CC) $(ports-devel-ctags--CROSS_SYSROOT))" \
        CXX="$(strip $(ports-devel-ctags--CROSS_CXX) $(ports-devel-ctags--CROSS_SYSROOT))" \
