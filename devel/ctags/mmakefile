    ifeq ($(CURDIR),)
        ports-devel-ctags--pkgbasedir := $(HOSTGENDIR)
    else
        ports-devel-ctags--pkgbasedir := $(HOSTGENDIR)/$(CURDIR)
    endif
else
    host := no
    ifeq ($(CURDIR),)
        ports-devel-ctags--pkgbasedir := $(GENDIR)
    else
        ports-devel-ctags--pkgbasedir := $(GENDIR)/$(CURDIR)
    endif
endif
ifneq (,)
    ifeq ($(CURDIR),)
        ports-devel-ctags--pkgbasedir := 
    else
        ports-devel-ctags--pkgbasedir := /$(CURDIR)
    endif
