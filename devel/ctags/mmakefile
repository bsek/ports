# $Id$

include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-devel : ports-devel-ctags

PACKAGE      := ctags
VERSION      := 5.8
TARGETDIR    := $(AROS_CONTRIB)/$(AROS_DIR_DEVELOPER)/Ctags
REPOSITORIES := sf://ctags
CTAGS_OPTIONS=\
        --enable-shell-globbing=no \
        --disable-external-sort
# ctags ignores CPPFLAGS, so push them in CFLAGS
USER_CFLAGS := $(CFLAGS_GNU99) -D_GNU_SOURCE -DAMIGA -DAROS_SAFE_HEADERINLINE


#MM- ports-devel-ctags-quick : ports-devel-ctags--quick
#MM- ports-devel-ctags--quick : ports-devel-ctags--fetch
#MM- ports-devel-ctags-fetch : ports-devel-ctags--fetch
#MM- ports-devel-ctags-create-patch : ports-devel-ctags--create-patch
#MM- ports-devel-ctags-create-patch-quick : ports-devel-ctags--create-patch
 
ports-devel-ctags-archbase                        ?= $(PACKAGE)-$(VERSION)

ifeq (target,host)
    ports-devel-ctags-portdir                     ?= $(HOSTDIR)/Ports/host/$(PACKAGE)
else
    ports-devel-ctags-portdir                     ?= $(PORTSDIR)/$(PACKAGE)
endif

ifeq ($(TARGETDIR),)
    ports-devel-ctags-prefix                      ?= $(CONTRIB_DIR)/$(PACKAGE)
else
    ports-devel-ctags-prefix                      ?= $(TARGETDIR)
endif

ifneq (,)
    ports-devel-ctags--archbase      ?= $(PACKAGE)--$(VERSION)
else
    ports-devel-ctags--archbase      ?= $(PACKAGE)-$(VERSION)
endif

ifneq (,)
    ports-devel-ctags--srcdir        ?= 
else
    ports-devel-ctags--srcdir        ?= $(ports-devel-ctags-archbase)
endif

ifneq (,)
    ports-devel-ctags--builddir      ?= $(ports-devel-ctags--srcdir)/
else
    ports-devel-ctags--builddir      ?= $(ports-devel-ctags--srcdir)
endif

ifeq (,)
ifeq (yes,yes)
    ports-devel-ctags--patches_specs ?= $(ports-devel-ctags--archbase)-aros.diff:$(ports-devel-ctags--srcdir):-f,-p1
else
    ports-devel-ctags--patches_specs ?= ::
endif
else
    ports-devel-ctags--patches_specs ?= 
endif


.PHONY: ports-devel-ctags--fetch

ifneq ($(PORTSSOURCEDIR),)
    ports-devel-ctags--fetch-location := $(PORTSSOURCEDIR)
else
    ports-devel-ctags--fetch-location := $(ports-devel-ctags-portdir)
endif

ifneq (,)
    ports-devel-ctags--fetch-baseflag := -b 
else
    ports-devel-ctags--fetch-baseflag :=
endif

ports-devel-ctags--fetch-fetchedflag := $(ports-devel-ctags--fetch-location)/.$(ports-devel-ctags--archbase)-fetched

#MM
ports-devel-ctags--fetch :
	$(Q)$(ECHO) "Fetching   $(ports-devel-ctags--archbase) ..."
	$(Q)$(FETCH) -ao ". $(REPOSITORIES)" -a $(ports-devel-ctags--archbase) -s "tar.gz" -l $(ports-devel-ctags--fetch-location) \
	-d $(ports-devel-ctags-portdir) $(ports-devel-ctags--fetch-baseflag) -po "$(SRCDIR)/$(CURDIR)" -p "$(ports-devel-ctags--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(ports-devel-ctags--fetch-fetchedflag) ; then \
		 $(TOUCH) $(ports-devel-ctags--fetch-fetchedflag) ; \
	fi


.PHONY: ports-devel-ctags--create-patch

ifneq (,)
    ports-devel-ctags--create-patch-location := 
else
    ports-devel-ctags--create-patch-location := $(PORTSSOURCEDIR)
endif

ifneq (,)
    ports-devel-ctags--create-patch-exclude := -X ./exclude.patterns
endif

ifneq ($(ports-devel-ctags--srcdir),)
    ports-devel-ctags--create-patch-srcdir   := $(ports-devel-ctags--srcdir)
else
    ports-devel-ctags--create-patch-srcdir   := $(ports-devel-ctags--archbase)
endif

ifeq (no,yes)
    ports-devel-ctags--create-patch-diffflag   := --strip-trailing-cr
else
    ports-devel-ctags--create-patch-diffflag   :=
endif

ifneq (,)
    ports-devel-ctags--create-patch-baseflag := -b /tmp
    ports-devel-ctags--create-patch-base := 
else
    ports-devel-ctags--create-patch-baseflag :=
    ports-devel-ctags--create-patch-base := $(ports-devel-ctags-portdir)
endif

#MM- ports-devel-ctags--create-patch :  ports-devel-ctags--create-patch-diff 
#MM- ports-devel-ctags--create-patch-quick :  ports-devel-ctags--create-patch-diff 

#MM
ports-devel-ctags--create-patch-diff:
	$(Q)$(FOR) dir in $(ports-devel-ctags--create-patch-base)/tmp ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(MV) $(ports-devel-ctags--create-patch-base)/$(ports-devel-ctags--create-patch-srcdir) $(ports-devel-ctags--create-patch-base)/tmp/$(ports-devel-ctags--create-patch-srcdir).aros ; \
	$(FETCH) -a $(ports-devel-ctags--archbase) -s "tar.gz" -f -l $(ports-devel-ctags--create-patch-location) -d $(ports-devel-ctags-portdir) $(ports-devel-ctags--create-patch-baseflag); \
	$(MV) $(ports-devel-ctags--create-patch-base)/$(ports-devel-ctags--create-patch-srcdir) $(ports-devel-ctags--create-patch-base)/tmp/$(ports-devel-ctags--create-patch-srcdir) ; \
	cd $(ports-devel-ctags--create-patch-base)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ports-devel-ctags--archbase)-aros-new.diff'" ; \
	TZ="UTC" diff -ruN $(ports-devel-ctags--create-patch-diffflag) $(ports-devel-ctags--create-patch-exclude) \
	    $(ports-devel-ctags--create-patch-srcdir) \
	    $(ports-devel-ctags--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ports-devel-ctags--archbase)-aros-new.diff ; \
	$(MV) $(ports-devel-ctags--create-patch-base)/tmp/$(ports-devel-ctags--create-patch-srcdir).aros $(ports-devel-ctags--create-patch-base)/$(ports-devel-ctags--create-patch-srcdir) ; \
	$(RM) $(ports-devel-ctags--create-patch-base)/tmp

#MM ports-devel-ctags : ports-devel-ctags-
#MM
ports-devel-ctags:
	$(Q)$(NOP)

ports-devel-ctags--package-dir := $(ports-devel-ctags-portdir)/$(ports-devel-ctags--archbase)

ports-devel-ctags--package-basename := \
    $(DISTDIR)/Packages/$(ports-devel-ctags--archbase)-aros.$(AROS_TARGET_CPU)

