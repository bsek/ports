    # confused configure scripts. We also cannot pass it via _FOR_BUILD
    # since that won't get picked up during configure.
    # We also cannot pass in the compiler including std flags so we need to use
    # the "plain" host compiler.
    ports-devel-ctags--cfg-env :=  \
        CPP="$(HOST_CPP)" \
        CXXCPP="$(HOST_CPP)" \
        CC="$(strip $(ports-devel-ctags--HOST_CC) $(ports-devel-ctags--HOST_CFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        CXX="$(strip $(ports-devel-ctags--HOST_CXX) $(ports-devel-ctags--HOST_CXXFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        LDFLAGS="-L$(CROSSTOOLSDIR)/lib $(USER_LDFLAGS)"
ifeq (yes,yes)
    ports-devel-ctags--cfg-env += TARGET_CPPFLAGS="$(KERNEL_CPPFLAGS)"
endif
    ports-devel-ctags--cfg-env += TARGET_CC="$(strip $(ports-devel-ctags--KERNEL_CC) $(KERNEL_SYSROOT))" \
        TARGET_CFLAGS="$(strip $(ports-devel-ctags--KERNEL_CFLAGS))" \
        TARGET_CXX="$(strip $(ports-devel-ctags--KERNEL_CXX) $(KERNEL_SYSROOT))" \
        TARGET_CXXFLAGS="$(strip $(ports-devel-ctags--KERNEL_CXXFLAGS))" \
        TARGET_AS="$(TARGET_AS)" \
        OBJCOPY="$(OBJCOPY)" \
        TARGET_RANLIB="$(RANLIB)" \
        TARGET_STRIP="$(STRIP_PLAIN)" \
        TARGET_NM="$(NM_PLAIN)" \
        TARGET_OBJCOPY="$(TARGET_OBJCOPY)"
endif

ifeq (target,target)
