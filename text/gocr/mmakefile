				$(ECHO) "$(LINKTARGET): $(ports-text-gocr_LINK) $(strip $(ports-text-gocr_LD_OPTS) $(ports-text-gocr-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-text-gocr_LINK) $(strip $(ports-text-gocr_LD_OPTS) $(ports-text-gocr-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-gocr_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-text-gocr_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-text-gocr_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-text-gocr_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-text-gocr_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-gocr_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-text-gocr_DEPS),)
  ifneq (ports-text-gocr ports-text-gocr-quick,)
    ifneq ($(findstring $(TARGET),ports-text-gocr ports-text-gocr-quick),)
