define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-text-vim-gvim_CXXCMD) $(ports-text-vim-gvim_CXXIQUOTE) $(dir $(2)) $(ports-text-vim-gvim_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-vim-gvim_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-vim-gvim_CXXIQUOTE) . $(ports-text-vim-gvim_CXXIQUOTE_END) $(strip $(ports-text-vim-gvim_CXXFLAGS) $(ports-text-vim-gvim_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-text-vim-gvim_CXXCMD) $(ports-text-vim-gvim_CXXIQUOTE) $(dir $(2)) $(ports-text-vim-gvim_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-vim-gvim_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-vim-gvim_CXXIQUOTE) . $(ports-text-vim-gvim_CXXIQUOTE_END) $(strip $(ports-text-vim-gvim_CXXFLAGS) $(ports-text-vim-gvim_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-text-vim-gvim_CXXCMD) $(ports-text-vim-gvim_CXXIQUOTE) $(dir $(2)) $(ports-text-vim-gvim_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-vim-gvim_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-vim-gvim_CXXIQUOTE) . $(ports-text-vim-gvim_CXXIQUOTE_END) $(strip $(ports-text-vim-gvim_CXXFLAGS) $(ports-text-vim-gvim_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
