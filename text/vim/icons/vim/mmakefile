include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-text-vim-icons : ports-text-vim-icons-vim

ICONS     := gVim  MUI-Vim.guide
TARGETDIR := $(AROS_CONTRIB)/Utilities/Text/Vim


BD_OBJS := $(addprefix  $(TARGETDIR)/, $(addsuffix .info,$(ICONS)))

#MM
ports-text-vim-icons-vim : $(BD_OBJS)

ifeq (,)

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(TARGETDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(TARGETDIR)
else
$(BD_OBJS) :: $(TARGETDIR)
endif

GLOB_MKDIRS += $(TARGETDIR)


ports-text-vim-icons-vim-clean : FILES := $(BD_OBJS)
#MM
ports-text-vim-icons-vim-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: ports-text-vim-icons-vim ports-text-vim-icons-vim-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
