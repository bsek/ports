		$(ECHO) "Link failed: $(ports-text-annotate_LINK) $(strip $(ports-text-annotate_LD_OPTS) $(ports-text-annotate-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-annotate_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-text-annotate_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-text-annotate_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-text-annotate_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-text-annotate_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-annotate_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-text-annotate_DEPS),)
  ifneq (ports-text-annotate ports-text-annotate-quick,)
    ifneq ($(findstring $(TARGET),ports-text-annotate ports-text-annotate-quick),)
      -include $(ports-text-annotate_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-text-annotate_DEPS)
    endif
  endif
endif


ifneq ($(ports-text-annotate_OBJS) $(ports-text-annotate_DEPS) $(ports-text-annotate_TARGETDIR)/$(ports-text-annotate_PROGNAME),)
$(ports-text-annotate_OBJS) $(ports-text-annotate_DEPS) $(ports-text-annotate_TARGETDIR)/$(ports-text-annotate_PROGNAME) : | $(ports-text-annotate_OBJDIR) $(ports-text-annotate_TARGETDIR)
else
$(ports-text-annotate_OBJS) $(ports-text-annotate_DEPS) $(ports-text-annotate_TARGETDIR)/$(ports-text-annotate_PROGNAME) :: $(ports-text-annotate_OBJDIR) $(ports-text-annotate_TARGETDIR)
endif

