	fi


ports-text-polyglotman-link_LD_OPTS := 
ports-text-polyglotman-link_EXTRA_LIBS :=
ifeq (no,yes)
    ports-text-polyglotman-link_LD_OPTS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    ports-text-polyglotman-link_LD_OPTS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    ports-text-polyglotman-link_LD_OPTS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
ports-text-polyglotman-link_DIRS := $(subst -L ,-L,$(strip $(ports-text-polyglotman_LDFLAGS)))
# Filter out only the libdirs and remove -L
ports-text-polyglotman-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ports-text-polyglotman-link_DIRS)))
# Add trailing /
ports-text-polyglotman-link_DIRS := $(subst //,/,$(addsuffix /,$(ports-text-polyglotman-link_DIRS)))
# Add normal linklib path
ports-text-polyglotman-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
ports-text-polyglotman-link_LIBS := $(addprefix lib,$(addsuffix .a,$(ports-text-polyglotman_LIBS) $(ports-text-polyglotman-link_EXTRA_LIBS)))
ifeq (yes,yes)
    ports-text-polyglotman-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-text-polyglotman-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-text-polyglotman-link_DEPLIBS := $(foreach lib,$(ports-text-polyglotman-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-text-polyglotman-link_DIRS)))) \
)

$(ports-text-polyglotman_TARGETDIR)/$(ports-text-polyglotman_PROGNAME) : OBJDIR := $(ports-text-polyglotman_OBJDIR)
