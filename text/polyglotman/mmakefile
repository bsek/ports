$(ports-text-polyglotman_TARGETDIR)/$(ports-text-polyglotman_PROGNAME) : LDFLAGS := $(strip $(ports-text-polyglotman_LDFLAGS))
$(ports-text-polyglotman_TARGETDIR)/$(ports-text-polyglotman_PROGNAME) : LIBS := $(strip $(addprefix -l,$(ports-text-polyglotman_LIBS) $(ports-text-polyglotman-link_EXTRA_LIBS)))
$(ports-text-polyglotman_TARGETDIR)/$(ports-text-polyglotman_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-text-polyglotman_ARCHLIBS))
$(ports-text-polyglotman_TARGETDIR)/$(ports-text-polyglotman_PROGNAME) : $(ports-text-polyglotman_OBJS) $(ports-text-polyglotman_ARCHOBJS) $(USER_OBJS) $(ports-text-polyglotman-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-text-polyglotman_LINK) $(strip $(ports-text-polyglotman_LD_OPTS) $(ports-text-polyglotman-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-text-polyglotman_LINK) $(strip $(ports-text-polyglotman_LD_OPTS) $(ports-text-polyglotman-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-text-polyglotman_LINK) $(strip $(ports-text-polyglotman_LD_OPTS) $(ports-text-polyglotman-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-polyglotman_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-text-polyglotman_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-text-polyglotman_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-text-polyglotman_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-text-polyglotman_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-polyglotman_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

