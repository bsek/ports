			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Assemble failed: $(ports-text-polyglotman-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
