define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-text-polyglotman_CXXCMD) $(ports-text-polyglotman_CXXIQUOTE) $(dir $(2)) $(ports-text-polyglotman_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-polyglotman_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-polyglotman_CXXIQUOTE) . $(ports-text-polyglotman_CXXIQUOTE_END) $(strip $(ports-text-polyglotman_CXXFLAGS) $(ports-text-polyglotman_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-text-polyglotman_CXXCMD) $(ports-text-polyglotman_CXXIQUOTE) $(dir $(2)) $(ports-text-polyglotman_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-polyglotman_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-polyglotman_CXXIQUOTE) . $(ports-text-polyglotman_CXXIQUOTE_END) $(strip $(ports-text-polyglotman_CXXFLAGS) $(ports-text-polyglotman_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-text-polyglotman_CXXCMD) $(ports-text-polyglotman_CXXIQUOTE) $(dir $(2)) $(ports-text-polyglotman_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-polyglotman_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-polyglotman_CXXIQUOTE) . $(ports-text-polyglotman_CXXIQUOTE_END) $(strip $(ports-text-polyglotman_CXXFLAGS) $(ports-text-polyglotman_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-text-polyglotman_CXXCMD)" $(MKDEPEND) $(strip $(ports-text-polyglotman_DXXFLAGS) $(ports-text-polyglotman_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-text-polyglotman_OBJDIR),)
  $(foreach ports-text-polyglotman_CXXFILE,$(ports-text-polyglotman_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-text-polyglotman_CXXFILE))),$(ports-text-polyglotman_CXXFILE))))
else
  $(foreach ports-text-polyglotman_CXXFILE,$(ports-text-polyglotman_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-text-polyglotman_OBJDIR)/,$(notdir $(basename $(ports-text-polyglotman_CXXFILE)))),$(ports-text-polyglotman_CXXFILE))))
endif

