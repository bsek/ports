else
  $(foreach ports-text-scintilla_CXXFILE,$(ports-text-scintilla_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-text-scintilla_OBJDIR)/,$(notdir $(basename $(ports-text-scintilla_CXXFILE)))),$(ports-text-scintilla_CXXFILE))))
