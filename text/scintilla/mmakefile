$(ports-text-scintilla-test_TARGETDIR)/$(ports-text-scintilla-test_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-text-scintilla-test_ARCHLIBS))
$(ports-text-scintilla-test_TARGETDIR)/$(ports-text-scintilla-test_PROGNAME) : $(ports-text-scintilla-test_OBJS) $(ports-text-scintilla-test_ARCHOBJS) $(USER_OBJS) $(ports-text-scintilla-test-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-text-scintilla-test_LINK) $(strip $(ports-text-scintilla-test_LD_OPTS) $(ports-text-scintilla-test-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-text-scintilla-test_LINK) $(strip $(ports-text-scintilla-test_LD_OPTS) $(ports-text-scintilla-test-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-text-scintilla-test_LINK) $(strip $(ports-text-scintilla-test_LD_OPTS) $(ports-text-scintilla-test-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-scintilla-test_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-text-scintilla-test_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-text-scintilla-test_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-text-scintilla-test_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-text-scintilla-test_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-scintilla-test_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-text-scintilla-test_DEPS),)
  ifneq (ports-text-scintilla-test ports-text-scintilla-test-quick,)
    ifneq ($(findstring $(TARGET),ports-text-scintilla-test ports-text-scintilla-test-quick),)
      -include $(ports-text-scintilla-test_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-text-scintilla-test_DEPS)
    endif
  endif
endif


ifneq ($(ports-text-scintilla-test_OBJS) $(ports-text-scintilla-test_DEPS) $(ports-text-scintilla-test_TARGETDIR)/$(ports-text-scintilla-test_PROGNAME),)
$(ports-text-scintilla-test_OBJS) $(ports-text-scintilla-test_DEPS) $(ports-text-scintilla-test_TARGETDIR)/$(ports-text-scintilla-test_PROGNAME) : | $(ports-text-scintilla-test_OBJDIR) $(ports-text-scintilla-test_TARGETDIR)
else
$(ports-text-scintilla-test_OBJS) $(ports-text-scintilla-test_DEPS) $(ports-text-scintilla-test_TARGETDIR)/$(ports-text-scintilla-test_PROGNAME) :: $(ports-text-scintilla-test_OBJDIR) $(ports-text-scintilla-test_TARGETDIR)
endif

GLOB_MKDIRS += $(ports-text-scintilla-test_OBJDIR) $(ports-text-scintilla-test_TARGETDIR)


ports-text-scintilla-test-clean : FILES := $(ports-text-scintilla-test_OBJS) $(ports-text-scintilla-test_TARGETDIR)/$(ports-text-scintilla-test_PROGNAME) $(ports-text-scintilla-test_DEPS)
#MM
ports-text-scintilla-test-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget ports-text-scintilla-test"
	$(Q)$(RM) $(FILES)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

