    $(LEXILLA_DIR)/lexers/LexJulia \
    $(LEXILLA_DIR)/lexers/LexKVIrc \
    $(LEXILLA_DIR)/lexers/LexKix \
    $(LEXILLA_DIR)/lexers/LexLaTeX \
    $(LEXILLA_DIR)/lexers/LexLisp \
    $(LEXILLA_DIR)/lexers/LexLout \
