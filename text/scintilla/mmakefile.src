FILES := $(CORE_FILES) $(AROS_FILES) $(LEXLIB_FILES) $(LEXILLA_SRC_FILES) $(LEXER_FILES)

%build_linklib mmake=ports-text-scintilla \
    libname=Scintilla cxxfiles=$(FILES)

#-----------------------------------------------------------------------
# Lexilla fetch
#-----------------------------------------------------------------------

LEXILLA_REPOSITORIES := https://www.scintilla.org https://github.com/ScintillaOrg/lexilla/releases/download/rel-5-4-3
LEXILLA_ARCHBASE     := lexilla543

%fetch mmake=ports-text-lexilla-fetch archive=$(LEXILLA_ARCHBASE) \
    destination=$(PORTSDIR)/lexilla \
    location=$(PORTSSOURCEDIR) \
    archive_origins=$(LEXILLA_REPOSITORIES) \
    suffixes="tgz"

#-----------------------------------------------------------------------
# Test application
#-----------------------------------------------------------------------

#MM  ports-text-scintilla-test : ports-text-scintilla workbench-libs-zunegfx

TEST_CXXFLAGS := -std=c++17 \
    -fexceptions \
    -I$(SCINTILLA_DIR)/include \
    -I$(SCINTILLA_DIR)/aros \
    -I$(LEXILLA_DIR)/include

TEST_FILES := $(SCINTILLA_DIR)/aros/test

USER_CXXFLAGS := $(TEST_CXXFLAGS)

%build_prog mmake=ports-text-scintilla-test progname=ScintillaTest \
    cxxfiles=$(TEST_FILES) targetdir=$(AROS_TESTS)/Scintilla \
    uselibs="Scintilla zunegfx stdc++"

%common
