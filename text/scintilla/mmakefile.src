include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-text : ports-text-scintilla
#MM  ports-text-scintilla : includes linklibs workbench-libs-zunegfx ports-text-lexilla-fetch

SCINTILLA_DIR := $(SRCDIR)/ports/text/scintilla
LEXILLA_DIR   := $(PORTSDIR)/lexilla/lexilla

USER_CXXFLAGS := -std=c++17 \
    -DPLAT_AROS=1 \
    -DSCI_LEXER \
    -fexceptions \
    -include $(SCINTILLA_DIR)/aros/aros_compat.h \
    -I$(SCINTILLA_DIR)/include \
    -I$(SCINTILLA_DIR)/src \
    -I$(LEXILLA_DIR)/include \
    -I$(LEXILLA_DIR)/lexlib

USER_INCLUDES := \
    -I$(SCINTILLA_DIR)/include \
    -I$(SCINTILLA_DIR)/src \
    -I$(LEXILLA_DIR)/include \
    -I$(LEXILLA_DIR)/lexlib \
    -I$(AROS_INCLUDES)

# Core Scintilla source files (platform-independent)
CORE_FILES := \
    $(SCINTILLA_DIR)/src/AutoComplete \
    $(SCINTILLA_DIR)/src/CallTip \
    $(SCINTILLA_DIR)/src/CaseConvert \
    $(SCINTILLA_DIR)/src/CaseFolder \
    $(SCINTILLA_DIR)/src/CellBuffer \
    $(SCINTILLA_DIR)/src/ChangeHistory \
    $(SCINTILLA_DIR)/src/CharClassify \
    $(SCINTILLA_DIR)/src/CharacterCategoryMap \
    $(SCINTILLA_DIR)/src/CharacterType \
    $(SCINTILLA_DIR)/src/ContractionState \
    $(SCINTILLA_DIR)/src/DBCS \
    $(SCINTILLA_DIR)/src/Decoration \
    $(SCINTILLA_DIR)/src/Document \
    $(SCINTILLA_DIR)/src/EditModel \
    $(SCINTILLA_DIR)/src/EditView \
    $(SCINTILLA_DIR)/src/Editor \
    $(SCINTILLA_DIR)/src/Geometry \
    $(SCINTILLA_DIR)/src/Indicator \
    $(SCINTILLA_DIR)/src/KeyMap \
    $(SCINTILLA_DIR)/src/LineMarker \
    $(SCINTILLA_DIR)/src/MarginView \
    $(SCINTILLA_DIR)/src/PerLine \
    $(SCINTILLA_DIR)/src/PositionCache \
    $(SCINTILLA_DIR)/src/RESearch \
    $(SCINTILLA_DIR)/src/RunStyles \
    $(SCINTILLA_DIR)/src/ScintillaBase \
    $(SCINTILLA_DIR)/src/Selection \
    $(SCINTILLA_DIR)/src/Style \
    $(SCINTILLA_DIR)/src/UndoHistory \
    $(SCINTILLA_DIR)/src/UniConversion \
    $(SCINTILLA_DIR)/src/UniqueString \
    $(SCINTILLA_DIR)/src/ViewStyle \
    $(SCINTILLA_DIR)/src/XPM

# AROS platform-specific files
AROS_FILES := \
    $(SCINTILLA_DIR)/aros/PlatAROS \
    $(SCINTILLA_DIR)/aros/ScintillaAROS

# Lexilla support library (lexlib)
LEXLIB_FILES := \
    $(LEXILLA_DIR)/lexlib/Accessor \
    $(LEXILLA_DIR)/lexlib/CharacterCategory \
    $(LEXILLA_DIR)/lexlib/CharacterSet \
    $(LEXILLA_DIR)/lexlib/DefaultLexer \
    $(LEXILLA_DIR)/lexlib/InList \
    $(LEXILLA_DIR)/lexlib/LexAccessor \
