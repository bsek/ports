    $(LEXILLA_DIR)/lexers/LexMMIXAL \
    $(LEXILLA_DIR)/lexers/LexMPT \
    $(LEXILLA_DIR)/lexers/LexMSSQL \
    $(LEXILLA_DIR)/lexers/LexMagik \
    $(LEXILLA_DIR)/lexers/LexMake \
    $(LEXILLA_DIR)/lexers/LexMarkdown \
    $(LEXILLA_DIR)/lexers/LexMatlab \
    $(LEXILLA_DIR)/lexers/LexMaxima \
