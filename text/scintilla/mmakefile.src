    $(LEXILLA_DIR)/lexlib/PropSetSimple \
    $(LEXILLA_DIR)/lexlib/StyleContext \
    $(LEXILLA_DIR)/lexlib/WordList

# Lexilla main entry point
LEXILLA_SRC_FILES := \
    $(LEXILLA_DIR)/src/Lexilla

# Lexilla lexers (all available lexers)
