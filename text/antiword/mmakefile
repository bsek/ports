define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) "
	$(Q)$(IF) $(ports-text-antiword_CXXCMD) $(ports-text-antiword_CXXIQUOTE) $(dir $(2)) $(ports-text-antiword_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-antiword_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-antiword_CXXIQUOTE) . $(ports-text-antiword_CXXIQUOTE_END) $(strip $(ports-text-antiword_CXXFLAGS) $(ports-text-antiword_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ports-text-antiword_CXXCMD) $(ports-text-antiword_CXXIQUOTE) $(dir $(2)) $(ports-text-antiword_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-antiword_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-antiword_CXXIQUOTE) . $(ports-text-antiword_CXXIQUOTE_END) $(strip $(ports-text-antiword_CXXFLAGS) $(ports-text-antiword_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ports-text-antiword_CXXCMD) $(ports-text-antiword_CXXIQUOTE) $(dir $(2)) $(ports-text-antiword_CXXIQUOTE) $(TOP)/$(CURDIR) $(ports-text-antiword_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ports-text-antiword_CXXIQUOTE) . $(ports-text-antiword_CXXIQUOTE_END) $(strip $(ports-text-antiword_CXXFLAGS) $(ports-text-antiword_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2)))) ..."
	$(Q)AROS_CC="$(ports-text-antiword_CXXCMD)" $(MKDEPEND) $(strip $(ports-text-antiword_DXXFLAGS) $(ports-text-antiword_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ports-text-antiword_OBJDIR),)
  $(foreach ports-text-antiword_CXXFILE,$(ports-text-antiword_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ports-text-antiword_CXXFILE))),$(ports-text-antiword_CXXFILE))))
else
  $(foreach ports-text-antiword_CXXFILE,$(ports-text-antiword_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ports-text-antiword_OBJDIR)/,$(notdir $(basename $(ports-text-antiword_CXXFILE)))),$(ports-text-antiword_CXXFILE))))
