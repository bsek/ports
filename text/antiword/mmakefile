    ports-text-antiword-link_LIBS += startup.o
endif
ifeq (no,yes)
    ports-text-antiword-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ports-text-antiword-link_DEPLIBS := $(foreach lib,$(ports-text-antiword-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ports-text-antiword-link_DIRS)))) \
)

$(ports-text-antiword_TARGETDIR)/$(ports-text-antiword_PROGNAME) : OBJDIR := $(ports-text-antiword_OBJDIR)
$(ports-text-antiword_TARGETDIR)/$(ports-text-antiword_PROGNAME) : OBJS := $(strip $(ports-text-antiword_OBJS) $(ports-text-antiword_ARCHOBJS) $(USER_OBJS))
$(ports-text-antiword_TARGETDIR)/$(ports-text-antiword_PROGNAME) : LDFLAGS := $(strip $(ports-text-antiword_LDFLAGS))
$(ports-text-antiword_TARGETDIR)/$(ports-text-antiword_PROGNAME) : LIBS := $(strip $(addprefix -l,$(ports-text-antiword_LIBS) $(ports-text-antiword-link_EXTRA_LIBS)))
$(ports-text-antiword_TARGETDIR)/$(ports-text-antiword_PROGNAME) : ARCHLIBS := $(strip $(addprefix -l,) $(ports-text-antiword_ARCHLIBS))
$(ports-text-antiword_TARGETDIR)/$(ports-text-antiword_PROGNAME) : $(ports-text-antiword_OBJS) $(ports-text-antiword_ARCHOBJS) $(USER_OBJS) $(ports-text-antiword-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ports-text-antiword_LINK) $(strip $(ports-text-antiword_LD_OPTS) $(ports-text-antiword-link_LD_OPTS)) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS)) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ports-text-antiword_LINK) $(strip $(ports-text-antiword_LD_OPTS) $(ports-text-antiword-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ports-text-antiword_LINK) $(strip $(ports-text-antiword_LD_OPTS) $(ports-text-antiword-link_LD_OPTS)) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(strip $(LIBS) $(ARCHLIBS))" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-antiword_STRIP)" != ""; then \
		$(eval DBGTARGET=$(subst $(AROSDIR),$(DBGDIR),$(LINKTARGET))) \
		$(IF) $(TEST) "$(ports-text-antiword_STRIPDEBUG)" = "yes"; then \
			$(MKDIR) "$(dir $(DBGTARGET))" && \
			$(ports-text-antiword_STRIP) $(LINKTARGET) --only-keep-debug -o $(DBGTARGET).dbg ; \
		fi ; \
		$(ports-text-antiword_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(ports-text-antiword_STRIPDEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(DBGTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(DBGTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ports-text-antiword_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`$(ECHO) $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(ports-text-antiword_DEPS),)
  ifneq (ports-text-antiword ports-text-antiword-quick,)
    ifneq ($(findstring $(TARGET),ports-text-antiword ports-text-antiword-quick),)
      -include $(ports-text-antiword_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(ports-text-antiword_DEPS)
    endif
  endif
endif


